# App Version
APP_VERSION=1.0.0
BUILD_COMMIT=local

# Monitor Owner Credentials
MONITOR_OWNER_USERNAME=admin@vpsmonitor.local
MONITOR_OWNER_PASSWORD=admin_password_change_me

# Monitor API Settings
MONITOR_PORT=5080


# PostgreSQL Settings
POSTGRES_DB=vps_monitor
POSTGRES_USER=vps_monitor
POSTGRES_PASSWORD=vps_monitor_secret

# Grafana Settings
# CHANGE THIS IN PRODUCTION!
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin_secret_here

# SMTP Settings for Alerts
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=monitor@yourdomain.com
SMTP_TO=alerts@yourdomain.com
SMTP_USE_SSL=false

# NVIDIA AI NIM Settings (DeepSeek-R1)
AI_ENABLED=true
AI_BASE_URL=https://integrate.api.nvidia.com/v1
AI_MODEL=deepseek-ai/deepseek-r1
AI_API_KEY=nvapi-...

# Telegram Bot Assistant Settings
TELEGRAM_BOT_TOKEN=8836763984:AAGHRVrrq4ERTDngkYTR_bhvTXG8NJXpd44
TELEGRAM_CHAT_ID=


