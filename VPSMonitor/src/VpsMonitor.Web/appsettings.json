{
  "ConnectionStrings": {
    "Default": "Host=postgres;Port=5432;Database=vps_monitor;Username=vps_monitor;Password=vps_monitor"
  },
  "Monitor": {
    "PublicPort": 5080,
    "SessionMinutes": 60
  },
  "DockerProxy": {
    "BaseUrl": "http://docker-proxy:2375"
  },
  "Prometheus": {
    "BaseUrl": "http://prometheus:9090"
  },
  "Loki": {
    "BaseUrl": "http://loki:3100"
  },
  "Smtp": {
    "Enabled": false,
    "Host": "smtp.internal",
    "Port": 25,
    "UseSsl": false,
    "Username": "",
    "Password": "",
    "FromAddress": "no-reply@vpsmonitor.local",
    "FromName": "VPS Monitor"
  },
  "Ai": {
    "Enabled": true,
    "BaseUrl": "https://integrate.api.nvidia.com/v1",
    "ApiKey": "",
    "Model": "deepseek-ai/deepseek-r1"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
