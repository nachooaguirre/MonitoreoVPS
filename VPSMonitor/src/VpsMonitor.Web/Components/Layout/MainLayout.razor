@inherits LayoutComponentBase
@using VpsMonitor.Web.Data.Entities
@using VpsMonitor.Web.Security
@inject UserSessionState SessionState
@inject IMonitorStore Store
@inject IPasswordHasher PasswordHasher
@implements IDisposable

@if (!SessionState.IsAuthenticated)
{
    <div style="min-height: 100vh; display: flex; align-items: center; justify-content: center; background: #0b0f19; color: #f8fafc; font-family: system-ui, -apple-system, sans-serif;">
        <div style="width: 100%; max-width: 420px; padding: 2.5rem; background: rgba(15, 23, 42, 0.85); backdrop-filter: blur(16px); border: 1px solid rgba(255, 255, 255, 0.1); border-radius: 16px; box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5);">
            <div style="text-align: center; margin-bottom: 2rem;">
                <div style="width: 56px; height: 56px; margin: 0 auto 1rem; border-radius: 14px; background: linear-gradient(135deg, #6366f1, #a855f7); display: flex; align-items: center; justify-content: center; font-size: 1.75rem; font-weight: bold; color: #fff;">V</div>
                <h2 style="font-size: 1.5rem; font-weight: 700; margin-bottom: 0.5rem; color: #f8fafc;">VPS Monitor</h2>
                <p style="font-size: 0.875rem; color: #94a3b8;">Inicia sesión para acceder al panel de control</p>
            </div>

            @if (!string.IsNullOrEmpty(_loginError))
            {
                <div style="margin-bottom: 1.25rem; padding: 0.75rem 1rem; background: rgba(239, 68, 68, 0.15); border: 1px solid rgba(239, 68, 68, 0.4); border-radius: 8px; font-size: 0.85rem; color: #fca5a5; text-align: center;">
                    ⚠️ @_loginError
                </div>
            }

            <form @onsubmit="HandleLoginAsync" @onsubmit:preventDefault="true">
                <div style="margin-bottom: 1.25rem;">
                    <label style="display: block; font-size: 0.8rem; font-weight: 600; color: #cbd5e1; margin-bottom: 0.5rem;">Usuario / Email</label>
                    <input type="text" @bind="_usernameInput" placeholder="admin@example.com" required style="width: 100%; padding: 0.75rem 1rem; background: rgba(30, 41, 59, 0.7); border: 1px solid rgba(255, 255, 255, 0.1); border-radius: 8px; color: #fff; font-size: 0.9rem; outline: none;" />
                </div>

                <div style="margin-bottom: 1.75rem;">
                    <label style="display: block; font-size: 0.8rem; font-weight: 600; color: #cbd5e1; margin-bottom: 0.5rem;">Contraseña</label>
                    <input type="password" @bind="_passwordInput" placeholder="••••••••" required style="width: 100%; padding: 0.75rem 1rem; background: rgba(30, 41, 59, 0.7); border: 1px solid rgba(255, 255, 255, 0.1); border-radius: 8px; color: #fff; font-size: 0.9rem; outline: none;" />
                </div>

                <button type="submit" disabled="@_isAuthenticating" style="width: 100%; padding: 0.85rem; background: linear-gradient(135deg, #6366f1, #4f46e5); border: none; border-radius: 8px; color: #fff; font-weight: 600; font-size: 0.95rem; cursor: pointer; transition: all 0.2s;">
                    @if (_isAuthenticating)
                    {
                        <span>Verificando...</span>
                    }
                    else
                    {
                        <span>Iniciar Sesión</span>
                    }
                </button>
            </form>
        </div>
    </div>
}
else
{
    <div class="app-container">
        <aside class="sidebar">
            <div class="brand">
                <div class="brand-icon">V</div>
                <span>VPS Monitor</span>
            </div>

            <nav>
                <ul class="nav-menu">
                    <li>
                        <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                            <span>📊</span> Overview
                        </NavLink>
                    </li>
                    <li>
                        <NavLink class="nav-link" href="projects">
                            <span>🚀</span> Projects & Docker
                        </NavLink>
                    </li>
                    <li>
                        <NavLink class="nav-link" href="audit">
                            <span>🛡️</span> Security & Audit
                        </NavLink>
                    </li>
                </ul>
            </nav>

            <div style="margin-top: auto; padding-top: 1rem; border-top: 1px solid var(--border-color); display: flex; flex-direction: column; gap: 0.75rem;">
                <div style="display: flex; align-items: center; justify-content: space-between; font-size: 0.8rem; color: var(--text-muted);">
                    <div style="display: flex; align-items: center; gap: 0.5rem;">
                        <span style="width: 8px; height: 8px; border-radius: 50%; background: var(--status-healthy);"></span>
                        <span>@SessionState.Username</span>
                    </div>
                    <button @onclick="Logout" style="background: none; border: none; color: #ef4444; cursor: pointer; font-size: 0.75rem; font-weight: 600;">Salir</button>
                </div>
            </div>
        </aside>

        <main class="main-content">
            @Body
        </main>
    </div>
}

@code {
    private string _usernameInput = "";
    private string _passwordInput = "";
    private string? _loginError;
    private bool _isAuthenticating;

    protected override void OnInitialized()
    {
        SessionState.OnChange += StateHasChanged;
    }

    public void Dispose()
    {
        SessionState.OnChange -= StateHasChanged;
    }

    private async Task HandleLoginAsync()
    {
        _loginError = null;
        _isAuthenticating = true;

        try
        {
            var username = _usernameInput.Trim();
            var user = await Store.FindUserByUsernameAsync(username);
            if (user != null && PasswordHasher.Verify(_passwordInput, user.PasswordHash))
            {
                SessionState.Login(user.Username);
                _passwordInput = "";
            }
            else
            {
                _loginError = "Usuario o contraseña incorrectos.";
            }
        }
        catch
        {
            _loginError = "Error de autenticación.";
        }
        finally
        {
            _isAuthenticating = false;
        }
    }

    private void Logout()
    {
        SessionState.Logout();
    }
}
