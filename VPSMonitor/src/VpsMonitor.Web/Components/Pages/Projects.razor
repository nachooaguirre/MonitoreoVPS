@using Microsoft.EntityFrameworkCore
@using VpsMonitor.Web.Data
@using VpsMonitor.Web.Infrastructure.Docker
@using VpsMonitor.Web.Infrastructure.Ai
@inject IProjectGroupingService ProjectService
@inject IDockerReadOnlyClient DockerClient
@inject IAiDiagnosticsClient AiDiagnostics
@inject MonitorDbContext Db

<PageTitle>Projects & Workloads — VPS Monitor</PageTitle>

<div class="top-header">
    <div class="header-title">
        <h1>Projects & Workloads</h1>
        <p>Coolify & Compose grouped container workloads with instant live metrics</p>
    </div>
    @if (_projects != null)
    {
        <div style="font-size: 0.85rem; padding: 0.4rem 0.8rem; background: rgba(99, 102, 241, 0.15); border: 1px solid rgba(99, 102, 241, 0.3); border-radius: 8px; color: #a5b4fc;">
            📦 @_projects.Count Proyectos Activos
        </div>
    }
</div>

@if (_isLoading)
{
    <div style="padding: 3rem; text-align: center; color: var(--text-muted);">
        Cargando inventario de Docker...
    </div>
}
else if (_projects == null || !_projects.Any())
{
    <div class="card" style="text-align: center; padding: 3rem;">
        <p style="color: var(--text-muted);">No se detectaron proyectos de Docker activos en este VPS.</p>
    </div>
}
else
{
    <!-- Coolify 2-Column Grid Layout -->
    <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(360px, 1fr)); gap: 1.25rem;">
        @foreach (var proj in _projects)
        {
            <div class="card project-card" style="display: flex; flex-direction: column; justify-content: space-between; padding: 1.25rem; background: rgba(15, 23, 42, 0.7); border: 1px solid rgba(255, 255, 255, 0.08); border-radius: 12px; transition: all 0.2s;">
                <div>
                    <div style="display: flex; align-items: flex-start; justify-content: space-between; gap: 0.75rem; margin-bottom: 0.75rem;">
                        <div>
                            <h3 style="font-size: 1.1rem; font-weight: 700; color: #f8fafc; margin: 0; line-height: 1.3;">@proj.DisplayName</h3>
                            @if (!string.Equals(proj.DisplayName, proj.ProjectKey, StringComparison.OrdinalIgnoreCase))
                            {
                                <div style="font-size: 0.75rem; color: #64748b; margin-top: 0.2rem;">Key: <code>@proj.ProjectKey</code></div>
                            }
                        </div>
                        <span class="badge @GetBadgeClass(proj.OverallStatus)" style="font-size: 0.75rem;">
                            @proj.OverallStatus.ToUpper()
                        </span>
                    </div>

                    <div style="display: flex; flex-wrap: wrap; align-items: center; gap: 0.75rem; font-size: 0.8rem; color: var(--text-muted); margin-bottom: 1.25rem;">
                        <span>🐳 @proj.ContainerCount @(proj.ContainerCount == 1 ? "contenedor" : "contenedores")</span>
                        <span>•</span>
                        <span>Origen: @proj.AssignmentSource</span>
                        @if (_taskCountsMap.TryGetValue(proj.ProjectKey, out var taskCount) && taskCount > 0)
                        {
                            <span class="badge badge-degraded" style="font-size: 0.75rem; background: rgba(245, 158, 11, 0.2); color: #f59e0b; border: 1px solid rgba(245, 158, 11, 0.4);">
                                📋 @taskCount @(taskCount == 1 ? "tarea asignada" : "tareas asignadas")
                            </span>
                        }
                    </div>
                </div>

                <div style="display: flex; align-items: center; justify-content: space-between; gap: 0.5rem; border-top: 1px solid rgba(255,255,255,0.05); padding-top: 0.75rem;">
                    <button type="button" style="background: rgba(255,255,255,0.06); border: 1px solid rgba(255,255,255,0.12); border-radius: 6px; padding: 0.4rem 0.75rem; font-size: 0.8rem; color: #cbd5e1; cursor: pointer; transition: background 0.2s;" @onclick="() => OpenAliasModal(proj.ProjectKey, proj.DisplayName)">
                        ✏️ Renombrar
                    </button>
                    <button type="button" class="btn-primary" style="padding: 0.4rem 0.85rem; font-size: 0.8rem; width: auto;" @onclick="() => OpenProjectDetailAsync(proj)">
                        ⚡ Ver Métricas y Detalles
                    </button>
                </div>
            </div>
        }
    </div>
}

<!-- Project Detail Modal with Instant Auto-Loaded Metrics -->
@if (_selectedProject != null)
{
    <div style="position: fixed; inset: 0; background: rgba(0,0,0,0.8); backdrop-filter: blur(5px); display: flex; align-items: center; justify-content: center; z-index: 1000;" @onclick="CloseProjectDetail">
        <div class="card" style="width: 95%; max-width: 960px; max-height: 90vh; overflow-y: auto; background: #0f172a; border: 1px solid rgba(255,255,255,0.15); padding: 1.75rem; border-radius: 16px;" @onclick:stopPropagation="true">
            <div class="card-header" style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem;">
                <div>
                    <h2 style="font-size: 1.4rem; font-weight: 700; margin: 0; color: #fff; display: flex; align-items: center; gap: 0.5rem;">
                        <span>@_selectedProject.DisplayName</span>
                        <span class="badge @GetBadgeClass(_selectedProject.OverallStatus)" style="font-size: 0.75rem;">@_selectedProject.OverallStatus.ToUpper()</span>
                    </h2>
                    <span style="font-size: 0.8rem; color: var(--text-muted);">Key: <code>@_selectedProject.ProjectKey</code></span>
                </div>
                <div style="display: flex; align-items: center; gap: 0.5rem;">
                    <button type="button" class="btn-primary" style="padding: 0.4rem 0.75rem; font-size: 0.8rem;" @onclick="RefreshSelectedProjectStatsAsync" disabled="@_isLoadingProjectStats">
                        @if (_isLoadingProjectStats)
                        {
                            <span>⌛ Actualizando...</span>
                        }
                        else
                        {
                            <span>🔄 Actualizar Métricas</span>
                        }
                    </button>
                    <button type="button" style="background: none; border: none; color: #fff; cursor: pointer; font-size: 1.4rem; padding: 0 0.5rem;" @onclick="CloseProjectDetail">✕</button>
                </div>
            </div>

            <div style="margin-bottom: 1.25rem; display: flex; flex-wrap: wrap; gap: 1.5rem; font-size: 0.85rem; color: var(--text-muted); padding: 0.75rem 1rem; background: rgba(255,255,255,0.03); border-radius: 8px;">
                <div>Contenedores: <strong style="color: #f8fafc;">@_selectedProject.ContainerCount</strong></div>
                <div>Reinicios Totales: <strong style="color: #f8fafc;">@_selectedProject.TotalRestarts</strong></div>
                <div>Origen de proyecto: <strong style="color: #f8fafc;">@_selectedProject.AssignmentSource</strong></div>
            </div>

            <!-- Container Table with Live Metrics -->
            <table class="data-table" style="margin-bottom: 1.5rem;">
                <thead>
                    <tr>
                        <th>Contenedor / Imagen</th>
                        <th>Estado</th>
                        <th>CPU %</th>
                        <th>RAM Usada</th>
                        <th>Red RX / TX</th>
                        <th>Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var c in _selectedProject.Containers)
                    {
                        var stats = _containerStatsMap.TryGetValue(c.Id, out var s) ? s : null;
                        var isShowingLogs = _activeLogContainerId == c.Id;

                        <tr>
                            <td>
                                <div><strong style="color: #f8fafc; font-size: 0.95rem;">@c.Name</strong></div>
                                <div style="font-family: monospace; font-size: 0.75rem; color: var(--text-muted);">@c.Image</div>
                            </td>
                            <td>
                                <span class="badge @GetBadgeClass(c.State)">
                                    @c.State
                                </span>
                                <div style="font-size: 0.75rem; color: var(--text-muted); margin-top: 0.2rem;">@c.Status</div>
                            </td>
                            <td>
                                @if (_isLoadingProjectStats && stats == null)
                                {
                                    <span style="font-size: 0.8rem; color: var(--text-muted);">Cargando...</span>
                                }
                                else if (stats != null)
                                {
                                    <div style="font-weight: 700; color: #818cf8; font-size: 0.95rem;">@stats.CpuPercent %</div>
                                }
                                else
                                {
                                    <span style="font-size: 0.8rem; color: var(--text-muted);">N/A</span>
                                }
                            </td>
                            <td>
                                @if (_isLoadingProjectStats && stats == null)
                                {
                                    <span style="font-size: 0.8rem; color: var(--text-muted);">Cargando...</span>
                                }
                                else if (stats != null)
                                {
                                    <div style="font-weight: 700; color: #c084fc; font-size: 0.95rem;">@stats.MemoryUsageMb MB</div>
                                    <div style="font-size: 0.7rem; color: var(--text-muted);">Límite: @(stats.MemoryLimitMb > 0 ? $"{stats.MemoryLimitMb} MB" : "Sin límite")</div>
                                }
                                else
                                {
                                    <span style="font-size: 0.8rem; color: var(--text-muted);">N/A</span>
                                }
                            </td>
                            <td>
                                @if (stats != null)
                                {
                                    <div style="font-size: 0.8rem; color: #38bdf8;">↓ @FormatBytes(stats.NetworkRxBytes)</div>
                                    <div style="font-size: 0.8rem; color: #34d399;">↑ @FormatBytes(stats.NetworkTxBytes)</div>
                                }
                                else
                                {
                                    <span style="font-size: 0.8rem; color: var(--text-muted);">N/A</span>
                                }
                            </td>
                            <td>
                                <button type="button" style="background: rgba(255,255,255,0.08); border: 1px solid rgba(255,255,255,0.15); border-radius: 6px; padding: 0.35rem 0.65rem; font-size: 0.75rem; color: #e2e8f0; cursor: pointer;" @onclick="() => ToggleContainerLogsAsync(c.Id, c.Name)">
                                    📜 @(isShowingLogs ? "Ocultar Logs" : "Ver Logs")
                                </button>
                            </td>
                        </tr>

                        <!-- Expanded Live Container Logs Row -->
                        @if (isShowingLogs)
                        {
                            <tr>
                                <td colspan="6" style="background: #020617; padding: 1rem; border-left: 3px solid #6366f1;">
                                    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem;">
                                        <span style="font-size: 0.85rem; font-weight: 700; color: #a5b4fc;">
                                            📜 Últimos Logs de @_activeLogContainerName (Docker Terminal)
                                        </span>
                                        <button type="button" style="background: none; border: none; color: #94a3b8; cursor: pointer; font-size: 0.8rem;" @onclick="() => ToggleContainerLogsAsync(c.Id, c.Name)">✕ Cerrar Logs</button>
                                    </div>
                                    @if (_isLoadingLogs)
                                    {
                                        <div style="color: var(--text-muted); font-size: 0.85rem; padding: 1rem;">Cargando logs del contenedor...</div>
                                    }
                                    else
                                    {
                                        <pre style="margin: 0; padding: 0.75rem; background: #090d16; border-radius: 6px; color: #38bdf8; font-family: monospace; font-size: 0.78rem; max-height: 250px; overflow-y: auto; white-space: pre-wrap; word-break: break-all;">@_activeLogContent</pre>
                                    }
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
}

<!-- Rename Alias Modal -->
@if (_editingProjectKey != null)
{
    <div style="position: fixed; inset: 0; background: rgba(0,0,0,0.75); backdrop-filter: blur(4px); display: flex; align-items: center; justify-content: center; z-index: 1100;" @onclick="CloseAliasModal">
        <div class="card" style="width: 100%; max-width: 440px; background: #0f172a; border: 1px solid rgba(255,255,255,0.15); padding: 1.75rem; border-radius: 16px;" @onclick:stopPropagation="true">
            <div class="card-header" style="margin-bottom: 1rem;">
                <h3 style="font-size: 1.15rem; font-weight: 700; margin: 0; color: #fff;">Etiquetar / Renombrar Proyecto</h3>
                <button type="button" style="background: none; border: none; color: #fff; cursor: pointer; font-size: 1.2rem;" @onclick="CloseAliasModal">✕</button>
            </div>
            <div>
                <p style="font-size: 0.85rem; color: var(--text-muted); margin-bottom: 1rem;">
                    Asigna un nombre descriptivo al proyecto (Key: <code>@_editingProjectKey</code>):
                </p>
                <input type="text" @bind="_editingAliasInput" placeholder="Ej. SuperPOS Backend, Coolify Proxy" style="width: 100%; padding: 0.75rem; background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.15); border-radius: 8px; color: #fff; font-size: 0.9rem; margin-bottom: 1.25rem; outline: none;" />
                <div style="display: flex; justify-content: flex-end; gap: 0.75rem;">
                    <button type="button" style="padding: 0.5rem 1rem; background: rgba(255,255,255,0.1); border: none; border-radius: 6px; color: #fff; cursor: pointer;" @onclick="CloseAliasModal">Cancelar</button>
                    <button type="button" disabled="@_isSavingAlias" style="padding: 0.5rem 1.25rem; background: #6366f1; border: none; border-radius: 6px; color: #fff; font-weight: 600; cursor: pointer;" @onclick="SaveAliasAsync">
                        @if (_isSavingAlias)
                        {
                            <span>Guardando...</span>
                        }
                        else
                        {
                            <span>Guardar Nombre</span>
                        }
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<ProjectSummary>? _projects;
    private bool _isLoading = true;
    private Dictionary<string, int> _taskCountsMap = new(StringComparer.OrdinalIgnoreCase);

    private ProjectSummary? _selectedProject;
    private Dictionary<string, DockerContainerStats> _containerStatsMap = new();
    private bool _isLoadingProjectStats;

    private string? _activeLogContainerId;
    private string? _activeLogContainerName;
    private string? _activeLogContent;
    private bool _isLoadingLogs;

    private string? _editingProjectKey;
    private string _editingAliasInput = "";
    private bool _isSavingAlias;

    protected override async Task OnInitializedAsync()
    {
        await RefreshProjectsAsync();
    }

    private async Task RefreshProjectsAsync()
    {
        _isLoading = true;
        try
        {
            _projects = await ProjectService.GetProjectsAsync();
            if (_selectedProject != null && _projects != null)
            {
                _selectedProject = _projects.FirstOrDefault(p => p.ProjectKey == _selectedProject.ProjectKey);
            }

            var counts = await Db.ProjectTasks
                .Where(t => t.Status != "Completed")
                .GroupBy(t => t.ProjectKey)
                .Select(g => new { Key = g.Key, Count = g.Count() })
                .ToListAsync();

            _taskCountsMap = counts.ToDictionary(x => x.Key, x => x.Count, StringComparer.OrdinalIgnoreCase);
        }
        catch
        {
            _projects = new List<ProjectSummary>();
            _taskCountsMap = new Dictionary<string, int>(StringComparer.OrdinalIgnoreCase);
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task OpenProjectDetailAsync(ProjectSummary proj)
    {
        _selectedProject = proj;
        _activeLogContainerId = null;
        _activeLogContent = null;
        await RefreshSelectedProjectStatsAsync();
    }

    private void CloseProjectDetail()
    {
        _selectedProject = null;
        _containerStatsMap.Clear();
        _activeLogContainerId = null;
    }

    private async Task RefreshSelectedProjectStatsAsync()
    {
        if (_selectedProject == null) return;
        _isLoadingProjectStats = true;
        try
        {
            var tasks = _selectedProject.Containers.Select(async c =>
            {
                var stats = await DockerClient.GetContainerStatsAsync(c.Id);
                return (Id: c.Id, Stats: stats);
            });

            var results = await Task.WhenAll(tasks);
            foreach (var res in results)
            {
                if (res.Stats != null)
                {
                    _containerStatsMap[res.Id] = res.Stats;
                }
            }
        }
        catch
        {
            // Ignore proxy errors gracefully
        }
        finally
        {
            _isLoadingProjectStats = false;
        }
    }

    private async Task ToggleContainerLogsAsync(string containerId, string name)
    {
        if (_activeLogContainerId == containerId)
        {
            _activeLogContainerId = null;
            _activeLogContent = null;
            return;
        }

        _activeLogContainerId = containerId;
        _activeLogContainerName = name;
        _isLoadingLogs = true;
        _activeLogContent = null;

        try
        {
            _activeLogContent = await DockerClient.GetContainerLogsAsync(containerId, 100);
        }
        catch
        {
            _activeLogContent = "Error al recuperar logs del contenedor.";
        }
        finally
        {
            _isLoadingLogs = false;
        }
    }

    private void OpenAliasModal(string projectKey, string currentDisplayName)
    {
        _editingProjectKey = projectKey;
        _editingAliasInput = string.Equals(projectKey, currentDisplayName, StringComparison.OrdinalIgnoreCase) ? "" : currentDisplayName;
    }

    private void CloseAliasModal()
    {
        _editingProjectKey = null;
        _editingAliasInput = "";
        _isSavingAlias = false;
    }

    private async Task SaveAliasAsync()
    {
        if (string.IsNullOrWhiteSpace(_editingProjectKey)) return;

        _isSavingAlias = true;
        try
        {
            await ProjectService.SetProjectAliasAsync(_editingProjectKey, _editingAliasInput);
            CloseAliasModal();
            await RefreshProjectsAsync();
        }
        catch
        {
            // fallback
        }
        finally
        {
            _isSavingAlias = false;
        }
    }

    private static string GetBadgeClass(string status) => status.ToLower() switch
    {
        "healthy" or "running" => "badge-healthy",
        "degraded" or "exited" => "badge-degraded",
        "unhealthy" or "dead" => "badge-unhealthy",
        _ => "badge-healthy"
    };

    private static string FormatBytes(long bytes)
    {
        if (bytes < 1024) return $"{bytes} B";
        if (bytes < 1024 * 1024) return $"{bytes / 1024.0:F1} KB";
        return $"{bytes / 1024.0 / 1024.0:F1} MB";
    }
}
