@page "/projects"
@using VpsMonitor.Web.Infrastructure.Docker
@inject IProjectGroupingService ProjectService
@inject IDockerReadOnlyClient DockerClient

<PageTitle>Projects & Docker — VPS Monitor</PageTitle>

<div class="top-header">
    <div class="header-title">
        <h1>Projects & Docker Inventory</h1>
        <p>Coolify & Compose grouped container workloads</p>
    </div>
</div>

@if (_isLoading)
{
    <div style="padding: 2rem; text-align: center; color: var(--text-muted);">
        Cargando inventario de Docker...
    </div>
}
else if (_projects == null || !_projects.Any())
{
    <div class="card" style="text-align: center; padding: 3rem;">
        <p style="color: var(--text-muted);">No se detectaron proyectos de Docker activos.</p>
    </div>
}
else
{
    <div style="display: flex; flex-direction: column; gap: 1.5rem;">
        @foreach (var proj in _projects)
        {
            <div class="card">
                <div class="card-header" style="display: flex; align-items: center; justify-content: space-between; gap: 1rem; flex-wrap: wrap;">
                    <div>
                        <div style="display: flex; align-items: center; gap: 0.5rem;">
                            <h2 style="font-size: 1.25rem; font-weight: 700; margin: 0;">@proj.DisplayName</h2>
                            <button style="background: rgba(255,255,255,0.08); border: 1px solid rgba(255,255,255,0.15); border-radius: 6px; padding: 0.2rem 0.5rem; font-size: 0.75rem; color: var(--text-muted); cursor: pointer;" @onclick="() => OpenAliasModal(proj.ProjectKey, proj.DisplayName)">
                                ✏️ Renombrar
                            </button>
                        </div>
                        <div style="font-size: 0.8rem; color: var(--text-muted); margin-top: 0.25rem;">
                            <span>Key: <code style="background: rgba(255,255,255,0.05); padding: 0.1rem 0.3rem; border-radius: 4px;">@proj.ProjectKey</code></span>
                            <span style="margin: 0 0.5rem;">•</span>
                            <span>Origen: @proj.AssignmentSource</span>
                        </div>
                    </div>
                    <div style="display: flex; gap: 1rem; align-items: center;">
                        <span style="font-size: 0.85rem; color: var(--text-muted);">Reinicios totales: @proj.TotalRestarts</span>
                        <span class="badge @GetBadgeClass(proj.OverallStatus)">@proj.OverallStatus</span>
                    </div>
                </div>

                <table class="data-table">
                    <thead>
                        <tr>
                            <th>Contenedor</th>
                            <th>Imagen</th>
                            <th>Estado</th>
                            <th>Uptime / Status</th>
                            <th>Acción</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var c in proj.Containers)
                        {
                            <tr>
                                <td><strong>@c.Name</strong></td>
                                <td style="font-family: monospace; font-size: 0.85rem;">@c.Image</td>
                                <td>
                                    <span class="badge @GetBadgeClass(c.State)">
                                        @c.State
                                    </span>
                                </td>
                                <td style="font-size: 0.85rem; color: var(--text-muted);">@c.Status</td>
                                <td>
                                    <button class="btn-primary" style="padding: 0.35rem 0.75rem; font-size: 0.8rem; width: auto;" @onclick="() => LoadStatsAsync(c.Id, c.Name)">
                                        📊 Métricas
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
}

@if (_editingProjectKey != null)
{
    <div style="position: fixed; inset: 0; background: rgba(0,0,0,0.7); display: flex; align-items: center; justify-content: center; z-index: 1000;" @onclick="CloseAliasModal">
        <div class="card" style="width: 100%; max-width: 440px; background: #0f172a; border: 1px solid rgba(255,255,255,0.15);" @onclick:stopPropagation="true">
            <div class="card-header">
                <h3>Etiquetar / Renombrar Proyecto</h3>
                <button style="background: none; border: none; color: #fff; cursor: pointer; font-size: 1.2rem;" @onclick="CloseAliasModal">✕</button>
            </div>
            <div style="margin-top: 1rem;">
                <p style="font-size: 0.85rem; color: var(--text-muted); margin-bottom: 1rem;">
                    Asigna un nombre descriptivo al proyecto (Key: <code>@_editingProjectKey</code>):
                </p>
                <input type="text" @bind="_editingAliasInput" placeholder="Ej. SuperPOS Backend, Coolify Proxy" style="width: 100%; padding: 0.75rem; background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.15); border-radius: 8px; color: #fff; font-size: 0.9rem; margin-bottom: 1.25rem;" />
                <div style="display: flex; justify-content: flex-end; gap: 0.75rem;">
                    <button style="padding: 0.5rem 1rem; background: rgba(255,255,255,0.1); border: none; border-radius: 6px; color: #fff; cursor: pointer;" @onclick="CloseAliasModal">Cancelar</button>
                    <button style="padding: 0.5rem 1rem; background: #6366f1; border: none; border-radius: 6px; color: #fff; font-weight: 600; cursor: pointer;" @onclick="SaveAliasAsync">Guardar Nombre</button>
                </div>
            </div>
        </div>
    </div>
}

@if (_isLoadingStats || _selectedContainerStats != null || _statsError != null)
{
    <div style="position: fixed; inset: 0; background: rgba(0,0,0,0.7); display: flex; align-items: center; justify-content: center; z-index: 1000;" @onclick="CloseStats">
        <div class="card" style="width: 100%; max-width: 480px; background: #0f172a; border: 1px solid rgba(255,255,255,0.15);" @onclick:stopPropagation="true">
            <div class="card-header">
                <h3>Métricas de @_selectedContainerName</h3>
                <button style="background: none; border: none; color: #fff; cursor: pointer; font-size: 1.2rem;" @onclick="CloseStats">✕</button>
            </div>

            @if (_isLoadingStats)
            {
                <div style="padding: 2.5rem; text-align: center; color: var(--text-muted);">
                    Obteniendo métricas en tiempo real de Docker...
                </div>
            }
            else if (_statsError != null)
            {
                <div style="padding: 1.5rem; text-align: center; color: #fca5a5;">
                    ⚠️ @_statsError
                </div>
            }
            else if (_selectedContainerStats != null)
            {
                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin-top: 1rem;">
                    <div style="padding: 1rem; background: rgba(255,255,255,0.05); border-radius: 8px;">
                        <div style="font-size: 0.8rem; color: var(--text-muted);">CPU %</div>
                        <div style="font-size: 1.5rem; font-weight: bold; color: #6366f1;">@_selectedContainerStats.CpuPercent %</div>
                    </div>
                    <div style="padding: 1rem; background: rgba(255,255,255,0.05); border-radius: 8px;">
                        <div style="font-size: 0.8rem; color: var(--text-muted);">RAM Usada</div>
                        <div style="font-size: 1.5rem; font-weight: bold; color: #a855f7;">@_selectedContainerStats.MemoryUsageMb MB</div>
                    </div>
                    <div style="padding: 1rem; background: rgba(255,255,255,0.05); border-radius: 8px;">
                        <div style="font-size: 0.8rem; color: var(--text-muted);">Network RX</div>
                        <div style="font-size: 1.1rem; font-weight: bold;">@FormatBytes(_selectedContainerStats.NetworkRxBytes)</div>
                    </div>
                    <div style="padding: 1rem; background: rgba(255,255,255,0.05); border-radius: 8px;">
                        <div style="font-size: 0.8rem; color: var(--text-muted);">Network TX</div>
                        <div style="font-size: 1.1rem; font-weight: bold;">@FormatBytes(_selectedContainerStats.NetworkTxBytes)</div>
                    </div>
                </div>
            }
        </div>
    </div>
}

@code {
    private List<ProjectSummary>? _projects;
    private bool _isLoading = true;

    private DockerContainerStats? _selectedContainerStats;
    private string? _selectedContainerName;
    private bool _isLoadingStats;
    private string? _statsError;

    private string? _editingProjectKey;
    private string _editingAliasInput = "";

    protected override async Task OnInitializedAsync()
    {
        await RefreshProjectsAsync();
    }

    private async Task RefreshProjectsAsync()
    {
        _isLoading = true;
        try
        {
            _projects = await ProjectService.GetProjectsAsync();
        }
        catch
        {
            _projects = new List<ProjectSummary>();
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task LoadStatsAsync(string containerId, string name)
    {
        _selectedContainerName = name;
        _isLoadingStats = true;
        _selectedContainerStats = null;
        _statsError = null;

        try
        {
            _selectedContainerStats = await DockerClient.GetContainerStatsAsync(containerId);
            if (_selectedContainerStats == null)
            {
                _statsError = "No se pudieron obtener las métricas del contenedor.";
            }
        }
        catch
        {
            _statsError = "Error de comunicación con el socket proxy de Docker.";
        }
        finally
        {
            _isLoadingStats = false;
        }
    }

    private void CloseStats()
    {
        _selectedContainerStats = null;
        _selectedContainerName = null;
        _isLoadingStats = false;
        _statsError = null;
    }

    private void OpenAliasModal(string projectKey, string currentDisplayName)
    {
        _editingProjectKey = projectKey;
        _editingAliasInput = string.Equals(projectKey, currentDisplayName, StringComparison.OrdinalIgnoreCase) ? "" : currentDisplayName;
    }

    private void CloseAliasModal()
    {
        _editingProjectKey = null;
        _editingAliasInput = "";
    }

    private async Task SaveAliasAsync()
    {
        if (string.IsNullOrWhiteSpace(_editingProjectKey)) return;

        try
        {
            await ProjectService.SetProjectAliasAsync(_editingProjectKey, _editingAliasInput);
            CloseAliasModal();
            await RefreshProjectsAsync();
        }
        catch
        {
            // fallback
        }
    }

    private static string GetBadgeClass(string status) => status.ToLower() switch
    {
        "healthy" or "running" => "badge-healthy",
        "degraded" or "exited" => "badge-degraded",
        "unhealthy" or "dead" => "badge-unhealthy",
        _ => "badge-healthy"
    };

    private static string FormatBytes(long bytes)
    {
        if (bytes < 1024) return $"{bytes} B";
        if (bytes < 1024 * 1024) return $"{bytes / 1024.0:F1} KB";
        return $"{bytes / 1024.0 / 1024.0:F1} MB";
    }
}
