@page "/tasks"
@using Microsoft.EntityFrameworkCore
@using System.Text.Json
@using VpsMonitor.Web.Data
@using VpsMonitor.Web.Data.Entities
@using VpsMonitor.Web.Infrastructure.Ai
@using VpsMonitor.Web.Infrastructure.Docker
@inject MonitorDbContext Db
@inject IAiProjectPlannerService AiPlanner
@inject IProjectGroupingService ProjectService

<PageTitle>Tareas y Planificación — VPS Monitor</PageTitle>

<div class="top-header">
    <div class="header-title">
        <h1>📋 Tareas y Planificación de Proyectos</h1>
        <p>Generación de planes de trabajo y asignación inteligente con NVIDIA DeepSeek-R1</p>
    </div>
</div>

<!-- Raw Proposal Input Card with Manual Controls -->
<div class="card" style="margin-bottom: 1.5rem; background: rgba(15, 23, 42, 0.85); border: 1px solid rgba(99, 102, 241, 0.3); padding: 1.5rem; border-radius: 12px;">
    <h3 style="font-size: 1.1rem; font-weight: 700; margin-bottom: 0.75rem; color: #fff;">💡 Crear Tarea o Procesar Propuesta de Cliente con IA</h3>
    <p style="font-size: 0.85rem; color: var(--text-muted); margin-bottom: 1rem;">
        Pega notas de reuniones, transcripciones o mensajes de clientes. La IA identificará el proyecto y contenedor de tu infraestructura, o puedes seleccionarlo manualmente.
    </p>

    <!-- Manual Selectors Row -->
    <div style="display: flex; flex-wrap: wrap; gap: 1rem; margin-bottom: 1rem;">
        <div style="flex: 1; min-width: 220px;">
            <label style="display: block; font-size: 0.75rem; color: #94a3b8; margin-bottom: 0.25rem;">Proyecto Destino (Opcional - La IA auto-detecta):</label>
            <select value="@_overrideProjectKey" @onchange="OnProjectKeyChanged" style="width: 100%; padding: 0.5rem 0.75rem; background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.15); border-radius: 8px; color: #fff; font-size: 0.85rem; outline: none;">
                <option value="">🤖 Auto-detectar por IA</option>
                @if (_availableProjects != null)
                {
                    @foreach (var p in _availableProjects)
                    {
                        <option value="@p.ProjectKey">📦 @p.DisplayName (@p.ProjectKey)</option>
                    }
                }
            </select>
        </div>

        <div style="flex: 1; min-width: 220px;">
            <label style="display: block; font-size: 0.75rem; color: #94a3b8; margin-bottom: 0.25rem;">Contenedor Destino (Opcional):</label>
            <select @bind="_overrideContainerName" style="width: 100%; padding: 0.5rem 0.75rem; background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.15); border-radius: 8px; color: #fff; font-size: 0.85rem; outline: none;">
                <option value="">🐳 Todos los contenedores / Auto-detectar</option>
                @foreach (var c in AvailableContainersForSelection)
                {
                    <option value="@c.Name">🐳 @c.Name (@c.Image)</option>
                }
            </select>
        </div>
    </div>

    <textarea @bind="_rawInput" placeholder="Ej. El cliente de SuperPOS me pidió agregar factura electrónica AFIP en el contenedor api..." rows="3" style="width: 100%; padding: 0.75rem; background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.15); border-radius: 8px; color: #fff; font-size: 0.9rem; margin-bottom: 1rem; outline: none; resize: vertical;"></textarea>
    
    <div style="display: flex; justify-content: flex-end;">
        <button type="button" class="btn-primary" style="padding: 0.55rem 1.25rem; font-size: 0.85rem;" @onclick="CreatePlannedTaskAsync" disabled="@(_isPlanning || string.IsNullOrWhiteSpace(_rawInput))">
            @if (_isPlanning)
            {
                <span>🧠 Analizando con DeepSeek-R1...</span>
            }
            else
            {
                <span>🤖 Planificar y Asignar Tarea</span>
            }
        </button>
    </div>
</div>

<!-- Filters Bar -->
<div style="display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 1rem; margin-bottom: 1.25rem;">
    <div style="display: flex; gap: 0.5rem;">
        <button type="button" class="btn-primary" style="background: @(_selectedStatusFilter == "All" ? "#6366f1" : "rgba(255,255,255,0.08)"); border: none; padding: 0.4rem 0.85rem; font-size: 0.8rem;" @onclick='() => _selectedStatusFilter = "All"'>Todas (@_tasks.Count)</button>
        <button type="button" class="btn-primary" style="background: @(_selectedStatusFilter == "Pending" ? "#6366f1" : "rgba(255,255,255,0.08)"); border: none; padding: 0.4rem 0.85rem; font-size: 0.8rem;" @onclick='() => _selectedStatusFilter = "Pending"'>Pendientes (@_tasks.Count(t => t.Status == "Pending"))</button>
        <button type="button" class="btn-primary" style="background: @(_selectedStatusFilter == "InProgress" ? "#6366f1" : "rgba(255,255,255,0.08)"); border: none; padding: 0.4rem 0.85rem; font-size: 0.8rem;" @onclick='() => _selectedStatusFilter = "InProgress"'>En Progreso (@_tasks.Count(t => t.Status == "InProgress"))</button>
        <button type="button" class="btn-primary" style="background: @(_selectedStatusFilter == "Completed" ? "#6366f1" : "rgba(255,255,255,0.08)"); border: none; padding: 0.4rem 0.85rem; font-size: 0.8rem;" @onclick='() => _selectedStatusFilter = "Completed"'>Completadas (@_tasks.Count(t => t.Status == "Completed"))</button>
    </div>
</div>

<!-- Task Cards Grid -->
@if (_isLoading)
{
    <div style="padding: 3rem; text-align: center; color: var(--text-muted);">
        Cargando tareas registradas...
    </div>
}
else if (!FilteredTasks.Any())
{
    <div class="card" style="text-align: center; padding: 3rem;">
        <p style="color: var(--text-muted);">No hay tareas registradas en este filtro.</p>
    </div>
}
else
{
    <div style="display: flex; flex-direction: column; gap: 1rem;">
        @foreach (var task in FilteredTasks)
        {
            var steps = ParseSteps(task.ActionPlanJson);

            <div class="card" style="background: rgba(15, 23, 42, 0.7); border: 1px solid rgba(255, 255, 255, 0.08); border-radius: 12px; padding: 1.25rem;">
                <div style="display: flex; align-items: flex-start; justify-content: space-between; gap: 1rem; margin-bottom: 0.75rem;">
                    <div>
                        <div style="display: flex; flex-wrap: wrap; align-items: center; gap: 0.5rem; margin-bottom: 0.35rem;">
                            <span class="badge badge-healthy" style="font-size: 0.75rem; background: rgba(99, 102, 241, 0.2); color: #a5b4fc; border: 1px solid rgba(99, 102, 241, 0.4);">
                                📦 Proyecto: @task.ProjectKey
                            </span>
                            @if (!string.IsNullOrWhiteSpace(task.ContainerName))
                            {
                                <span class="badge badge-healthy" style="font-size: 0.75rem; background: rgba(56, 189, 248, 0.2); color: #38bdf8; border: 1px solid rgba(56, 189, 248, 0.4);">
                                    🐳 Contenedor: @task.ContainerName
                                </span>
                            }
                            <span class="badge @GetPriorityBadge(task.Priority)" style="font-size: 0.7rem;">
                                @task.Priority
                            </span>
                        </div>
                        <h3 style="font-size: 1.15rem; font-weight: 700; color: #fff; margin: 0;">@task.Title</h3>
                    </div>

                    <div style="display: flex; align-items: center; gap: 0.5rem;">
                        <select @onchange="(e) => UpdateTaskStatusAsync(task, e.Value?.ToString())" value="@task.Status" style="padding: 0.35rem 0.65rem; background: rgba(255,255,255,0.08); border: 1px solid rgba(255,255,255,0.15); border-radius: 6px; color: #fff; font-size: 0.8rem; outline: none;">
                            <option value="Pending">🟡 Pendiente</option>
                            <option value="InProgress">🔵 En Progreso</option>
                            <option value="Completed">🟢 Completada</option>
                        </select>
                        <button type="button" style="background: none; border: none; color: #ef4444; cursor: pointer; font-size: 1rem; padding: 0.2rem 0.5rem;" @onclick="() => DeleteTaskAsync(task)">🗑️</button>
                    </div>
                </div>

                <p style="font-size: 0.9rem; color: #cbd5e1; margin-bottom: 1rem; line-height: 1.5;">@task.Description</p>

                <!-- Action Plan Checklist -->
                @if (steps.Any())
                {
                    <div style="padding: 0.75rem 1rem; background: rgba(0,0,0,0.25); border-radius: 8px; margin-bottom: 0.75rem;">
                        <div style="font-size: 0.8rem; font-weight: 700; color: #94a3b8; margin-bottom: 0.5rem;">HOJA DE RUTA / PASOS DE EJECUCIÓN:</div>
                        <div style="display: flex; flex-direction: column; gap: 0.4rem;">
                            @foreach (var s in steps)
                            {
                                <div style="display: flex; align-items: flex-start; gap: 0.5rem; font-size: 0.85rem; color: #e2e8f0;">
                                    <span style="color: #6366f1;">▸</span>
                                    <span>@s</span>
                                </div>
                            }
                        </div>
                    </div>
                }

                <div style="font-size: 0.75rem; color: var(--text-muted); display: flex; justify-content: space-between;">
                    <span>Creado: @task.CreatedAtUtc.ToLocalTime().ToString("g")</span>
                    @if (task.CompletedAtUtc.HasValue)
                    {
                        <span>Completado: @task.CompletedAtUtc.Value.ToLocalTime().ToString("g")</span>
                    }
                </div>
            </div>
        }
    </div>
}

@code {
    private List<ProjectTask> _tasks = new();
    private List<ProjectSummary>? _availableProjects;
    private bool _isLoading = true;

    private string _rawInput = "";
    private string _overrideProjectKey = "";
    private string _overrideContainerName = "";
    private bool _isPlanning;
    private string _selectedStatusFilter = "All";

    private IEnumerable<DockerContainerInfo> AvailableContainersForSelection
    {
        get
        {
            if (_availableProjects == null) return Enumerable.Empty<DockerContainerInfo>();
            if (string.IsNullOrWhiteSpace(_overrideProjectKey))
            {
                return _availableProjects.SelectMany(p => p.Containers);
            }
            var proj = _availableProjects.FirstOrDefault(p => p.ProjectKey == _overrideProjectKey);
            return proj?.Containers ?? Enumerable.Empty<DockerContainerInfo>();
        }
    }

    private void OnProjectKeyChanged(ChangeEventArgs e)
    {
        _overrideProjectKey = e.Value?.ToString() ?? "";
        _overrideContainerName = "";
    }

    private IEnumerable<ProjectTask> FilteredTasks => _selectedStatusFilter switch
    {
        "Pending" => _tasks.Where(t => t.Status == "Pending"),
        "InProgress" => _tasks.Where(t => t.Status == "InProgress"),
        "Completed" => _tasks.Where(t => t.Status == "Completed"),
        _ => _tasks
    };

    protected override async Task OnInitializedAsync()
    {
        await LoadTasksAsync();
        try
        {
            _availableProjects = await ProjectService.GetProjectsAsync();
        }
        catch
        {
            _availableProjects = new List<ProjectSummary>();
        }
    }

    private async Task LoadTasksAsync()
    {
        _isLoading = true;
        try
        {
            _tasks = await Db.ProjectTasks.OrderByDescending(t => t.CreatedAtUtc).ToListAsync();
        }
        catch
        {
            _tasks = new List<ProjectTask>();
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task CreatePlannedTaskAsync()
    {
        if (string.IsNullOrWhiteSpace(_rawInput)) return;
        _isPlanning = true;

        try
        {
            var projects = _availableProjects ?? await ProjectService.GetProjectsAsync();
            var planned = await AiPlanner.PlanTaskFromProposalAsync(_rawInput, projects);

            var finalProjectKey = !string.IsNullOrWhiteSpace(_overrideProjectKey) ? _overrideProjectKey : planned.ProjectKey;
            var finalContainerName = !string.IsNullOrWhiteSpace(_overrideContainerName) ? _overrideContainerName : planned.ContainerName;

            var newTask = new ProjectTask
            {
                Id = Guid.NewGuid(),
                ProjectKey = finalProjectKey,
                ContainerName = finalContainerName,
                Title = planned.Title,
                Description = planned.Description,
                Priority = planned.Priority,
                Status = "Pending",
                RawInput = _rawInput,
                ActionPlanJson = JsonSerializer.Serialize(planned.ActionPlanSteps),
                CreatedAtUtc = DateTime.UtcNow
            };

            Db.ProjectTasks.Add(newTask);
            await Db.SaveChangesAsync();

            _rawInput = "";
            _overrideProjectKey = "";
            _overrideContainerName = "";
            await LoadTasksAsync();
        }
        catch
        {
            // Fallback
        }
        finally
        {
            _isPlanning = false;
        }
    }

    private async Task UpdateTaskStatusAsync(ProjectTask task, string? newStatus)
    {
        if (string.IsNullOrWhiteSpace(newStatus)) return;
        task.Status = newStatus;
        if (newStatus == "Completed")
        {
            task.CompletedAtUtc = DateTime.UtcNow;
        }
        await Db.SaveChangesAsync();
    }

    private async Task DeleteTaskAsync(ProjectTask task)
    {
        Db.ProjectTasks.Remove(task);
        await Db.SaveChangesAsync();
        await LoadTasksAsync();
    }

    private static List<string> ParseSteps(string json)
    {
        try
        {
            return JsonSerializer.Deserialize<List<string>>(json) ?? new List<string>();
        }
        catch
        {
            return new List<string>();
        }
    }

    private static string GetPriorityBadge(string priority) => priority.ToLower() switch
    {
        "urgent" => "badge-unhealthy",
        "high" => "badge-degraded",
        _ => "badge-healthy"
    };
}
}
