@page "/"
@using VpsMonitor.Web.Infrastructure.Health
@using VpsMonitor.Web.Infrastructure.Prometheus
@using VpsMonitor.Web.Infrastructure.Ai
@implements IDisposable
@inject IHealthCheckRunner HealthRunner
@inject IPrometheusQueryClient PrometheusClient
@inject IAiDiagnosticsClient AiDiagnostics

<PageTitle>Overview — VPS Monitor</PageTitle>

<div class="top-header">
    <div class="header-title">
        <h1>VPS System Overview</h1>
        <p>Real-time infrastructure health, network throughput & Prometheus host metrics</p>
    </div>
    <div style="display: flex; align-items: center; gap: 0.75rem;">
        <button type="button" class="btn-primary" style="padding: 0.45rem 0.9rem; font-size: 0.85rem;" @onclick="RunAiDiagnosticAsync" disabled="@_isAnalyzingAi">
            @if (_isAnalyzingAi)
            {
                <span>🧠 Analizando con NVIDIA AI...</span>
            }
            else
            {
                <span>🤖 Diagnóstico IA (DeepSeek-R1)</span>
            }
        </button>
        @if (_healthSummary != null)
        {
            <span class="badge @GetBadgeClass(_healthSummary.Status)" style="font-size: 0.85rem; padding: 0.4rem 0.8rem;">
                ● @_healthSummary.Status.ToUpper()
            </span>
        }
    </div>
</div>

@if (_isLoading)
{
    <div style="padding: 3rem; text-align: center; color: var(--text-muted);">
        Cargando métricas del sistema...
    </div>
}
else
{
    <!-- Metric Gauges (5 Column Grid) -->
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 1rem; margin-bottom: 1.5rem;">
        <div class="card">
            <div class="card-header">
                <span class="card-title">CPU Usage</span>
                <span>💻</span>
            </div>
            <div class="metric-value">
                @(_vpsMetrics?.CpuPercent.ToString("F1") ?? "0.0")<span class="metric-unit">%</span>
            </div>
        </div>

        <div class="card">
            <div class="card-header">
                <span class="card-title">Memory Usage</span>
                <span>🧠</span>
            </div>
            <div class="metric-value">
                @(_vpsMetrics?.MemoryPercent.ToString("F1") ?? "0.0")<span class="metric-unit">%</span>
            </div>
        </div>

        <div class="card">
            <div class="card-header">
                <span class="card-title">Disk Space Used</span>
                <span>💾</span>
            </div>
            <div class="metric-value">
                @(_vpsMetrics?.DiskPercent.ToString("F1") ?? "0.0")<span class="metric-unit">%</span>
            </div>
        </div>

        <div class="card">
            <div class="card-header">
                <span class="card-title">Network Speed</span>
                <span>⚡</span>
            </div>
            <div class="metric-value" style="font-size: 1.4rem;">
                @FormatNetworkSpeed(_vpsMetrics?.NetworkBps ?? 0)
            </div>
        </div>

        <div class="card">
            <div class="card-header">
                <span class="card-title">Active Alerts</span>
                <span>🔔</span>
            </div>
            <div class="metric-value">
                @(_healthSummary?.ActiveAlerts.Count ?? 0)
            </div>
        </div>
    </div>

    <!-- AI Diagnostic Results Card (if generated) -->
    @if (!string.IsNullOrEmpty(_aiReport))
    {
        <div class="card" style="margin-bottom: 1.5rem; border: 1px solid rgba(99, 102, 241, 0.3); background: rgba(15, 23, 42, 0.85);">
            <div class="card-header" style="margin-bottom: 0.75rem;">
                <div style="display: flex; align-items: center; gap: 0.5rem; font-weight: 700; color: #a5b4fc; font-size: 1.05rem;">
                    <span>🧠 Diagnóstico de SRE / IA (NVIDIA DeepSeek-R1)</span>
                </div>
                <button type="button" style="background: none; border: none; color: #94a3b8; cursor: pointer;" @onclick="() => _aiReport = null">✕</button>
            </div>
            <div style="white-space: pre-wrap; font-size: 0.9rem; line-height: 1.6; color: #e2e8f0; background: rgba(0,0,0,0.25); padding: 1.25rem; border-radius: 8px; font-family: sans-serif;">
                @_aiReport
            </div>
        </div>
    }

    <!-- Details Grid -->
    <div class="grid-2">
        <div class="card">
            <h3 style="margin-bottom: 1rem; font-size: 1.1rem; color: #f8fafc;">Projects Health Summary</h3>
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Proyecto</th>
                        <th>Contenedores</th>
                        <th>Estado</th>
                    </tr>
                </thead>
                <tbody>
                    @if (_healthSummary != null && _healthSummary.Projects.Any())
                    {
                        @foreach (var proj in _healthSummary.Projects)
                        {
                            <tr>
                                <td>
                                    <div><strong>@proj.DisplayName</strong></div>
                                    @if (!string.Equals(proj.DisplayName, proj.ProjectKey, StringComparison.OrdinalIgnoreCase))
                                    {
                                        <div style="font-size: 0.75rem; color: var(--text-muted);">Key: @proj.ProjectKey</div>
                                    }
                                </td>
                                <td>@proj.TotalContainers</td>
                                <td>
                                    <span class="badge @GetBadgeClass(proj.Status)">
                                        @proj.Status.ToUpper()
                                    </span>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="3" style="color: var(--text-muted);">Sin datos de proyectos registrados</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="card">
            <h3 style="margin-bottom: 1rem; font-size: 1.1rem; color: #f8fafc;">Active Prometheus Alerts</h3>
            @if (_healthSummary != null && _healthSummary.ActiveAlerts.Any())
            {
                <div style="display: flex; flex-direction: column; gap: 0.75rem;">
                    @foreach (var alert in _healthSummary.ActiveAlerts)
                    {
                        <div style="padding: 0.75rem; background: rgba(239, 68, 68, 0.1); border: 1px solid rgba(239, 68, 68, 0.3); border-radius: 8px;">
                            <div style="display: flex; justify-content: space-between; margin-bottom: 0.25rem;">
                                <strong style="color: #fca5a5;">@alert.AlertName</strong>
                                <span class="badge badge-unhealthy">@alert.Severity</span>
                            </div>
                            <p style="font-size: 0.85rem; color: var(--text-muted); margin: 0;">@alert.Summary</p>
                        </div>
                    }
                </div>
            }
            else
            {
                <div style="padding: 1.5rem; text-align: center; color: var(--status-healthy); background: rgba(16, 185, 129, 0.05); border: 1px solid rgba(16, 185, 129, 0.15); border-radius: 8px;">
                    ✅ No hay alertas activas en el sistema. Todos los sensores operan normalmente.
                </div>
            }
        </div>
    </div>
}

@code {
    private VpsMetrics? _vpsMetrics;
    private HealthSummaryReport? _healthSummary;
    private bool _isLoading = true;
    private string? _aiReport;
    private bool _isAnalyzingAi;
    private System.Threading.Timer? _timer;

    protected override async Task OnInitializedAsync()
    {
        await LoadMetricsAsync();
        _timer = new System.Threading.Timer(async _ =>
        {
            await InvokeAsync(async () =>
            {
                await LoadMetricsAsync();
                StateHasChanged();
            });
        }, null, 10000, 10000);
    }

    private async Task LoadMetricsAsync()
    {
        try
        {
            _vpsMetrics = await PrometheusClient.GetVpsMetricsAsync();
            _healthSummary = await HealthRunner.GetHealthSummaryAsync();
        }
        catch
        {
            // Graceful fallback
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task RunAiDiagnosticAsync()
    {
        if (_healthSummary == null) return;
        _isAnalyzingAi = true;
        try
        {
            _aiReport = await AiDiagnostics.DiagnosticReportAsync(_healthSummary);
        }
        catch (Exception ex)
        {
            _aiReport = $"⚠️ Error al conectar con el servidor de IA: {ex.Message}";
        }
        finally
        {
            _isAnalyzingAi = false;
        }
    }

    private static string FormatNetworkSpeed(double bytesPerSec)
    {
        if (bytesPerSec < 1024) return $"{bytesPerSec:F0} B/s";
        if (bytesPerSec < 1024 * 1024) return $"{bytesPerSec / 1024.0:F1} KB/s";
        return $"{bytesPerSec / 1024.0 / 1024.0:F1} MB/s";
    }

    private static string GetBadgeClass(string status) => status.ToLower() switch
    {
        "healthy" => "badge-healthy",
        "degraded" => "badge-degraded",
        "unhealthy" => "badge-unhealthy",
        _ => "badge-healthy"
    };

    public void Dispose()
    {
        _timer?.Dispose();
    }
}
