<Page x:Class="SuperPOS.Client.Views.Auditoria.AuditoriaPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="Auditoría">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="🛡️  Auditoría del sistema" FontSize="24" FontWeight="Bold" Margin="0,0,0,4"/>
        <TextBlock Grid.Row="0" Text="Quién hizo qué, cuándo y en qué registro — generado automáticamente en cada cambio."
                   Opacity="0.6" Margin="0,32,0,0" FontSize="12"/>

        <!-- Filtros -->
        <Grid Grid.Row="1" Margin="0,16,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="160"/>
                <ColumnDefinition Width="140"/>
                <ColumnDefinition Width="140"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <ComboBox x:Name="CmbEntidad" Grid.Column="0" Margin="0,0,8,0" VerticalContentAlignment="Center"/>
            <DatePicker x:Name="DpDesde" Grid.Column="1" Margin="0,0,8,0"/>
            <DatePicker x:Name="DpHasta" Grid.Column="2" Margin="0,0,8,0"/>
            <ui:TextBox x:Name="TxtBuscar" Grid.Column="3" Margin="0,0,8,0" PlaceholderText="Buscar por usuario, ID o descripción..."
                        KeyDown="TxtBuscar_KeyDown"/>
            <ui:Button Grid.Column="4" Content="Buscar" Appearance="Primary" Click="BtnBuscar_Click"/>
        </Grid>

        <!-- Grilla -->
        <DataGrid x:Name="DgAuditoria" Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="True"
                  SelectionMode="Single" GridLinesVisibility="Horizontal" RowHeight="30" FontSize="12.5"
                  MouseDoubleClick="DgAuditoria_MouseDoubleClick">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Fecha" Binding="{Binding Fecha, StringFormat=dd/MM/yyyy HH:mm:ss}" Width="150"/>
                <DataGridTextColumn Header="Usuario" Binding="{Binding NombreUsuario}" Width="120"/>
                <DataGridTextColumn Header="Entidad" Binding="{Binding Entidad}" Width="160"/>
                <DataGridTextColumn Header="ID" Binding="{Binding EntidadId}" Width="70"/>
                <DataGridTextColumn Header="Acción" Binding="{Binding Accion}" Width="100"/>
                <DataGridTextColumn Header="Descripción" Binding="{Binding Descripcion}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Page>
