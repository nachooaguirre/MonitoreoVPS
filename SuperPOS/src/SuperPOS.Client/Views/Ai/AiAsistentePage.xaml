<Page x:Class="SuperPOS.Client.Views.Ai.AiAsistentePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:ai="clr-namespace:SuperPOS.Client.Views.Ai"
      xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
      Title="Asistente IA" Background="#141414">

    <Page.Resources>
        <ai:IaStringToVisibilityConverter x:Key="IaStr2Vis"/>
        <Style x:Key="AiBtn" TargetType="Button">
            <Setter Property="Background"        Value="#1E2A38"/>
            <Setter Property="Foreground"        Value="#A0C8F0"/>
            <Setter Property="BorderThickness"   Value="1"/>
            <Setter Property="BorderBrush"       Value="#2A4060"/>
            <Setter Property="Padding"           Value="18,10"/>
            <Setter Property="FontSize"          Value="13"/>
            <Setter Property="Cursor"            Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#263850"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1A3050"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#405060"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#202A36"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AiBtnActive" TargetType="Button" BasedOn="{StaticResource AiBtn}">
            <Setter Property="Background"  Value="#1A4A7A"/>
            <Setter Property="BorderBrush" Value="#3A8ADA"/>
            <Setter Property="Foreground"  Value="#FFFFFF"/>
        </Style>

        <Style x:Key="GridHeader" TargetType="DataGridColumnHeader">
            <Setter Property="Background"   Value="#1C2A38"/>
            <Setter Property="Foreground"   Value="#7AAAE0"/>
            <Setter Property="FontWeight"   Value="SemiBold"/>
            <Setter Property="FontSize"     Value="12"/>
            <Setter Property="Padding"      Value="10,6"/>
            <Setter Property="BorderBrush"  Value="#2A3A4A"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
        </Style>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Header -->
            <RowDefinition Height="Auto"/>
            <!-- Botones modo -->
            <RowDefinition Height="*"/>
            <!-- Contenido principal -->
            <RowDefinition Height="Auto"/>
            <!-- Input consulta libre -->
        </Grid.RowDefinitions>

        <!-- ===== HEADER ===== -->
        <Border Grid.Row="0" Background="#1A1A1A" Padding="24,14"
                BorderThickness="0,0,0,1" BorderBrush="#2A2A2A">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="🤖" FontSize="22" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <StackPanel>
                        <TextBlock Text="Asistente IA — DeepSeek" Foreground="White" FontSize="18" FontWeight="Bold"/>
                        <TextBlock Text="Análisis inteligente de tu negocio en tiempo real" Foreground="#607080" FontSize="11"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,0">
                    <TextBlock x:Name="TxtEstado" Text="● Listo" Foreground="#50C050" FontSize="12" VerticalAlignment="Center" Margin="0,0,16,0"/>
                    <Button x:Name="BtnBorrarChat" Content="🗑  Borrar conversación" Visibility="Collapsed"
                            Padding="10,4" FontSize="11" Margin="0,0,8,0" Cursor="Hand" Click="BtnBorrarChat_Click"
                            Background="#2A1A1A" Foreground="#C06060" BorderBrush="#4A2A2A" BorderThickness="1"/>
                    <TextBlock Text="Ventas" Foreground="#8090A0" VerticalAlignment="Center" Margin="8,0,4,0" FontSize="11"/>
                    <ComboBox x:Name="CmbDias" Width="130" FontSize="12" Background="#222" Foreground="White"
                              SelectionChanged="CmbDias_SelectionChanged">
                        <ComboBoxItem Content="Últimos 7 días"  Tag="7"/>
                        <ComboBoxItem Content="Últimos 30 días" Tag="30" IsSelected="True"/>
                        <ComboBoxItem Content="Últimos 60 días" Tag="60"/>
                        <ComboBoxItem Content="Últimos 90 días" Tag="90"/>
                    </ComboBox>
                    <TextBlock x:Name="TxtLabelTope" Text="Hasta" Foreground="#8090A0" VerticalAlignment="Center" Margin="10,0,4,0" FontSize="11" Visibility="Collapsed"/>
                    <ComboBox x:Name="CmbTopeSugerencias" Width="72" FontSize="12" Background="#222" Foreground="White" Visibility="Collapsed">
                        <ComboBoxItem Content="30"  Tag="30"/>
                        <ComboBoxItem Content="50"  Tag="50"/>
                        <ComboBoxItem Content="100" Tag="100" IsSelected="True"/>
                        <ComboBoxItem Content="200" Tag="200"/>
                        <ComboBoxItem Content="300" Tag="300"/>
                    </ComboBox>
                    <TextBlock x:Name="TxtSufijoTope" Text="art." Foreground="#8090A0" VerticalAlignment="Center" Margin="2,0,0,0" FontSize="11" Visibility="Collapsed"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===== BOTONES DE MODO ===== -->
        <Border Grid.Row="1" Background="#181818" Padding="24,12"
                BorderThickness="0,0,0,1" BorderBrush="#252525">
            <StackPanel Orientation="Horizontal">
                <Button x:Name="BtnSugerencias" Content="🛒  Sugerencias de Compra"
                        Style="{StaticResource AiBtnActive}" Margin="0,0,8,0"
                        Click="BtnModo_Click" Tag="compra"/>
                <Button x:Name="BtnVencimientos" Content="⏰  Alertas de Vencimiento"
                        Style="{StaticResource AiBtn}" Margin="0,0,8,0"
                        Click="BtnModo_Click" Tag="vencimiento"/>
                <Button x:Name="BtnVentas" Content="📈  Análisis de Ventas"
                        Style="{StaticResource AiBtn}" Margin="0,0,8,0"
                        Click="BtnModo_Click" Tag="ventas"/>
                <Button x:Name="BtnConsulta" Content="💬  Consulta Libre"
                        Style="{StaticResource AiBtn}" Margin="0,0,0,0"
                        Click="BtnModo_Click" Tag="consulta"/>

                <Button x:Name="BtnEjecutar" Content="▶  Analizar"
                        Style="{StaticResource AiBtn}" Margin="24,0,0,0"
                        Background="#1A4A1A" BorderBrush="#2A8A2A" Foreground="#70E070"
                        Click="BtnEjecutar_Click"/>
            </StackPanel>
        </Border>

        <!-- ===== CONTENIDO PRINCIPAL ===== -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="420"/>
                <!-- Respuesta IA -->
                <ColumnDefinition Width="*"/>
                <!-- Datos estructurados -->
            </Grid.ColumnDefinitions>

            <!-- Panel izquierdo: respuesta IA en texto -->
            <Border Grid.Column="0" Background="#161C22" BorderThickness="0,0,1,0" BorderBrush="#252F3A">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Background="#1C2530" Padding="14,8">
                        <TextBlock x:Name="TxtTituloPanelIa" Text="💡 Análisis IA" Foreground="#5AAAD0" FontSize="12" FontWeight="SemiBold"/>
                    </Border>
                    <Grid Grid.Row="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Border x:Name="BarraChats" Grid.Row="0" Visibility="Collapsed" Background="#141A22" BorderBrush="#2A3A4A" BorderThickness="0,0,0,1" Padding="8,6">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <DockPanel Grid.Row="0" LastChildFill="false" Margin="0,0,0,6">
                                    <TextBlock DockPanel.Dock="Left" Text="Conversaciones (cada una con su memoria)" Foreground="#5AAAD0" FontSize="11" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <Button x:Name="BtnNuevaConversacion" DockPanel.Dock="Right" Content="＋ Nueva" Padding="10,4" FontSize="11" Cursor="Hand"
                                            Click="BtnNuevaConversacion_Click" Background="#1A3A2A" Foreground="#80E0A0" BorderBrush="#2A6050" BorderThickness="1"/>
                                </DockPanel>
                                <ListBox x:Name="LstChats" Grid.Row="1" MaxHeight="96" Background="#0E1418" Foreground="#D0D8E0" BorderThickness="1" BorderBrush="#2A3A4A"
                                         SelectionChanged="LstChats_SelectionChanged">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Vertical" Margin="2,2">
                                                <TextBlock Text="{Binding Titulo}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" FontSize="12"/>
                                                <TextBlock Foreground="#6080A0" FontSize="10" Text="{Binding UpdatedLocal, StringFormat='Actualizado: {0:dd/MM HH:mm}'}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>
                        </Border>
                        <ScrollViewer x:Name="ScrollAnalisis" Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="16,12,8,12">
                            <StackPanel>
                                <TextBlock x:Name="TxtPlaceholderAnalisis"
                                           Text="Presioná ▶ Analizar (o escribí abajo). Cada pestaña (compra, vencimientos, ventas) tiene su historial a la izquierda. En consulta libre, cada conversación es un hilo aparte. Se guarda en la PC."
                                           TextWrapping="Wrap" FontSize="12" Foreground="#607888" LineHeight="20" Margin="0,0,0,12" Visibility="Collapsed"/>
                                <ItemsControl x:Name="ListaBitacora" Visibility="Visible">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="#2A3A4A" BorderThickness="0,0,0,1" Padding="0,0,0,14" Margin="0,0,0,14">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding LineaEncabezado}" Foreground="#5AAAD0" FontWeight="SemiBold" TextWrapping="Wrap" FontSize="12" Margin="0,0,0,6"/>
                                                    <TextBlock Text="{Binding InstruccionOUsuario, StringFormat=💬 {0}}"
                                                               TextWrapping="Wrap" Foreground="#7890A8" FontSize="11" LineHeight="18" Margin="0,0,0,6"
                                                               Visibility="{Binding InstruccionOUsuario, Converter={StaticResource IaStr2Vis}}"/>
                                                    <TextBlock Text="{Binding TextoIa}" TextWrapping="Wrap" Foreground="#C8D8E8" LineHeight="22" FontSize="13" FontFamily="Segoe UI"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                        <TextBlock x:Name="TxtRespuestaIA" Visibility="Collapsed" Text=""/>
                        <ListBox x:Name="LstConversacion" Grid.Row="1" Visibility="Collapsed" Padding="8"
                                 Background="Transparent" BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.CanContentScroll="False"
                                 VirtualizingStackPanel.IsVirtualizing="True">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Margin" Value="0,4"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <ContentPresenter Content="{TemplateBinding Content}" />
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="10,8" CornerRadius="10" MaxWidth="360">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding EsUsuario}" Value="True">
                                                        <Setter Property="Background" Value="#1A4A6A"/>
                                                        <Setter Property="HorizontalAlignment" Value="Right"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding EsUsuario}" Value="False">
                                                        <Setter Property="Background" Value="#1E1E2A"/>
                                                        <Setter Property="HorizontalAlignment" Value="Left"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding Texto}" TextWrapping="Wrap" Foreground="#D8E0F0"
                                                   FontSize="13" LineHeight="20" />
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Grid>
            </Border>

            <!-- Panel derecho: datos estructurados -->
            <Grid Grid.Column="1" Background="#141414">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Border Grid.Row="0" Background="#1A1E24" Padding="10,8" BorderThickness="0,0,0,1" BorderBrush="#252F3A">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="TxtTituloDatos" Text="📊 Datos" Foreground="#5AAAD0" VerticalAlignment="Center"
                                   FontSize="12" FontWeight="SemiBold"/>
                        <StackPanel x:Name="BarCompartir" Grid.Column="1" Orientation="Horizontal" Visibility="Collapsed">
                            <Button x:Name="BtnCopiarAnalisis" Content="📋  Copiar" FontSize="11" Padding="8,3" Margin="0,0,4,0" Click="BtnCopiarAnalisis_Click"/>
                            <Button x:Name="BtnDescargarGrafico" Content="🖼  Descargar gráfico" FontSize="11" Padding="8,3" Margin="0,0,4,0" Click="BtnDescargarGrafico_Click" Visibility="Collapsed"/>
                            <Button x:Name="BtnExportarCsv" Content="💾  Exportar CSV" FontSize="11" Padding="8,3" Click="BtnExportarCsv_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>
                <!-- OCs creadas desde aquí: estado Borrador; mismo historial a la izquierda, resultados a la derecha -->
                <Border x:Name="PanelBorradoresOc" Grid.Row="1" Background="#181C22" BorderBrush="#2A3A4A" BorderThickness="0,0,0,1"
                        Padding="8,6" Visibility="Collapsed">
                    <StackPanel>
                        <DockPanel LastChildFill="true" Margin="0,0,0,6">
                            <TextBlock DockPanel.Dock="Left" Text="📝  Órdenes de compra en borrador (desde el asistente)" Foreground="#7AA0C8" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <Button x:Name="BtnRefrescarBorradores" DockPanel.Dock="Right" Content="↻" ToolTip="Actualizar" Padding="10,2" Click="BtnRefrescarBorradores_Click"
                                    Background="#1E2A38" Foreground="#A0C8F0" BorderBrush="#2A4060" BorderThickness="1" FontSize="12" Cursor="Hand"/>
                        </DockPanel>
                        <TextBlock x:Name="TxtSinBorradores" Text="Ninguna aún. Generá sugerencias y «Orden de compra → proveedor»; se guardan como borrador." Foreground="#506070" FontSize="11" TextWrapping="Wrap"/>
                        <ItemsControl x:Name="ListaBorradoresOc" Visibility="Collapsed">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="#2A3A4A" BorderThickness="0,0,0,1" Padding="0,4">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Foreground="#B0C8E0" FontSize="12" TextWrapping="Wrap">
                                                    <TextBlock.Text>
                                                        <MultiBinding StringFormat="OC-{0:D6} · {1}">
                                                            <Binding Path="NroOrden" />
                                                            <Binding Path="ProveedorNombre" />
                                                        </MultiBinding>
                                                    </TextBlock.Text>
                                                </TextBlock>
                                                <TextBlock Foreground="#8090A0" FontSize="10">
                                                    <TextBlock.Text>
                                                        <MultiBinding StringFormat="{}{0:dd/MM/yyyy HH:mm} · {1:$#,##0.00}">
                                                            <Binding Path="Fecha" />
                                                            <Binding Path="Total" />
                                                        </MultiBinding>
                                                    </TextBlock.Text>
                                                </TextBlock>
                                            </StackPanel>
                                            <Button Grid.Column="1" Content="Abrir" Tag="{Binding Id}" Click="BtnAbrirBorradorOc_Click" Padding="10,4" FontSize="11" Cursor="Hand"
                                                    Background="#1A3A2A" Foreground="#80E0A0" BorderBrush="#2A6050" BorderThickness="1"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
                <WrapPanel x:Name="PanelAccionesIa" Grid.Row="2" Visibility="Collapsed" Margin="6,4,6,2" Orientation="Horizontal"/>
                <Border x:Name="PanelChartIa" Grid.Row="3" MinHeight="200" MaxHeight="280" Background="#101418" BorderBrush="#252F3A" BorderThickness="0,0,0,1" Padding="4" Visibility="Collapsed">
                    <lvc:CartesianChart x:Name="ChartIa" />
                </Border>

                <!-- Grid sugerencias de compra -->
                <DataGrid x:Name="GridSugerencias" Grid.Row="4"
                          AutoGenerateColumns="False" IsReadOnly="True"
                          Background="#141414" Foreground="#B0C8E0"
                          BorderThickness="0" GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="#1E2A36"
                          RowBackground="#141414" AlternatingRowBackground="#161C24"
                          ColumnHeaderStyle="{StaticResource GridHeader}"
                          SelectionMode="Single" CanUserResizeRows="False"
                          FontSize="12" Margin="0">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Origen"       Binding="{Binding OrigenSugerencia}" Width="64"/>
                        <DataGridTextColumn Header="Prioridad"    Binding="{Binding Prioridad}"       Width="64"/>
                        <DataGridTextColumn Header="Descripción"  Binding="{Binding Descripcion}"     Width="*"/>
                        <DataGridTextColumn Header="Uds/día"      Binding="{Binding VelocidadVentaDiaria, StringFormat=N2}" Width="58"/>
                        <DataGridTextColumn Header="Cob. d."      Binding="{Binding CoberturaDiasAproximada, TargetNullValue=''}" Width="50"/>
                        <DataGridTextColumn Header="Stock"        Binding="{Binding StockActual, StringFormat=N0}"   Width="60"/>
                        <DataGridTextColumn Binding="{Binding StockMinimo, StringFormat=N0}" Width="88">
                            <DataGridTextColumn.Header>
                                <TextBlock Text="Mín. góndola" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="86"
                                           ToolTip="Mínimo en góndola (ficha del artículo). La IA toma esto como piso de exposición."/>
                            </DataGridTextColumn.Header>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="A pedir"      Binding="{Binding CantidadSugerida, StringFormat=N0}" Width="65"/>
                        <DataGridTextColumn Header="Vend. perí."  Binding="{Binding CantidadVendida30Dias, StringFormat=N0}" Width="72"/>
                        <DataGridTextColumn Header="Proveedor"    Binding="{Binding Proveedor}"       Width="130"/>
                        <DataGridTextColumn Header="Total Est."   Binding="{Binding TotalEstimado, StringFormat=C2}" Width="90"/>
                    </DataGrid.Columns>
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Prioridad}" Value="Alta">
                                    <Setter Property="Foreground" Value="#FF8080"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Prioridad}" Value="Media">
                                    <Setter Property="Foreground" Value="#FFD080"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Prioridad}" Value="Baja">
                                    <Setter Property="Foreground" Value="#80C080"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>
                </DataGrid>

                <!-- Grid alertas vencimientos -->
                <DataGrid x:Name="GridVencimientos" Grid.Row="4" Visibility="Collapsed"
                          AutoGenerateColumns="False" IsReadOnly="True"
                          Background="#141414" Foreground="#B0C8E0"
                          BorderThickness="0" GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="#1E2A36"
                          RowBackground="#141414" AlternatingRowBackground="#161C24"
                          ColumnHeaderStyle="{StaticResource GridHeader}"
                          SelectionMode="Single" CanUserResizeRows="False" FontSize="12">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Urgencia"     Binding="{Binding Urgencia}"         Width="80"/>
                        <DataGridTextColumn Header="Descripción"  Binding="{Binding Descripcion}"      Width="*"/>
                        <DataGridTextColumn Header="Lote"         Binding="{Binding LoteNro}"          Width="90"/>
                        <DataGridTextColumn Header="Vence"        Binding="{Binding FechaVencimiento, StringFormat=dd/MM/yyyy}" Width="90"/>
                        <DataGridTextColumn Header="Días"         Binding="{Binding DiasRestantes}"    Width="60"/>
                        <DataGridTextColumn Header="Cantidad"     Binding="{Binding Cantidad, StringFormat=N0}" Width="80"/>
                    </DataGrid.Columns>
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Urgencia}" Value="Critica">
                                    <Setter Property="Foreground" Value="#FF6060"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Urgencia}" Value="Alta">
                                    <Setter Property="Foreground" Value="#FFB060"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>
                </DataGrid>

                <!-- Grid top productos (ventas) -->
                <DataGrid x:Name="GridVentas" Grid.Row="4" Visibility="Collapsed"
                          AutoGenerateColumns="False" IsReadOnly="True"
                          Background="#141414" Foreground="#B0C8E0"
                          BorderThickness="0" GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="#1E2A36"
                          RowBackground="#141414" AlternatingRowBackground="#161C24"
                          ColumnHeaderStyle="{StaticResource GridHeader}"
                          SelectionMode="Single" CanUserResizeRows="False" FontSize="12">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Producto"     Binding="{Binding Descripcion}"     Width="*"/>
                        <DataGridTextColumn Header="Cant. vendida" Binding="{Binding CantidadVendida, StringFormat=N0}" Width="110"/>
                        <DataGridTextColumn Header="Facturado"    Binding="{Binding TotalFacturado, StringFormat=C2}" Width="110"/>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Panel consulta libre -->
                <Border x:Name="PanelConsulta" Grid.Row="4" Visibility="Collapsed"
                        Background="#141414" Padding="24">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="500">
                        <TextBlock Text="💬 Consulta libre" Foreground="#5AAAD0" FontSize="16" FontWeight="Bold" Margin="0,0,0,8"/>
                        <TextBlock Text="Escribí cualquier pregunta sobre tu negocio y la IA responderá con el contexto actual de tu base de datos."
                                   TextWrapping="Wrap" Foreground="#7090B0" FontSize="12" Margin="0,0,0,16"/>
                        <TextBlock Text="Ejemplos:" Foreground="#507090" FontSize="11" Margin="0,0,0,6"/>
                        <TextBlock Text="• ¿Qué artículos debería reponer antes del fin de semana?" TextWrapping="Wrap" Foreground="#506070" FontSize="11" Margin="8,2"/>
                        <TextBlock Text="• ¿Cómo están las ventas comparado con el mes pasado?" TextWrapping="Wrap" Foreground="#506070" FontSize="11" Margin="8,2"/>
                        <TextBlock Text="• ¿Qué proveedor me da más problemas de stock?" TextWrapping="Wrap" Foreground="#506070" FontSize="11" Margin="8,2"/>
                        <TextBlock Text="• (con búsqueda web) ¿Cómo está mi precio de venta del aceite X vs. cadenas grandes?" TextWrapping="Wrap" Foreground="#506070" FontSize="11" Margin="8,2,8,16"/>
                        <TextBlock Text="Escribí tu pregunta abajo y presioná ▶ Analizar" Foreground="#405060" FontSize="11" FontStyle="Italic"/>
                    </StackPanel>
                </Border>

                <!-- Overlay de carga -->
                <Border x:Name="PanelCargando" Grid.Row="0" Grid.RowSpan="5" Background="#90141414" Visibility="Collapsed">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <ui:ProgressRing IsIndeterminate="True" Width="48" Height="48"/>
                        <TextBlock x:Name="TxtCargando" Text="Consultando IA..." Foreground="#5AAAD0"
                                   FontSize="14" HorizontalAlignment="Center" Margin="0,16,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <!-- ===== INPUT CHAT (visible en todos los modos) ===== -->
        <Border Grid.Row="3" x:Name="PanelInputConsulta"
                Background="#181E26" Padding="16,10"
                BorderThickness="0,1,0,0" BorderBrush="#253040">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Ícono + label contextual -->
                <StackPanel Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,0">
                    <TextBlock x:Name="TxtLabelInput" Text="💬 Instrucción:" Foreground="#5080A0"
                               FontSize="11" FontWeight="SemiBold"/>
                </StackPanel>

                <!-- TextBox de entrada -->
                <TextBox x:Name="TxtPregunta" Grid.Row="0" Grid.Column="1"
                         Background="#0E1620" Foreground="White" CaretBrush="White"
                         BorderBrush="#2A4060" BorderThickness="1"
                         FontSize="13" Padding="12,8" Height="38"
                         VerticalContentAlignment="Center"
                         KeyDown="TxtPregunta_KeyDown">
                    <TextBox.Style>
                        <Style TargetType="TextBox">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="TextBox">
                                        <Border Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="6">
                                            <Grid>
                                                <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
                                                <TextBlock x:Name="TxtPlaceholder"
                                                           Foreground="#3A5070" IsHitTestVisible="False"
                                                           VerticalAlignment="Center" Margin="14,0,0,0" FontSize="13"
                                                           Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Text, RelativeSource={RelativeSource TemplatedParent}}" Value="">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Grid>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </TextBox.Style>
                </TextBox>

                <Button Grid.Row="0" Grid.Column="2" x:Name="BtnEnviarChat"
                        Style="{StaticResource AiBtn}"
                        Background="#1A3A5A" BorderBrush="#2A6AAA" Foreground="#60B0FF"
                        Margin="8,0,0,0" Click="BtnEjecutar_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="▶" Margin="0,0,6,0"/>
                        <TextBlock x:Name="TxtBtnEnviar" Text="Analizar"/>
                    </StackPanel>
                </Button>

                <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,6,0,0">
                    <CheckBox x:Name="ChkBuscarWeb" Visibility="Collapsed" VerticalContentAlignment="Top"
                              Foreground="#90B0C8" FontSize="11" Cursor="Hand" IsChecked="True">
                        <TextBlock TextWrapping="Wrap" Text="Incluir internet (recomendado): compara con competencia, lee noticias del sector, inflación, referencias. También se activa solo si preguntás por cadenas, precios de mercado o escribís “internet”. Los precios de tu local vienen del POS; Tavily o Bing en appsettings de la API mejoran mucho los resultados."
                                   Foreground="#8098B0" FontSize="11"/>
                    </CheckBox>
                    <CheckBox x:Name="ChkWebAnalisis" Visibility="Collapsed" Margin="0,6,0,0" VerticalContentAlignment="Top"
                              Foreground="#90B0C8" FontSize="11" Cursor="Hand" IsChecked="True">
                        <TextBlock TextWrapping="Wrap" Text="Incluir internet en el análisis: contexto de mercado, competencia, tendencias y noticias (además de tus datos del POS). Configurá WebSearch:TavilyApiKey o BingApiKey en la API para mejores resultados."
                                   Foreground="#8098B0" FontSize="11"/>
                    </CheckBox>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Page>
