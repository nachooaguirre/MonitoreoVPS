<Window x:Class="SuperPOS.Client.Views.Remitos.RecibirPedidoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Recibir Pedido de Proveedor" Width="900" Height="660"
        WindowStartupLocation="CenterScreen" Background="#141414">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="📦 Recibir Pedido de Proveedor"
                   FontSize="18" FontWeight="Bold" Foreground="#D0D8E0" Margin="0,0,0,16"/>

        <!-- Selección OC -->
        <Border Grid.Row="1" Background="#1E1E1E" CornerRadius="8" Padding="14,12" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="ORDEN DE COMPRA" FontSize="10" FontWeight="Bold" Foreground="#607080" Margin="0,0,0,4"/>
                    <ComboBox x:Name="CboOC" Height="34" DisplayMemberPath="NroOrdenDisplay" SelectedValuePath="Id"
                              SelectionChanged="CboOC_Changed" Foreground="#F0F0F0" Background="#2A2A2A"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="PROVEEDOR" FontSize="10" FontWeight="Bold" Foreground="#607080" Margin="0,0,0,4"/>
                    <TextBlock x:Name="TxtProveedorOC" FontSize="14" FontWeight="SemiBold" Foreground="#D0D8E0" VerticalAlignment="Center" Height="34" Padding="0,8,0,0"/>
                </StackPanel>
                <ui:Button Grid.Column="3" Content="Cargar artículos" Height="34" Padding="14,0" Margin="12,0,0,0"
                           VerticalAlignment="Bottom" Click="BtnCargarArticulos_Click"/>
            </Grid>
        </Border>

        <!-- Datos del remito -->
        <Border Grid.Row="2" Background="#1E1E1E" CornerRadius="8" Padding="14,10" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="N° REMITO PROVEEDOR" FontSize="10" FontWeight="Bold" Foreground="#607080" Margin="0,0,0,4"/>
                    <ui:TextBox x:Name="TxtNroRemitoExt" PlaceholderText="Ej: 0001-00012345" Height="32"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="TRANSPORTISTA" FontSize="10" FontWeight="Bold" Foreground="#607080" Margin="0,0,0,4"/>
                    <ui:TextBox x:Name="TxtTransportista" PlaceholderText="Nombre del transportista" Height="32"/>
                </StackPanel>
                <StackPanel Grid.Column="4">
                    <TextBlock Text="OBSERVACIONES" FontSize="10" FontWeight="Bold" Foreground="#607080" Margin="0,0,0,4"/>
                    <ui:TextBox x:Name="TxtObs" PlaceholderText="Observaciones..." Height="32"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Grid de artículos a recibir -->
        <DataGrid x:Name="DgItems" Grid.Row="3"
                  AutoGenerateColumns="False"
                  Background="#141414" Foreground="#D0D8E0" FontSize="13"
                  RowBackground="#1A1A1A" AlternatingRowBackground="#1E1E1E"
                  HorizontalGridLinesBrush="#2A2A2A" BorderThickness="0" RowHeight="38"
                  CanUserAddRows="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="EAN" Binding="{Binding CodigoBarras}" Width="130" IsReadOnly="True">
                    <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="Foreground" Value="#607080"/><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Padding" Value="8,0"/></Style></DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="DESCRIPCIÓN" Binding="{Binding Descripcion}" Width="*" IsReadOnly="True">
                    <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Padding" Value="8,0"/></Style></DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="PEDIDO" Binding="{Binding CantidadPedida, StringFormat='N0'}" Width="80" IsReadOnly="True">
                    <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="Foreground" Value="#707080"/><Setter Property="HorizontalAlignment" Value="Right"/><Setter Property="Padding" Value="0,0,8,0"/></Style></DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="RECIBIDO" Binding="{Binding CantidadRecibida, StringFormat='N0'}" Width="90">
                    <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="Foreground" Value="#40C060"/><Setter Property="FontWeight" Value="Bold"/><Setter Property="HorizontalAlignment" Value="Right"/><Setter Property="Padding" Value="0,0,8,0"/></Style></DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="ACLARACIÓN/DIFERENCIA" Binding="{Binding ObservacionDiferencia}" Width="160" IsReadOnly="True">
                    <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="Foreground" Value="#E0A040"/><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Padding" Value="8,0"/></Style></DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="COSTO UNIT." Binding="{Binding PrecioCosto, StringFormat='$ #,##0.00'}" Width="110">
                    <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="Foreground" Value="#60A080"/><Setter Property="HorizontalAlignment" Value="Right"/><Setter Property="Padding" Value="0,0,8,0"/></Style></DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="LOTE" Binding="{Binding LoteNro}" Width="90"/>
                <DataGridTextColumn Header="VENCIMIENTO" Binding="{Binding FechaVenc, StringFormat='dd/MM/yyyy'}" Width="110"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Totales -->
        <Border Grid.Row="4" Background="#1C2030" CornerRadius="6" Padding="14,8" Margin="0,8,0,8">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Text="TOTAL MERCADERÍA A RECIBIR" FontSize="12" Foreground="#406080" FontWeight="Bold" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <TextBlock x:Name="TxtCantItems" FontSize="14" Foreground="#D0D8E0" VerticalAlignment="Center" Margin="0,0,16,0"/>
                    <TextBlock x:Name="TxtTotalCosto" FontSize="18" FontWeight="Bold" Foreground="#60A080"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Botones -->
        <Grid Grid.Row="5">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="200"/></Grid.ColumnDefinitions>
            <Button Content="Cancelar" Height="42" Foreground="#FF7070" BorderBrush="#5A2A2A" BorderThickness="1" Click="BtnCancelar_Click"/>
            <Button Grid.Column="2" x:Name="BtnConfirmar" Content="✓  Confirmar Recepción"
                    Height="42" FontSize="14" FontWeight="Bold"
                    Background="#1A4030" Foreground="#40D080" BorderBrush="#2A5040" BorderThickness="1"
                    IsEnabled="False" Click="BtnConfirmar_Click"/>
        </Grid>
    </Grid>
</Window>
