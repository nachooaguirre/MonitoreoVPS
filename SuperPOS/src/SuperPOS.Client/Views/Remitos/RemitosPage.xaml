<Page x:Class="SuperPOS.Client.Views.Remitos.RemitosPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="Remitos" Background="#141414">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#1A1A1A" Padding="20,14" BorderThickness="0,0,0,1" BorderBrush="#2A2A2A">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="📄" FontSize="24" Margin="0,0,12,0"/>
                    <StackPanel>
                        <TextBlock Text="Remitos" FontSize="20" FontWeight="Bold" Foreground="#F0F0F0"/>
                        <TextBlock Text="Recepción y entrega de mercadería" FontSize="11" Foreground="#607080"/>
                    </StackPanel>
                </StackPanel>
                <ui:Button Grid.Column="1" Content="📦 Recibir Pedido OC" Height="36" Padding="14,0" Margin="0,0,8,0" Click="BtnRecibirOC_Click"/>
                <ui:Button Grid.Column="2" Content="+ Remito Manual" Height="36" Padding="16,0" Click="BtnNuevoRemito_Click"/>
            </Grid>
        </Border>

        <!-- Filtros -->
        <Border Grid.Row="1" Background="#1E1E1E" Padding="14,10" Margin="16,12,16,0" CornerRadius="8">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Tipo:" Foreground="#809090" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ComboBox x:Name="CboTipo" Width="130" Height="32" SelectionChanged="Filtrar_Changed"
                          Foreground="#F0F0F0" Background="#2A2A2A">
                    <ComboBoxItem Content="Todos" IsSelected="True"/>
                    <ComboBoxItem Content="Entrada (compra)"/>
                    <ComboBoxItem Content="Salida"/>
                </ComboBox>
                <TextBlock Text="Estado:" Foreground="#809090" VerticalAlignment="Center" Margin="14,0,8,0"/>
                <ComboBox x:Name="CboEstado" Width="120" Height="32" SelectionChanged="Filtrar_Changed"
                          Foreground="#F0F0F0" Background="#2A2A2A">
                    <ComboBoxItem Content="Todos" IsSelected="True"/>
                    <ComboBoxItem Content="Pendiente"/>
                    <ComboBoxItem Content="Confirmado"/>
                    <ComboBoxItem Content="Anulado"/>
                </ComboBox>
                <Button Content="🔄" Height="32" Width="36" Margin="8,0,0,0" Click="BtnRefresh_Click"/>
            </StackPanel>
        </Border>

        <!-- Tabla -->
        <DataGrid x:Name="DgRemitos" Grid.Row="2" Margin="16,12,16,0"
                  AutoGenerateColumns="False" IsReadOnly="True"
                  Background="#141414" Foreground="#D0D8E0" FontSize="13"
                  RowBackground="#1A1A1A" AlternatingRowBackground="#1E1E1E"
                  HorizontalGridLinesBrush="#2A2A2A" BorderThickness="0" RowHeight="40"
                  SelectionMode="Single" MouseDoubleClick="DgRemitos_DoubleClick">
            <DataGrid.Columns>
                <DataGridTextColumn Header="N° REM." Binding="{Binding NroRemito, StringFormat='REM-{0:D6}'}" Width="110">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="#60A0C0"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                            <Setter Property="Padding" Value="8,0"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="FECHA" Binding="{Binding Fecha, StringFormat='dd/MM/yyyy HH:mm'}" Width="130"/>
                <DataGridTemplateColumn Header="TIPO" Width="90">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border CornerRadius="4" Padding="6,3" Margin="4" HorizontalAlignment="Left">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Tipo}" Value="0"><Setter Property="Background" Value="#0A2010"/></DataTrigger>
                                            <DataTrigger Binding="{Binding Tipo}" Value="1"><Setter Property="Background" Value="#20100A"/></DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock FontSize="11" FontWeight="Bold">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Tipo}" Value="0">
                                                    <Setter Property="Text" Value="ENTRADA"/>
                                                    <Setter Property="Foreground" Value="#40C060"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Tipo}" Value="1">
                                                    <Setter Property="Text" Value="SALIDA"/>
                                                    <Setter Property="Foreground" Value="#C06040"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="PROVEEDOR / CLIENTE" Width="*">
                    <DataGridTextColumn.Binding>
                        <MultiBinding StringFormat="{}{0}{1}">
                            <Binding Path="ProveedorNombre" TargetNullValue=""/>
                            <Binding Path="ClienteNombre" TargetNullValue=""/>
                        </MultiBinding>
                    </DataGridTextColumn.Binding>
                </DataGridTextColumn>
                <DataGridTextColumn Header="REM. EXTERNO" Binding="{Binding NroRemitoExterno}" Width="120"/>
                <DataGridTemplateColumn Header="ESTADO" Width="110">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border CornerRadius="4" Padding="6,3" Margin="4" HorizontalAlignment="Left">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Estado}" Value="0"><Setter Property="Background" Value="#201800"/></DataTrigger>
                                            <DataTrigger Binding="{Binding Estado}" Value="1"><Setter Property="Background" Value="#0A1A0A"/></DataTrigger>
                                            <DataTrigger Binding="{Binding Estado}" Value="2"><Setter Property="Background" Value="#1A0A0A"/></DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock FontSize="11" FontWeight="Bold">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Estado}" Value="0">
                                                    <Setter Property="Text" Value="PENDIENTE"/>
                                                    <Setter Property="Foreground" Value="#C0A020"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Estado}" Value="1">
                                                    <Setter Property="Text" Value="CONFIRMADO"/>
                                                    <Setter Property="Foreground" Value="#40C060"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Estado}" Value="2">
                                                    <Setter Property="Text" Value="ANULADO"/>
                                                    <Setter Property="Foreground" Value="#C04040"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Footer -->
        <Border Grid.Row="3" Background="#1A1A1A" Padding="16,8" Margin="16,8,16,0" CornerRadius="6">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Doble clic para ver detalle o confirmar recepción" FontSize="11" Foreground="#506070"/>
                <TextBlock x:Name="TxtTotal" FontSize="12" Foreground="#60A0C0" FontWeight="Bold" Margin="20,0,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</Page>
