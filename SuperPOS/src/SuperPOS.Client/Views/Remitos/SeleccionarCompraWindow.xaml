<ui:FluentWindow x:Class="SuperPOS.Client.Views.Remitos.SeleccionarCompraWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Conciliar con Factura" Width="440" Height="260"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        ExtendsContentIntoTitleBar="True">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <ui:TitleBar Grid.Row="0" Title="Conciliar remito con factura del proveedor"/>
        <StackPanel Grid.Row="1" Margin="24">
            <TextBlock Text="Elegí la factura (Compra) a conciliar contra lo realmente recibido:" TextWrapping="Wrap" Margin="0,0,0,12"/>
            <ComboBox x:Name="CboCompra" DisplayMemberPath="Display" Height="32"/>
        </StackPanel>
        <Border Grid.Row="2" Padding="24,12" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <ui:Button Content="Cancelar" Margin="0,0,8,0" Click="BtnCancelar_Click"/>
                <ui:Button Content="Conciliar" Appearance="Primary" Click="BtnConfirmar_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</ui:FluentWindow>
