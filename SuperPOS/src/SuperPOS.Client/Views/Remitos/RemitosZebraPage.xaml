<Page x:Class="SuperPOS.Client.Views.Remitos.RemitosZebraPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="Escaneos Zebra" Background="#141414">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#1A1A1A" Padding="20,14" BorderThickness="0,0,0,1" BorderBrush="#2A2A2A">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="📱" FontSize="24" Margin="0,0,12,0"/>
                    <StackPanel>
                        <TextBlock Text="Escaneos Zebra pendientes" FontSize="20" FontWeight="Bold" Foreground="#F0F0F0"/>
                        <TextBlock Text="Recepciones escaneadas en depósito, esperando revisión y confirmación en caja" FontSize="11" Foreground="#607080"/>
                    </StackPanel>
                </StackPanel>
                <Button Grid.Column="1" Content="🔄 Actualizar" Height="36" Padding="14,0" Click="BtnRefresh_Click"/>
            </Grid>
        </Border>

        <!-- Tabla -->
        <DataGrid x:Name="DgRemitos" Grid.Row="1" Margin="16,12,16,0"
                  AutoGenerateColumns="False" IsReadOnly="True"
                  Background="#141414" Foreground="#D0D8E0" FontSize="13"
                  RowBackground="#1A1A1A" AlternatingRowBackground="#1E1E1E"
                  HorizontalGridLinesBrush="#2A2A2A" BorderThickness="0" RowHeight="40"
                  SelectionMode="Single" MouseDoubleClick="DgRemitos_DoubleClick">
            <DataGrid.Columns>
                <DataGridTextColumn Header="N° REM." Binding="{Binding NroRemito, StringFormat='REM-{0:D6}'}" Width="110">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="#60A0C0"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                            <Setter Property="Padding" Value="8,0"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="FECHA ESCANEO" Binding="{Binding Fecha, StringFormat='dd/MM/yyyy HH:mm'}" Width="150"/>
                <DataGridTextColumn Header="PROVEEDOR" Binding="{Binding ProveedorNombre}" Width="*"/>
                <DataGridTextColumn Header="ARTÍCULOS" Binding="{Binding CantArticulos}" Width="100"/>
                <DataGridTemplateColumn Header="ESTADO" Width="120">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border CornerRadius="4" Padding="6,3" Margin="4" HorizontalAlignment="Left" Background="#201800">
                                <TextBlock Text="POR REVISAR" FontSize="11" FontWeight="Bold" Foreground="#C0A020"/>
                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Footer -->
        <Border Grid.Row="2" Background="#1A1A1A" Padding="16,8" Margin="16,8,16,0" CornerRadius="6">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Doble clic para revisar cantidades y confirmar la recepción (recién ahí se actualiza el stock)" FontSize="11" Foreground="#506070"/>
                <TextBlock x:Name="TxtTotal" FontSize="12" Foreground="#60A0C0" FontWeight="Bold" Margin="20,0,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</Page>
