<Page x:Class="SuperPOS.Client.Views.CtaCte.CtaCtePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="Cuenta Corriente">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Padding="20,14">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="💳" FontSize="22" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBlock Text="Cuenta Corriente" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1" Margin="16,0,16,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Panel izquierdo: lista de clientes con Cta Cte -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Margin="0,0,0,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ui:TextBox x:Name="TxtBuscarCliente" PlaceholderText="Buscar cliente..." Grid.Column="0"
                                    TextChanged="TxtBuscarCliente_TextChanged"/>
                        <CheckBox x:Name="ChkSoloDeudores" Content="Solo deudores" Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center"
                                  Checked="ChkSoloDeudores_Changed" Unchecked="ChkSoloDeudores_Changed"/>
                    </Grid>
                </StackPanel>
                <ListBox Grid.Row="1" x:Name="LstClientes" SelectionChanged="LstClientes_SelectionChanged">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="{Binding RazonSocial}" FontWeight="SemiBold"/>
                            <StackPanel Grid.Row="1" Orientation="Horizontal">
                                <TextBlock Text="Saldo: " Opacity="0.6" FontSize="12"/>
                                <TextBlock Text="{Binding SaldoCtaCte, StringFormat=C2}" FontSize="12" Foreground="OrangeRed"/>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
                </ListBox>
            </Grid>

            <!-- Panel derecho: movimientos del cliente seleccionado -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Encabezado del cliente -->
                <Border Grid.Row="0" CornerRadius="8" Padding="16" Margin="0,0,0,8"
                        Visibility="{Binding ElementName=LstClientes, Path=SelectedItem, Converter={StaticResource NullToVisConverter}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock x:Name="TxtClienteNombre" FontSize="18" FontWeight="SemiBold"/>
                            <TextBlock x:Name="TxtClienteInfo" Opacity="0.6" FontSize="12"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                            <TextBlock Text="Saldo actual" Opacity="0.6" FontSize="12" HorizontalAlignment="Right"/>
                            <TextBlock x:Name="TxtSaldoActual" FontSize="26" FontWeight="Bold" Foreground="OrangeRed"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Filtro fechas movimientos -->
                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBlock Text="Desde:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <DatePicker x:Name="DpMovDesde" Width="130"/>
                    <TextBlock Text="  Hasta:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <DatePicker x:Name="DpMovHasta" Width="130"/>
                    <ui:Button Content="🔍" Margin="6,0,0,0" Click="BtnFiltrarMov_Click"/>
                </StackPanel>

                <!-- Grilla movimientos -->
                    <DataGrid Grid.Row="2" x:Name="DgMovimientos" AutoGenerateColumns="False"
                              IsReadOnly="True" CanUserAddRows="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Fecha" Binding="{Binding Fecha, StringFormat=dd/MM/yyyy HH:mm}" Width="140"/>
                            <DataGridTextColumn Header="Tipo" Binding="{Binding Tipo}" Width="100"/>
                            <DataGridTextColumn Header="Concepto" Binding="{Binding Concepto}" Width="*"/>
                            <DataGridTextColumn Header="Debe" Binding="{Binding Debe, StringFormat=C2}" Width="100"/>
                            <DataGridTextColumn Header="Haber" Binding="{Binding Haber, StringFormat=C2}" Width="100"/>
                            <DataGridTextColumn Header="Saldo" Binding="{Binding SaldoAcumulado, StringFormat=C2}" Width="110"/>
                        </DataGrid.Columns>
                    </DataGrid>

                <!-- Botones acciones -->
                <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                    <ui:Button x:Name="BtnRegistrarPago" Content="💵 Registrar Pago" Appearance="Primary" Height="38" Margin="0,0,8,0"
                               Click="BtnRegistrarPago_Click" IsEnabled="False"/>
                    <ui:Button x:Name="BtnAjuste" Content="📝 Ajuste Manual" Height="38"
                               Click="BtnAjuste_Click" IsEnabled="False"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Page>
