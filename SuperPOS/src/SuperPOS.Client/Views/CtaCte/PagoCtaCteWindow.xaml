<ui:FluentWindow x:Class="SuperPOS.Client.Views.CtaCte.PagoCtaCteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Registrar Pago" Width="420" Height="340"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        ExtendsContentIntoTitleBar="True">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <ui:TitleBar Grid.Row="0" Title="Registrar Pago"/>
        <StackPanel Grid.Row="1" Margin="24">
            <TextBlock x:Name="TxtCliente" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,4"/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                <TextBlock Text="Saldo actual: " Opacity="0.6"/>
                <TextBlock x:Name="TxtSaldo" FontWeight="SemiBold" Foreground="OrangeRed"/>
            </StackPanel>
            <TextBlock Text="Monto a cobrar" Margin="0,0,0,4"/>
            <ui:NumberBox x:Name="NumMonto" Minimum="0.01" PlaceholderText="0,00" Margin="0,0,0,12"/>
            <TextBlock Text="Concepto (opcional)" Margin="0,0,0,4"/>
            <ui:TextBox x:Name="TxtConcepto" PlaceholderText="Pago de cuenta corriente"/>
        </StackPanel>
        <Border Grid.Row="2" Padding="24,12" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <ui:Button Content="Cancelar" Margin="0,0,8,0" Click="BtnCancelar_Click"/>
                <ui:Button Content="💵 Confirmar Pago" Appearance="Primary" Click="BtnConfirmar_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</ui:FluentWindow>
