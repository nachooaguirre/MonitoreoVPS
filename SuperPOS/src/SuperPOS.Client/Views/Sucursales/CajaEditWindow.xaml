<ui:FluentWindow x:Class="SuperPOS.Client.Views.Sucursales.CajaEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Punto de Venta"
        Width="380" Height="260"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ExtendsContentIntoTitleBar="True">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <ui:TitleBar Grid.Row="0" Title="Punto de Venta"/>

        <StackPanel Grid.Row="1" Margin="20,8">
            <TextBlock Text="Nombre *" Margin="0,0,0,4"/>
            <ui:TextBox x:Name="TxtNombre" Margin="0,0,0,12"/>

            <CheckBox x:Name="ChkActivo" Content="Activo" IsChecked="True"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="20,12">
            <Button Content="Cancelar" Width="100" Height="36" Margin="0,0,8,0" Click="BtnCancelar_Click"/>
            <ui:Button Content="Guardar" Appearance="Primary" Width="120" Height="36" Click="BtnGuardar_Click"/>
        </StackPanel>
    </Grid>
</ui:FluentWindow>
