<ui:FluentWindow x:Class="SuperPOS.Client.Views.Sucursales.SeleccionarPuntoVentaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="¿Qué punto de venta abrís?"
        Width="420" Height="480"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        ExtendsContentIntoTitleBar="True">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <ui:TitleBar Grid.Row="0" Title="¿Qué punto de venta abrís?" ShowMaximize="False" ShowMinimize="False"/>

        <Grid Grid.Row="1" Margin="20,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="Elegí la terminal con la que vas a trabajar en esta PC:" Margin="0,0,0,12" TextWrapping="Wrap"/>
            <ListBox x:Name="LstCajas" Grid.Row="1" BorderThickness="0" Background="Transparent"
                     SelectionMode="Single" MouseDoubleClick="LstCajas_MouseDoubleClick">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Background="#1E1E1E" CornerRadius="6" Padding="12,10" Margin="0,0,0,8">
                            <StackPanel>
                                <TextBlock Text="{Binding Nombre}" FontWeight="Bold" FontSize="15"/>
                                <TextBlock Text="{Binding SucursalNombre}" Opacity="0.65" FontSize="12"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>

        <ui:Button Grid.Row="2" Content="Abrir" Appearance="Primary" HorizontalAlignment="Stretch"
                   Height="40" Margin="20,0,20,16" Click="BtnAbrir_Click"/>
    </Grid>
</ui:FluentWindow>
