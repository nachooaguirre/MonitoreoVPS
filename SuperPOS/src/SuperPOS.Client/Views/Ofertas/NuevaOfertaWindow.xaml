<ui:FluentWindow x:Class="SuperPOS.Client.Views.Ofertas.NuevaOfertaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Crear/Editar Oferta"
        Width="520" Height="580"
        WindowStartupLocation="CenterOwner"
        ExtendsContentIntoTitleBar="True"
        Background="#141414">
    <Grid Margin="0,0,0,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <ui:TitleBar Grid.Row="0" Title="Configuración de Oferta Especial"/>

        <ScrollViewer Grid.Row="1" Margin="24,12,24,12" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Artículo -->
                <StackPanel Margin="0,0,0,12">
                    <TextBlock Text="Artículo *" Foreground="#8090A0" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ui:TextBox x:Name="TxtArticuloDesc" PlaceholderText="Seleccione un artículo..." IsReadOnly="True" Background="#1C1C1C" Foreground="#FFF" Height="36"/>
                        <ui:Button Grid.Column="1" Content="Buscar..." Margin="8,0,0,0" Height="36" Click="BtnBuscarArticulo_Click"/>
                    </Grid>
                    <TextBlock x:Name="TxtPrecioOriginal" Text="Precio normal: $ 0.00" Foreground="#FFA0A0" FontSize="11.5" Margin="2,4,0,0" Visibility="Collapsed"/>
                </StackPanel>

                <!-- Detalle / Título Promoción -->
                <StackPanel Margin="0,0,0,12">
                    <TextBlock Text="Detalle / Nombre de la Oferta *" Foreground="#8090A0" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <ui:TextBox x:Name="TxtDetalle" PlaceholderText="Ej. Súper Oferta Fin de Semana" MaxLength="150" Height="36"/>
                </StackPanel>

                <!-- Precio de Oferta -->
                <StackPanel Margin="0,0,0,12">
                    <TextBlock Text="Precio Especial de Oferta *" Foreground="#8090A0" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <ui:TextBox x:Name="TxtPrecioOferta" PlaceholderText="0.00" Height="36" PreviewTextInput="NumberValidationTextBox"/>
                </StackPanel>

                <!-- Fechas Vigencia -->
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    
                    <!-- Fecha Desde -->
                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                        <TextBlock Text="Fecha Inicio *" Foreground="#8090A0" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <DatePicker x:Name="DpFechaDesde" Height="36" Background="#1C1C1C" BorderBrush="#333" Foreground="White"/>
                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <ui:TextBox x:Name="TxtHoraDesde" PlaceholderText="00" MaxLength="2" HorizontalContentAlignment="Center" PreviewTextInput="NumberValidationTextBox"/>
                            <TextBlock Grid.Column="1" Text=":" VerticalAlignment="Center" Margin="4,0" Foreground="White"/>
                            <ui:TextBox x:Name="TxtMinutoDesde" Grid.Column="2" PlaceholderText="00" MaxLength="2" HorizontalContentAlignment="Center" PreviewTextInput="NumberValidationTextBox"/>
                        </Grid>
                    </StackPanel>

                    <!-- Fecha Hasta -->
                    <StackPanel Grid.Column="1" Margin="8,0,0,0">
                        <TextBlock Text="Fecha Fin *" Foreground="#8090A0" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <DatePicker x:Name="DpFechaHasta" Height="36" Background="#1C1C1C" BorderBrush="#333" Foreground="White"/>
                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <ui:TextBox x:Name="TxtHoraHasta" PlaceholderText="23" MaxLength="2" HorizontalContentAlignment="Center" PreviewTextInput="NumberValidationTextBox"/>
                            <TextBlock Grid.Column="1" Text=":" VerticalAlignment="Center" Margin="4,0" Foreground="White"/>
                            <ui:TextBox x:Name="TxtMinutoHasta" Grid.Column="2" PlaceholderText="59" MaxLength="2" HorizontalContentAlignment="Center" PreviewTextInput="NumberValidationTextBox"/>
                        </Grid>
                    </StackPanel>
                </Grid>

                <!-- Límite Stock (Hasta Agotar Stock) -->
                <Border BorderBrush="#2A2A2A" BorderThickness="1" CornerRadius="8" Padding="12" Background="#1C1C1C" Margin="0,0,0,12">
                    <StackPanel>
                        <CheckBox x:Name="ChkConLimite" Content="Limitar por cantidad vendida (Hasta agotar stock)" Foreground="#D0D0D0" Checked="ChkConLimite_CheckedChanged" Unchecked="ChkConLimite_CheckedChanged" Margin="0,0,0,8"/>
                        <StackPanel x:Name="PanelLimite" Visibility="Collapsed">
                            <TextBlock Text="Cantidad Límite de Stock (Unidades)" Foreground="#8090A0" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4"/>
                            <ui:TextBox x:Name="TxtLimiteStock" PlaceholderText="Ej. 100" Height="36" PreviewTextInput="NumberValidationTextBox"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Activa -->
                <CheckBox x:Name="ChkActiva" Content="Promoción Activa" IsChecked="True" Foreground="#D0D0D0"/>
            </StackPanel>
        </ScrollViewer>

        <!-- Botones de Acción -->
        <Border Grid.Row="2" BorderBrush="#222" BorderThickness="0,1,0,0" Padding="24,12,24,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <ui:Button Grid.Column="1" Content="Cancelar" Margin="0,0,8,0" Width="100" Height="36" Click="BtnCancelar_Click"/>
                <ui:Button Grid.Column="2" Content="Guardar" Appearance="Primary" Width="110" Height="36" Click="BtnGuardar_Click"/>
            </Grid>
        </Border>
    </Grid>
</ui:FluentWindow>
