<Page x:Class="SuperPOS.Client.Views.Ofertas.OfertasPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
      Title="Ofertas Especiales" Background="#141414">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Módulo de Ofertas Especiales" FontSize="22" FontWeight="Bold" Foreground="#F0F0F0"/>
                <TextBlock Text="Administre y controle los precios promocionales por fechas y límites de stock" FontSize="12" Foreground="#8090A0" Margin="0,2,0,0"/>
            </StackPanel>
            <ui:Button Grid.Column="1" Content="+ Nueva Oferta" Appearance="Primary" Click="BtnNuevaOferta_Click" Icon="Add24"/>
        </Grid>

        <!-- Contenido Principal -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="420"/>
            </Grid.ColumnDefinitions>

            <!-- Panel Izquierdo: Listado de Ofertas -->
            <Border Grid.Column="0" Background="#1E1E1E" CornerRadius="8" BorderBrush="#2D2D2D" BorderThickness="1" Padding="12" Margin="0,0,16,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <TextBlock Grid.Row="0" Text="Listado de Promociones" FontSize="14" FontWeight="SemiBold" Foreground="#C0D0FF" Margin="0,0,0,8"/>
                    
                    <DataGrid x:Name="DgOfertas" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True"
                              SelectionMode="Single" GridLinesVisibility="Horizontal" CanUserResizeRows="False"
                              BorderThickness="0" Background="Transparent" Foreground="#D0D0D0" FontSize="13"
                              RowHeight="36" SelectionChanged="DgOfertas_SelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="45"/>
                            <DataGridTextColumn Header="Descripción / Detalle" Binding="{Binding Detalle}" Width="*"/>
                            <DataGridTextColumn Header="Artículo" Binding="{Binding Articulo.Descripcion}" Width="160"/>
                            <DataGridTextColumn Header="Desde" Binding="{Binding FechaDesde, StringFormat='dd/MM/yyyy HH:mm'}" Width="110"/>
                            <DataGridTextColumn Header="Hasta" Binding="{Binding FechaHasta, StringFormat='dd/MM/yyyy HH:mm'}" Width="110"/>
                            <DataGridTextColumn Header="P. Promo" Width="85">
                                <DataGridTextColumn.Binding>
                                    <Binding Path="PrecioOferta" StringFormat="$ #,##0.00"/>
                                </DataGridTextColumn.Binding>
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Right"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                        <Setter Property="Foreground" Value="#60C0FF"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Vend." Binding="{Binding CantidadVendida, StringFormat='N1'}" Width="60">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock"><Setter Property="HorizontalAlignment" Value="Right"/></Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Límite" Binding="{Binding LimiteStock, StringFormat='N1', TargetNullValue='S/L'}" Width="65">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock"><Setter Property="HorizontalAlignment" Value="Right"/></Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridCheckBoxColumn Header="Act." Binding="{Binding Activa}" IsReadOnly="True" Width="45"/>
                            <DataGridTemplateColumn Header="Acción" Width="80">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <Button Content="✏" Width="28" Height="24" Margin="2,0" Padding="0" ToolTip="Editar" Tag="{Binding}" Click="BtnEditar_Click" Background="#282828" BorderBrush="#444" Foreground="#CCC"/>
                                            <Button Content="🗑" Width="28" Height="24" Margin="2,0" Padding="0" ToolTip="Eliminar" Tag="{Binding}" Click="BtnEliminar_Click" Background="#2A1010" BorderBrush="#552222" Foreground="#FFA0A0"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- Panel Derecho: Gráfico y Detalle de Rendimiento -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Tarjeta de Info Resumen -->
                <Border Grid.Row="0" Background="#1E1E1E" CornerRadius="8" BorderBrush="#2D2D2D" BorderThickness="1" Padding="16" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="Rendimiento de la Oferta" FontSize="14" FontWeight="SemiBold" Foreground="#C0D0FF" Margin="0,0,0,12"/>
                        <TextBlock x:Name="TxtInfoVacia" Text="Seleccione una oferta para visualizar sus métricas de ventas." Foreground="#8090A0" FontSize="12" FontStyle="Italic"/>
                        
                        <Grid x:Name="GridDetallesRendimiento" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,8,8">
                                <TextBlock Text="PRODUCCIÓN TOTAL" FontSize="10" Foreground="#8090A0" FontWeight="SemiBold"/>
                                <TextBlock x:Name="TxtResumenVendida" Text="0.0 u." FontSize="18" FontWeight="Bold" Foreground="#60C0FF"/>
                            </StackPanel>
                            
                            <StackPanel Grid.Row="0" Grid.Column="1" Margin="8,0,0,8">
                                <TextBlock Text="LÍMITE STOCK" FontSize="10" Foreground="#8090A0" FontWeight="SemiBold"/>
                                <TextBlock x:Name="TxtResumenLimite" Text="Sin límite" FontSize="18" FontWeight="Bold" Foreground="#F0F0F0"/>
                            </StackPanel>
                            
                            <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,8,8,8">
                                <TextBlock Text="PRECIO REGULAR" FontSize="10" Foreground="#8090A0" FontWeight="SemiBold"/>
                                <TextBlock x:Name="TxtResumenPrecioReg" Text="$ 0.00" FontSize="15" FontWeight="SemiBold" Foreground="#FFA0A0" TextDecorations="Strikethrough"/>
                            </StackPanel>

                            <StackPanel Grid.Row="1" Grid.Column="1" Margin="8,8,0,8">
                                <TextBlock Text="PRECIO OFERTA" FontSize="10" Foreground="#8090A0" FontWeight="SemiBold"/>
                                <TextBlock x:Name="TxtResumenPrecioPromo" Text="$ 0.00" FontSize="15" FontWeight="Bold" Foreground="#40D080"/>
                            </StackPanel>
                            
                            <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Margin="0,8,0,0">
                                <TextBlock Text="PROGRESO DE LA PROMOCIÓN" FontSize="10" Foreground="#8090A0" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                <ProgressBar x:Name="PbProgresoStock" Height="8" Background="#141414" Foreground="#40D080" BorderThickness="0" Minimum="0" Maximum="100"/>
                                <TextBlock x:Name="TxtProgresoPorcentaje" Text="0% agotado" FontSize="11" Foreground="#8090A0" HorizontalAlignment="Right" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Tarjeta del Gráfico -->
                <Border Grid.Row="1" Background="#1E1E1E" CornerRadius="8" BorderBrush="#2D2D2D" BorderThickness="1" Padding="12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="Evolución Diaria (Unidades)" FontSize="13" FontWeight="SemiBold" Foreground="#A0B0D0" Margin="0,0,0,10"/>
                        <lvc:CartesianChart x:Name="ChartVentas" Grid.Row="1" Background="#141414" TooltipPosition="Hidden" AnimationsSpeed="0:0:0.3"/>
                        <TextBlock x:Name="TxtChartSinDatos" Grid.Row="1" Text="No se registran ventas para este producto en el período" Foreground="#607080" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Page>
