<Page x:Class="SuperPOS.Client.Views.Caja.CajaPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="Caja" Background="#141414">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Header (64px) -->
            <RowDefinition Height="*"/>    <!-- Main Workspace (Items + Keypad) -->
            <RowDefinition Height="Auto"/> <!-- Bottom Panel (Totals + Payment) -->
            <RowDefinition Height="32"/>   <!-- Footer Status Bar -->
        </Grid.RowDefinitions>

        <!-- ====== HEADER: TopAppBar (64px) ====== -->
        <Border Grid.Row="0" Height="64" Background="#1A1A1A" BorderThickness="0,0,0,1" BorderBrush="#2A2A2A">
            <Grid Margin="24,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>    <!-- Search Box + Quantity -->
                    <ColumnDefinition Width="Auto"/> <!-- Utility Buttons -->
                    <ColumnDefinition Width="Auto"/> <!-- Client Info -->
                    <ColumnDefinition Width="Auto"/> <!-- Profile -->
                </Grid.ColumnDefinitions>

                <!-- Search box + Quantity -->
                <Grid Grid.Column="0" VerticalAlignment="Center" Margin="0,0,24,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ui:TextBox x:Name="TxtBuscarArticulo" Grid.Column="0"
                                PlaceholderText="Escanear código de barras o buscar artículo..."
                                FontSize="15" Height="40" Margin="0,0,8,0"
                                KeyDown="TxtBuscarArticulo_KeyDown"
                                Icon="Search24" IconPlacement="Left"/>
                    <ui:TextBox x:Name="TxtCantidad" Grid.Column="1" PlaceholderText="Cant."
                                FontSize="15" Height="40" Text="1" Margin="0,0,8,0" TextAlignment="Center"/>
                    <ui:Button x:Name="BtnAgregarManual" Grid.Column="2" Content="Agregar" Height="40" Padding="18,0"
                               FontWeight="SemiBold" Click="BtnAgregarManual_Click"/>
                </Grid>

                <!-- Utility Buttons -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,24,0">
                    <ui:Button x:Name="BtnNuevaVenta" Height="40" Padding="12,0" Margin="0,0,8,0"
                               Background="#2A2A2A" Foreground="#E0E0E0" BorderBrush="Transparent" Click="BtnNuevaVenta_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="F9" Foreground="#40C060" FontSize="11" FontWeight="Bold" Opacity="0.7" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Nueva" FontSize="14" FontWeight="Medium" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ui:Button>
                    <Button x:Name="BtnCierreZ" Content="Z" Height="40" Width="40" Margin="0,0,8,0" ToolTip="Cierre de Caja (Zeta)"
                            Background="#2A1A1A" Foreground="#FF7070" BorderThickness="0" FontWeight="Bold" FontSize="14"
                            Click="BtnCierreZ_Click"/>
                </StackPanel>

                <!-- Client Info -->
                <Border Grid.Column="2" Background="#1E1E1E" CornerRadius="8" Padding="12,6" VerticalAlignment="Center" Margin="0,0,16,0" BorderBrush="#2A2A2A" BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="CLIENTE" Foreground="#808080" FontSize="9" FontWeight="Bold"/>
                        <TextBlock x:Name="TxtClienteActual" Grid.Row="1" Text="Consumidor Final" Foreground="#F0F0F0" FontSize="13" FontWeight="Bold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="150"/>
                    </Grid>
                </Border>

                <!-- Profile (No notification bell) -->
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}" Background="Transparent" BorderThickness="0" Padding="8" Margin="0,0,8,0" Click="BtnCambiarCliente_Click" ToolTip="Cambiar Cliente">
                        <ui:SymbolIcon Symbol="Person24" Foreground="#808080"/>
                    </Button>
                    <!-- User Avatar -->
                    <Border Width="38" Height="38" CornerRadius="19" Background="#2A2A2A" BorderBrush="#2A2A2A" BorderThickness="1" ClipToBounds="True">
                        <TextBlock Text="OP" Foreground="#E0E0E0" FontSize="14" FontWeight="Black" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ====== MAIN WORKSPACE: items + keypad (60% / 40%) ====== -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="6*"/>
                <ColumnDefinition x:Name="ColKeypad" Width="4*"/>
            </Grid.ColumnDefinitions>

            <!-- DataGrid de artículos (Diseño Oscuro) -->
            <DataGrid x:Name="DgItems" Grid.Column="0"
                      AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                      SelectionMode="Single" GridLinesVisibility="Horizontal"
                      RowHeight="52" FontSize="18"
                      Background="#141414" Foreground="#E0E0E0"
                      RowBackground="#141414" AlternatingRowBackground="#1E1E1E"
                      HorizontalGridLinesBrush="#2A2A2A" BorderThickness="0">
                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background"     Value="#1A1A1A"/>
                        <Setter Property="Foreground"     Value="#808080"/>
                        <Setter Property="FontWeight"     Value="Bold"/>
                        <Setter Property="FontSize"       Value="13"/>
                        <Setter Property="Padding"        Value="12,0"/>
                        <Setter Property="Height"         Value="44"/>
                        <Setter Property="BorderBrush"    Value="#2A2A2A"/>
                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                        <Setter Property="TextBlock.Foreground" Value="#808080"/>
                        <Setter Property="TextBlock.FontWeight" Value="Bold"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="DataGridColumnHeader">
                                    <Border Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Left"
                                                          VerticalAlignment="Center"
                                                          RecognizesAccessKey="True"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </DataGrid.ColumnHeaderStyle>
                <DataGrid.CellStyle>
                    <Style TargetType="DataGridCell">
                        <Setter Property="Foreground"      Value="#E0E0E0"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Padding"         Value="12,0"/>
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.CellStyle>
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Setter Property="Foreground" Value="#E0E0E0"/>
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#2A2A2A"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                    <Condition Property="IsSelected"  Value="False"/>
                                </MultiTrigger.Conditions>
                                <Setter Property="Background" Value="#1E1E1E"/>
                            </MultiTrigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>
                <DataGrid.Columns>
                    <!-- Código -->
                    <DataGridTextColumn Binding="{Binding CodigoBarras}" Width="135" IsReadOnly="True">
                        <DataGridTextColumn.Header>
                            <TextBlock Text="CÓD. BARRAS" Foreground="#808080" FontWeight="Bold" FontSize="13"/>
                        </DataGridTextColumn.Header>
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="#808080"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="Padding" Value="10,0"/>
                                <Setter Property="FontSize" Value="16"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- Descripción -->
                    <DataGridTextColumn Binding="{Binding Descripcion}" Width="*" IsReadOnly="True">
                        <DataGridTextColumn.Header>
                            <TextBlock Text="DESCRIPCIÓN" Foreground="#808080" FontWeight="Bold" FontSize="13"/>
                        </DataGridTextColumn.Header>
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground"       Value="White"/>
                                <Setter Property="FontWeight"       Value="Bold"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="Padding"          Value="10,0"/>
                                <Setter Property="FontSize"         Value="18"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- Cantidad -->
                    <DataGridTextColumn Width="80">
                        <DataGridTextColumn.Header>
                            <TextBlock Text="CANT." Foreground="#808080" FontWeight="Bold" FontSize="13"/>
                        </DataGridTextColumn.Header>
                        <DataGridTextColumn.Binding>
                            <Binding Path="Cantidad" StringFormat="N2" UpdateSourceTrigger="PropertyChanged"/>
                        </DataGridTextColumn.Binding>
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground"        Value="#40C060"/>
                                <Setter Property="FontWeight"        Value="Bold"/>
                                <Setter Property="HorizontalAlignment" Value="Right"/>
                                <Setter Property="VerticalAlignment"   Value="Center"/>
                                <Setter Property="Padding"             Value="0,0,12,0"/>
                                <Setter Property="FontSize"            Value="17"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- Precio unitario -->
                    <DataGridTextColumn Width="120" IsReadOnly="True">
                        <DataGridTextColumn.Header>
                            <TextBlock Text="P. UNITARIO" Foreground="#808080" FontWeight="Bold" FontSize="13"/>
                        </DataGridTextColumn.Header>
                        <DataGridTextColumn.Binding><Binding Path="PrecioUnitario" StringFormat="$ #,##0.00"/></DataGridTextColumn.Binding>
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground"          Value="White"/>
                                <Setter Property="FontWeight"          Value="Bold"/>
                                <Setter Property="HorizontalAlignment" Value="Right"/>
                                <Setter Property="VerticalAlignment"   Value="Center"/>
                                <Setter Property="Padding"             Value="0,0,12,0"/>
                                <Setter Property="FontSize"            Value="17"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- IVA -->
                    <DataGridTextColumn Binding="{Binding AlicuotaIva, StringFormat=\{0:N1\}%}" Width="65" IsReadOnly="True">
                        <DataGridTextColumn.Header>
                            <TextBlock Text="IVA" Foreground="#808080" FontWeight="Bold" FontSize="13"/>
                        </DataGridTextColumn.Header>
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground"          Value="#808080"/>
                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                <Setter Property="VerticalAlignment"   Value="Center"/>
                                <Setter Property="FontSize"            Value="15"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- Subtotal -->
                    <DataGridTextColumn Width="130" IsReadOnly="True">
                        <DataGridTextColumn.Header>
                            <TextBlock Text="SUBTOTAL" Foreground="#808080" FontWeight="Bold" FontSize="13"/>
                        </DataGridTextColumn.Header>
                        <DataGridTextColumn.Binding><Binding Path="SubTotal" StringFormat="$ #,##0.00"/></DataGridTextColumn.Binding>
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground"          Value="#40C060"/>
                                <Setter Property="FontWeight"          Value="Bold"/>
                                <Setter Property="HorizontalAlignment" Value="Right"/>
                                <Setter Property="VerticalAlignment"   Value="Center"/>
                                <Setter Property="Padding"             Value="0,0,12,0"/>
                                <Setter Property="FontSize"            Value="20"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- Eliminar -->
                    <DataGridTemplateColumn Header="" Width="46">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="✕" Width="32" Height="28"
                                        Foreground="#FF7070" Background="Transparent" BorderThickness="0"
                                        FontSize="14" FontWeight="Bold"
                                        Tag="{Binding}" Click="BtnQuitarItem_Click"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>

            <!-- Column de Keypad (40% de ancho) -->
            <Border Grid.Column="1" Background="#141414" BorderThickness="1,0,0,0" BorderBrush="#2A2A2A">
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Title & Caja Info -->
                        <RowDefinition Height="*"/>    <!-- Canvas para Teclado Dinámico -->
                        <RowDefinition Height="Auto"/> <!-- Accesos Rápidos adicionales -->
                    </Grid.RowDefinitions>

                    <!-- Header de Panel de Control -->
                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ui:Button x:Name="BtnVolverPanel" Content="◀ Menú" Grid.Column="0" Padding="10,5"
                                   Background="#2A2A2A" Foreground="#E0E0E0" BorderThickness="0"
                                   Click="BtnVolverPanel_Click" Margin="0,0,8,0" Visibility="Collapsed"/>
                        <TextBlock x:Name="TxtPanelTitulo" Grid.Column="1" Text="Panel de Control" Foreground="#F0F0F0"
                                   FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <Border Grid.Column="2" Background="#1E1E1E" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                            <TextBlock Text="Terminal 01" FontSize="10" Foreground="#808080" FontWeight="Bold"/>
                        </Border>
                    </Grid>

                    <!-- Viewbox para escalar el Canvas dinámicamente -->
                    <Viewbox Grid.Row="1" Stretch="Uniform" VerticalAlignment="Top" HorizontalAlignment="Stretch"
                             UseLayoutRounding="True" SnapsToDevicePixels="True">
                        <Canvas x:Name="CanvasKeypad" Background="#141414"/>
                    </Viewbox>

                    <!-- Accesos Rápidos -->
                    <Grid Grid.Row="2" Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <!-- Descuento y Anular -->
                        <ui:Button Grid.Column="0" Height="48" Background="#2A2A2A" BorderBrush="#2A2A2A" Foreground="#E0E0E0" Click="BtnCambiarCliente_Click" HorizontalAlignment="Stretch">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <ui:SymbolIcon Symbol="ChevronDown24" Margin="0,0,8,0"/>
                                <TextBlock Text="Descuento" FontSize="13" FontWeight="SemiBold"/>
                            </StackPanel>
                        </ui:Button>
                        <ui:Button Grid.Column="2" Height="48" Background="#2A1A1A" BorderBrush="#5A2A2A" Foreground="#FF7070" Click="BtnNuevaVenta_Click" HorizontalAlignment="Stretch">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <ui:SymbolIcon Symbol="Delete24" Margin="0,0,8,0"/>
                                <TextBlock Text="Limpiar Todo" FontSize="13" FontWeight="SemiBold"/>
                            </StackPanel>
                        </ui:Button>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- ====== PANEL INFERIOR: totales + cobros ====== -->
        <Border Grid.Row="2" Background="#1A1A1A" BorderThickness="0,1,0,0" BorderBrush="#2A2A2A">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="6*"/>
                    <ColumnDefinition Width="4*"/>
                </Grid.ColumnDefinitions>

                <!-- Totales (Izquierda) -->
                <Grid Grid.Column="0" Margin="24,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <Grid Margin="0,2">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Text="Subtotal sin IVA:" Foreground="#808080" FontSize="13"/>
                            <TextBlock x:Name="TxtSubtotalSinIva" Grid.Column="1" Text="$ 0.00" Foreground="#F0F0F0" FontSize="13" FontWeight="Medium"/>
                        </Grid>
                        <Grid Margin="0,2">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Text="IVA 21%:" Foreground="#808080" FontSize="13"/>
                            <TextBlock x:Name="TxtIva21" Grid.Column="1" Text="$ 0.00" Foreground="#F0F0F0" FontSize="13" FontWeight="Medium"/>
                        </Grid>
                        <Grid Margin="0,2">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Text="IVA 10.5%:" Foreground="#808080" FontSize="13"/>
                            <TextBlock x:Name="TxtIva105" Grid.Column="1" Text="$ 0.00" Foreground="#F0F0F0" FontSize="13" FontWeight="Medium"/>
                        </Grid>
                    </StackPanel>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,12,0">
                        <TextBlock Text="TOTAL A PAGAR" Foreground="#808080" FontSize="11" FontWeight="Bold" HorizontalAlignment="Right" Margin="0,0,0,2"/>
                        <TextBlock x:Name="TxtTotal" Text="$ 0.00" Foreground="#40C060" FontSize="44" FontWeight="Black" LineHeight="44" HorizontalAlignment="Right"/>
                    </StackPanel>
                </Grid>

                <!-- Cobros (Derecha) -->
                <Border Grid.Column="1" Background="#141414" Padding="16" BorderThickness="1,0,0,0" BorderBrush="#2A2A2A">
                    <StackPanel>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="MEDIO DE PAGO" Foreground="#808080" FontSize="10" FontWeight="Bold" Margin="0,0,0,4"/>
                                <ComboBox x:Name="CmbMedioPago" DisplayMemberPath="Nombre" SelectedValuePath="Id"
                                          Height="42" FontSize="14" Foreground="#F0F0F0" Background="#2A2A2A"
                                          BorderBrush="#2A2A2A" BorderThickness="1"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="MONTO RECIBIDO" Foreground="#808080" FontSize="10" FontWeight="Bold" Margin="0,0,0,4"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="$" Foreground="#808080" FontSize="15" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <ui:TextBox x:Name="TxtMontoRecibido" Grid.Column="1" PlaceholderText="0.00" Height="42"
                                                FontSize="15" FontWeight="Bold" TextChanged="TxtMontoRecibido_TextChanged"/>
                                </Grid>
                            </StackPanel>
                        </Grid>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="VUELTO" Foreground="#808080" FontSize="10" FontWeight="Bold" Margin="0,0,0,2"/>
                                <TextBlock x:Name="TxtVuelto" Foreground="#40C060" FontSize="24" FontWeight="Black" Text="$ 0.00"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="COMPROBANTE" Foreground="#808080" FontSize="10" FontWeight="Bold" Margin="0,0,0,4"/>
                                <ComboBox x:Name="CmbTipoComprobante" DisplayMemberPath="Abreviatura" SelectedValuePath="Id"
                                          Height="42" FontSize="14" Foreground="#F0F0F0" Background="#2A2A2A"
                                          BorderBrush="#2A2A2A" BorderThickness="1"/>
                            </StackPanel>
                        </Grid>
                        <!-- Botones de Cobro -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <!-- Botón Dividir Pago -->
                            <Button x:Name="BtnDividirPago" Grid.Column="0" Height="54" HorizontalAlignment="Stretch"
                                    Background="#2A2A2A" Foreground="#E0E0E0" BorderBrush="#2A2A2A" BorderThickness="1"
                                    Click="BtnDividirPago_Click" Cursor="Hand">
                                <Grid HorizontalAlignment="Stretch">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <ui:SymbolIcon Grid.Column="0" Symbol="Wallet24" Foreground="#E0E0E0" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                    <TextBlock Grid.Column="1" Text="DIVIDIR PAGO" FontSize="13" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                            </Button>
                            <!-- Botón COBRAR (F12) -->
                            <Button x:Name="BtnCobrar" Grid.Column="2" Height="54" HorizontalAlignment="Stretch"
                                    Background="#1A3A2A" Foreground="#64C880" BorderBrush="#2A5A3A" BorderThickness="1"
                                    Click="BtnCobrar_Click" Cursor="Hand">
                                <Grid HorizontalAlignment="Stretch">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Background="#0A2010" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                        <TextBlock Text="F12" FontSize="11" FontWeight="Bold" Foreground="#64C880"/>
                                    </Border>
                                    <TextBlock Grid.Column="1" Text="COBRAR AHORA" FontSize="13" FontWeight="Black" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <ui:SymbolIcon Grid.Column="2" Symbol="ChevronRight24" Foreground="#64C880" VerticalAlignment="Center"/>
                                </Grid>
                            </Button>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- ====== FOOTER: Status Bar (32px) ====== -->
        <Border Grid.Row="3" Background="#141414" BorderThickness="0,1,0,0" BorderBrush="#2A2A2A" Padding="24,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="8" Height="8" Fill="#40C060" Margin="0,0,8,0">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Style.Triggers>
                                    <EventTrigger RoutedEvent="Loaded">
                                        <BeginStoryboard>
                                            <Storyboard RepeatBehavior="Forever">
                                                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.4" To="1.0" Duration="0:0:1" AutoReverse="True"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock Text="SISTEMA EN LÍNEA" FontSize="10" FontWeight="Bold" Foreground="#808080" VerticalAlignment="Center"/>
                    <Border Width="1" Height="12" Background="#2A2A2A" Margin="12,0"/>
                    <TextBlock Text="SINCRONIZACIÓN: HACE 2M" FontSize="10" FontWeight="Bold" Foreground="#808080" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock Grid.Column="1" Text="SESIÓN INICIADA" FontSize="10" FontWeight="Bold" Foreground="#808080" VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Page>
