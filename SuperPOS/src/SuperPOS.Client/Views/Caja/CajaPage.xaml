<Page x:Class="SuperPOS.Client.Views.Caja.CajaPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="Caja" Background="#1C1C1C">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ====== HEADER: búsqueda + cliente + botón nueva venta ====== -->
        <Border Grid.Row="0" Background="#222222" Padding="12,10" BorderThickness="0,0,0,1" BorderBrush="#3A3A3A">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Búsqueda de artículo -->
                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                    <TextBlock Text="CÓDIGO / DESCRIPCIÓN" Foreground="#7090C0" FontSize="10" FontWeight="Bold"
                                Margin="0,0,0,3"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ui:TextBox x:Name="TxtBuscarArticulo" Grid.Column="0"
                                    PlaceholderText="Escanear código de barras o buscar artículo..."
                                    FontSize="16" Height="38" Margin="0,0,6,0"
                                    KeyDown="TxtBuscarArticulo_KeyDown"/>
                        <ui:TextBox x:Name="TxtCantidad" Grid.Column="1" PlaceholderText="Cant."
                                    FontSize="15" Height="38" Text="1" Margin="0,0,6,0" TextAlignment="Center"/>
                        <ui:Button Grid.Column="2" Content="Agregar" Height="38" Padding="14,0"
                                   Click="BtnAgregarManual_Click"/>
                    </Grid>
                </StackPanel>

                <!-- Cliente actual -->
                <Border Grid.Column="1" Background="#252535" CornerRadius="6" Padding="10,6" Margin="0,0,10,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Text="CLIENTE" Foreground="#7090C0"
                                   FontSize="10" FontWeight="Bold" />
                        <TextBlock x:Name="TxtClienteActual" Grid.Row="1" Grid.Column="0"
                                   Text="Consumidor Final" Foreground="#F0F0F0" FontSize="13"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                        <Button Grid.Row="1" Grid.Column="1" Content="▼" Width="26" Height="24"
                                Foreground="#A0A0A0" Background="Transparent" BorderThickness="0"
                                Click="BtnCambiarCliente_Click"/>
                    </Grid>
                </Border>

                        <!-- Nueva Venta + Cierre Z -->
                        <StackPanel Grid.Column="2" VerticalAlignment="Bottom" Orientation="Horizontal">
                            <ui:Button x:Name="BtnNuevaVenta" Content="F9  Nueva" Height="38" Padding="14,0"
                                       Foreground="#F0F0F0" Click="BtnNuevaVenta_Click" Margin="0,0,6,0"/>
                            <Button Content="Z" Height="38" Width="38" ToolTip="Cierre de Caja (Zeta)"
                                    Background="#1A1200" Foreground="#FFB040" BorderThickness="1" BorderBrush="#4A3010"
                                    FontWeight="Bold" FontSize="14"
                                    Click="BtnCierreZ_Click"/>
                        </StackPanel>
            </Grid>
        </Border>

        <!-- ====== GRILLA DE ÍTEMS + TECLADO DINÁMICO ====== -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition x:Name="ColKeypad" Width="400"/>
            </Grid.ColumnDefinitions>

            <DataGrid x:Name="DgItems" Grid.Column="0"
                      AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                      SelectionMode="Single" GridLinesVisibility="Horizontal"
                      RowHeight="40" FontSize="14"
                      Background="#1C1C1C" Foreground="#F0F0F0"
                      RowBackground="#252525" AlternatingRowBackground="#222222"
                      HorizontalGridLinesBrush="#333333" BorderThickness="0">
                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background"     Value="#222222"/>
                        <Setter Property="Foreground"     Value="#8AADDF"/>
                        <Setter Property="FontWeight"     Value="Bold"/>
                        <Setter Property="FontSize"       Value="13"/>
                        <Setter Property="Padding"        Value="10,0"/>
                        <Setter Property="Height"         Value="38"/>
                        <Setter Property="BorderBrush"    Value="#333333"/>
                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                    </Style>
                </DataGrid.ColumnHeaderStyle>
                <DataGrid.CellStyle>
                    <Style TargetType="DataGridCell">
                        <Setter Property="Foreground"      Value="#F0F0F0"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Padding"         Value="8,0"/>
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.CellStyle>
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Setter Property="Foreground" Value="#F0F0F0"/>
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#0A3D6B"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                    <Condition Property="IsSelected"  Value="False"/>
                                </MultiTrigger.Conditions>
                                <Setter Property="Background" Value="#2E2E3A"/>
                            </MultiTrigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>
                <DataGrid.Columns>
                    <!-- Código -->
                    <DataGridTextColumn Header="CÓD. BARRAS" Binding="{Binding CodigoBarras}" Width="130" IsReadOnly="True">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="#A0B8D0"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="Padding" Value="10,0"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
    
                    <!-- Descripción -->
                    <DataGridTextColumn Header="DESCRIPCIÓN" Binding="{Binding Descripcion}" Width="*" IsReadOnly="True">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground"       Value="#F0F0F0"/>
                                <Setter Property="FontWeight"       Value="SemiBold"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="Padding"          Value="10,0"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
    
                    <!-- Cantidad -->
                    <DataGridTextColumn Header="CANT." Width="80">
                        <DataGridTextColumn.Binding>
                            <Binding Path="Cantidad" StringFormat="N2" UpdateSourceTrigger="PropertyChanged"/>
                        </DataGridTextColumn.Binding>
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground"        Value="#F0F0F0"/>
                                <Setter Property="HorizontalAlignment" Value="Right"/>
                                <Setter Property="VerticalAlignment"   Value="Center"/>
                                <Setter Property="Padding"             Value="0,0,12,0"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
    
                    <!-- Precio unitario -->
                    <DataGridTextColumn Header="P. UNITARIO" Width="120" IsReadOnly="True">
                        <DataGridTextColumn.Binding><Binding Path="PrecioUnitario" StringFormat="$ #,##0.00"/></DataGridTextColumn.Binding>
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground"          Value="#80D4A0"/>
                                <Setter Property="HorizontalAlignment" Value="Right"/>
                                <Setter Property="VerticalAlignment"   Value="Center"/>
                                <Setter Property="Padding"             Value="0,0,12,0"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
    
                    <!-- IVA -->
                    <DataGridTextColumn Header="IVA" Binding="{Binding AlicuotaIva, StringFormat=\{0:N1\}%}" Width="65" IsReadOnly="True">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground"          Value="#808080"/>
                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                <Setter Property="VerticalAlignment"   Value="Center"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
    
                    <!-- Subtotal -->
                    <DataGridTextColumn Header="SUBTOTAL" Width="130" IsReadOnly="True">
                        <DataGridTextColumn.Binding><Binding Path="SubTotal" StringFormat="$ #,##0.00"/></DataGridTextColumn.Binding>
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground"          Value="#FFD060"/>
                                <Setter Property="FontWeight"          Value="Bold"/>
                                <Setter Property="HorizontalAlignment" Value="Right"/>
                                <Setter Property="VerticalAlignment"   Value="Center"/>
                                <Setter Property="Padding"             Value="0,0,12,0"/>
                                <Setter Property="FontSize"            Value="15"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
    
                    <!-- Eliminar -->
                    <DataGridTemplateColumn Header="" Width="46">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="✕" Width="32" Height="28"
                                        Foreground="#FF6060" Background="Transparent" BorderThickness="0"
                                        FontSize="14" FontWeight="Bold"
                                        Tag="{Binding}" Click="BtnQuitarItem_Click"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>

            <!-- Panel Teclado Dinámico -->
            <Border Grid.Column="1" Background="#20202F" BorderThickness="1,0,0,0" BorderBrush="#33334A">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Cabecera del teclado -->
                        <RowDefinition Height="*"/>    <!-- Canvas del teclado -->
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="#28283E" Padding="10,8" BorderThickness="0,0,0,1" BorderBrush="#33334A">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <ui:Button x:Name="BtnVolverPanel" Content="◀ Menú" Grid.Column="0" Padding="8,4"
                                       Click="BtnVolverPanel_Click" Margin="0,0,10,0" Visibility="Collapsed"/>
                            <TextBlock x:Name="TxtPanelTitulo" Grid.Column="1" Text="Teclado Rápido" Foreground="#FFC107"
                                       FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- Viewbox para escalar el Canvas dinámicamente -->
                    <Viewbox Grid.Row="1" Stretch="Uniform" Margin="8" VerticalAlignment="Top" HorizontalAlignment="Center">
                        <Canvas x:Name="CanvasKeypad" Width="400" Height="400" Background="#141420"/>
                    </Viewbox>
                </Grid>
            </Border>
        </Grid>

        <!-- ====== PANEL INFERIOR: TOTALES + COBRO ====== -->
        <Grid Grid.Row="2" Background="#161626">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="380"/>
            </Grid.ColumnDefinitions>

            <!-- TOTALES (izquierda) -->
            <StackPanel Grid.Column="0" Margin="20,12" VerticalAlignment="Center">
                <Grid Margin="0,1">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <TextBlock Text="Subtotal sin IVA:" Foreground="#707080" FontSize="12"/>
                    <TextBlock x:Name="TxtSubtotalSinIva" Grid.Column="1" Foreground="#909090" FontSize="12"/>
                </Grid>
                <Grid Margin="0,1">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <TextBlock Text="IVA 21%:" Foreground="#707080" FontSize="12"/>
                    <TextBlock x:Name="TxtIva21" Grid.Column="1" Foreground="#909090" FontSize="12"/>
                </Grid>
                <Grid Margin="0,1">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <TextBlock Text="IVA 10.5%:" Foreground="#707080" FontSize="12"/>
                    <TextBlock x:Name="TxtIva105" Grid.Column="1" Foreground="#909090" FontSize="12"/>
                </Grid>
                <!-- TOTAL GRANDE -->
                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <TextBlock Text="TOTAL A PAGAR" Foreground="#A0C0FF" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TxtTotal" Grid.Column="1" Foreground="#FFD060" FontSize="40"
                               FontWeight="Bold" />
                </Grid>
            </StackPanel>

            <!-- COBRO (derecha) -->
            <Border Grid.Column="1" Background="#1E1E30" Padding="14,10" Margin="0,6,12,6" CornerRadius="10">
                <StackPanel>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="MEDIO DE PAGO" Foreground="#709090" FontSize="10" FontWeight="Bold" Margin="0,0,0,4"/>
                            <ComboBox x:Name="CmbMedioPago" DisplayMemberPath="Nombre" SelectedValuePath="Id"
                                      Height="34" FontSize="13" Foreground="#F0F0F0" Background="#2A2A2A"
                                      BorderBrush="#3A3A3A" BorderThickness="1"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="MONTO RECIBIDO" Foreground="#709090" FontSize="10" FontWeight="Bold" Margin="0,0,0,4"/>
                            <ui:TextBox x:Name="TxtMontoRecibido" PlaceholderText="$ 0.00" Height="34"
                                        FontSize="16" FontWeight="Bold" TextChanged="TxtMontoRecibido_TextChanged"/>
                        </StackPanel>
                    </Grid>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="VUELTO" Foreground="#709090" FontSize="10" FontWeight="Bold"/>
                            <TextBlock x:Name="TxtVuelto" Foreground="#40D080" FontSize="22" FontWeight="Bold" Text="$ 0.00"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="COMPROBANTE" Foreground="#709090" FontSize="10" FontWeight="Bold" Margin="0,0,0,4"/>
                            <ComboBox x:Name="CmbTipoComprobante" DisplayMemberPath="Abreviatura" SelectedValuePath="Id"
                                      Height="34" FontSize="13" Foreground="#F0F0F0" Background="#2A2A2A"
                                      BorderBrush="#3A3A3A" BorderThickness="1"/>
                        </StackPanel>
                    </Grid>
                    <!-- Botón COBRAR - oscuro con acento verde -->
                    <Button x:Name="BtnCobrar" Content="F12  COBRAR"
                            HorizontalAlignment="Stretch" Height="52" FontSize="22" FontWeight="Bold"
                            Background="#1A4A2A" Foreground="#40FF80" BorderBrush="#2A6A3A" BorderThickness="1"
                            Click="BtnCobrar_Click"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Page>
