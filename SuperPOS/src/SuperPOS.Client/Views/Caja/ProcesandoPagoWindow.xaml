<ui:FluentWindow x:Class="SuperPOS.Client.Views.Caja.ProcesandoPagoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Procesando Pago Integrado"
        Width="440" Height="340"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ExtendsContentIntoTitleBar="True"
        Background="#181818">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="TxtTitulo" Text="💳 Elegí la tarjeta" FontSize="16" FontWeight="SemiBold" Foreground="#FFC107" HorizontalAlignment="Center"/>

        <!-- Paso 1: selector de marca (slider de tarjetas) -->
        <StackPanel x:Name="PanelSeleccion" Grid.Row="1" VerticalAlignment="Center" Margin="0,10">
            <TextBlock x:Name="TxtMontoSeleccion" Text="Monto: $ 0.00" FontSize="15" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center" Margin="0,0,0,14"/>
            <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="180">
                <ItemsControl x:Name="IcTarjetas">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Content="{Binding Nombre}" Width="160" Height="46" Margin="5"
                                    FontSize="13" FontWeight="SemiBold"
                                    Background="#252525" Foreground="#F0F0F0" BorderBrush="#3A3A3A"
                                    Click="BtnTarjeta_Click" Tag="{Binding}"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </StackPanel>

        <!-- Paso 2: procesando en el terminal -->
        <StackPanel x:Name="PanelProcesando" Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,15" Visibility="Collapsed">
            <ui:ProgressRing x:Name="Spinner" IsIndeterminate="True" Width="40" Height="40" Margin="0,0,0,14" Foreground="#FFC107"/>
            <TextBlock x:Name="TxtMonto" Text="Monto: $ 0.00" FontSize="15" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center" Margin="0,0,0,8"/>
            <TextBlock x:Name="TxtEstado" Text="Iniciando comunicación con el terminal..." FontSize="12" Foreground="#A0A0A0" TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center"/>
        </StackPanel>

        <Button Grid.Row="2" x:Name="BtnCancelar" Content="Cancelar" HorizontalAlignment="Center" Width="180" Height="36" Click="BtnCancelar_Click"/>
    </Grid>
</ui:FluentWindow>
