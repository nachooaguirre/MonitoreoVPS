<Window x:Class="SuperPOS.Client.Views.Caja.DividirPagoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Dividir Cobros — SuperPOS"
        Width="860" Height="580"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="#141414">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Header -->
            <RowDefinition Height="Auto"/> <!-- KPI Cards -->
            <RowDefinition Height="*"/>    <!-- Workspace (Add Form & List) -->
            <RowDefinition Height="Auto"/> <!-- Footer Actions -->
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#1A1A1A" CornerRadius="10" Padding="16,10" Margin="0,0,0,16" BorderBrush="#2A2A2A" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="💳" FontSize="26" Margin="0,0,12,0" VerticalAlignment="Center"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="DIVIDIR COBROS DE VENTA" FontSize="16" FontWeight="Black" Foreground="#64C880"/>
                        <TextBlock Text="Cobro parcial utilizando múltiples métodos de pago" FontSize="11" Foreground="#808080"/>
                    </StackPanel>
                </StackPanel>
                <Border Grid.Column="1" Background="#1E1E1E" CornerRadius="6" Padding="10,4" VerticalAlignment="Center">
                    <TextBlock Text="MÚLTIPLES MEDIOS" FontSize="10" Foreground="#F0F0F0" FontWeight="Bold"/>
                </Border>
            </Grid>
        </Border>

        <!-- KPI Cards -->
        <Grid Grid.Row="1" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Total Venta -->
            <Border Background="#1E1E1E" CornerRadius="10" Padding="16,12" Margin="0,0,8,0" BorderBrush="#2A2A2A" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="TOTAL DE LA VENTA" FontSize="10" FontWeight="Bold" Foreground="#808080" Margin="0,0,0,4"/>
                    <TextBlock x:Name="TxtTotalVenta" FontSize="24" FontWeight="Black" Foreground="#F0F0F0" Text="$ 0.00"/>
                </StackPanel>
            </Border>

            <!-- Total Cubierto -->
            <Border Grid.Column="1" Background="#1A3A2A" CornerRadius="10" Padding="16,12" Margin="8,0" BorderBrush="#2A5A3A" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="TOTAL CUBIERTO" FontSize="10" FontWeight="Bold" Foreground="#64C880" Margin="0,0,0,4"/>
                    <TextBlock x:Name="TxtTotalCubierto" FontSize="24" FontWeight="Black" Foreground="#64C880" Text="$ 0.00"/>
                </StackPanel>
            </Border>

            <!-- Restante / Vuelto -->
            <Border Grid.Column="2" x:Name="BrdRestanteVuelto" Background="#2A1A1A" CornerRadius="10" Padding="16,12" Margin="8,0,0,0" BorderBrush="#5A2A2A" BorderThickness="1">
                <StackPanel>
                    <TextBlock x:Name="LblRestanteVuelto" Text="SALDO RESTANTE" FontSize="10" FontWeight="Bold" Foreground="#FF7070" Margin="0,0,0,4"/>
                    <TextBlock x:Name="TxtRestanteVuelto" FontSize="24" FontWeight="Black" Foreground="#FF7070" Text="$ 0.00"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Workspace -->
        <Grid Grid.Row="2" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="4*"/> <!-- Left Form -->
                <ColumnDefinition Width="16"/>  <!-- Spacer -->
                <ColumnDefinition Width="6*"/> <!-- Right List -->
            </Grid.ColumnDefinitions>

            <!-- Left Form (Add Payment) -->
            <Border Grid.Column="0" Background="#1E1E1E" CornerRadius="10" Padding="16" BorderBrush="#2A2A2A" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Title -->
                        <RowDefinition Height="*"/>    <!-- Controls -->
                        <RowDefinition Height="Auto"/> <!-- Add Button -->
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="AGREGAR PARTE DE PAGO" FontSize="11" FontWeight="Bold" Foreground="#808080" Margin="0,0,0,16"/>

                    <StackPanel Grid.Row="1" VerticalAlignment="Top">
                        <!-- Medio de Pago -->
                        <TextBlock Text="MEDIO DE PAGO" Foreground="#808080" FontSize="10" FontWeight="Bold" Margin="0,0,0,6"/>
                        <ComboBox x:Name="CmbMedio" DisplayMemberPath="Nombre" SelectedValuePath="Id"
                                  Height="40" FontSize="14" Foreground="#F0F0F0" Background="#2A2A2A"
                                  BorderBrush="#2A2A2A" BorderThickness="1" Margin="0,0,0,16"
                                  SelectionChanged="CmbMedio_SelectionChanged"/>

                        <!-- Monto -->
                        <TextBlock Text="MONTO A COBRAR" Foreground="#808080" FontSize="10" FontWeight="Bold" Margin="0,0,0,6"/>
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="$" Foreground="#808080" FontSize="16" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <ui:TextBox x:Name="TxtMonto" Grid.Column="1" PlaceholderText="0.00" Height="40" FontSize="16" FontWeight="Bold"/>
                        </Grid>

                        <!-- Referencia Manual -->
                        <TextBlock x:Name="LblReferencia" Text="REFERENCIA (OPCIONAL)" Foreground="#808080" FontSize="10" FontWeight="Bold" Margin="0,0,0,6"/>
                        <ui:TextBox x:Name="TxtReferencia" PlaceholderText="Ej: Transf. Nro 12345" Height="40" FontSize="14" Margin="0,0,0,16"/>
                    </StackPanel>

                    <!-- Botón Agregar -->
                    <Button Grid.Row="2" x:Name="BtnAgregarPago" Content="Agregar Pago" Height="46" HorizontalAlignment="Stretch"
                            Background="#1A3A2A" Foreground="#64C880" BorderBrush="#2A5A3A" BorderThickness="1" FontSize="14" FontWeight="Bold"
                            Click="BtnAgregarPago_Click" Cursor="Hand"/>
                </Grid>
            </Border>

            <!-- Right List (Added Payments) -->
            <Border Grid.Column="2" Background="#1E1E1E" CornerRadius="10" Padding="16" BorderBrush="#2A2A2A" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Title -->
                        <RowDefinition Height="*"/>    <!-- DataGrid -->
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="DESGLOSE DE PAGOS INGRESADOS" FontSize="11" FontWeight="Bold" Foreground="#808080" Margin="0,0,0,12"/>

                    <DataGrid x:Name="DgPagos" Grid.Row="1"
                              AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                              Background="Transparent" RowBackground="#141414" AlternatingRowBackground="#1E1E1E"
                              HorizontalGridLinesBrush="#2A2A2A" BorderThickness="0" Foreground="#E0E0E0"
                              FontSize="14" RowHeight="40" GridLinesVisibility="Horizontal">
                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#1A1A1A"/>
                                <Setter Property="Foreground" Value="#808080"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="FontSize" Value="11"/>
                                <Setter Property="Padding" Value="8,0"/>
                                <Setter Property="Height" Value="34"/>
                                <Setter Property="BorderBrush" Value="#2A2A2A"/>
                                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="DataGridColumnHeader">
                                            <Border Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                    Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>
                        <DataGrid.CellStyle>
                            <Style TargetType="DataGridCell">
                                <Setter Property="Foreground" Value="#E0E0E0"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Padding" Value="8,0"/>
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="Transparent"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.CellStyle>
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Setter Property="Foreground" Value="#E0E0E0"/>
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="#2A2A2A"/>
                                        <Setter Property="Foreground" Value="White"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <!-- Medio -->
                            <DataGridTextColumn Binding="{Binding Medio.Nombre}" Width="150" IsReadOnly="True">
                                <DataGridTextColumn.Header>
                                    <TextBlock Text="MEDIO" Foreground="#808080" FontWeight="Bold" FontSize="11"/>
                                </DataGridTextColumn.Header>
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- Monto Ingresado -->
                            <DataGridTextColumn Binding="{Binding MontoIngresado, StringFormat='$ #,##0.00'}" Width="110" IsReadOnly="True">
                                <DataGridTextColumn.Header>
                                    <TextBlock Text="MONTO" Foreground="#808080" FontWeight="Bold" FontSize="11"/>
                                </DataGridTextColumn.Header>
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="Foreground" Value="White"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- Vuelto (si corresponde) -->
                            <DataGridTextColumn Binding="{Binding Vuelto, StringFormat='$ #,##0.00'}" Width="80" IsReadOnly="True">
                                <DataGridTextColumn.Header>
                                    <TextBlock Text="VUELTO" Foreground="#808080" FontWeight="Bold" FontSize="11"/>
                                </DataGridTextColumn.Header>
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="Foreground" Value="#64C880"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- Referencia -->
                            <DataGridTextColumn Binding="{Binding Referencia}" Width="*" IsReadOnly="True">
                                <DataGridTextColumn.Header>
                                    <TextBlock Text="REFERENCIA" Foreground="#808080" FontWeight="Bold" FontSize="11"/>
                                </DataGridTextColumn.Header>
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="Foreground" Value="#808080"/>
                                        <Setter Property="FontStyle" Value="Italic"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- Acción Eliminar -->
                            <DataGridTemplateColumn Width="46">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="✕" Width="28" Height="24"
                                                Foreground="#FF7070" Background="Transparent" BorderThickness="0"
                                                FontSize="12" FontWeight="Bold"
                                                Tag="{Binding}" Click="BtnQuitarPago_Click"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>

        <!-- Footer Actions -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Cancelar -->
            <Button Grid.Column="0" Content="Cancelar" Height="44" Padding="20,0" FontSize="14"
                    Background="#2A1A1A" Foreground="#FF7070" BorderBrush="#5A2A2A" BorderThickness="1"
                    Click="BtnCancelar_Click" Cursor="Hand"/>

            <!-- Confirmar Cobro -->
            <Button Grid.Column="2" x:Name="BtnConfirmar" Height="44" Padding="24,0" FontSize="14" FontWeight="Bold"
                    Background="#1A3A2A" Foreground="#64C880" BorderBrush="#2A5A3A" BorderThickness="1"
                    Click="BtnConfirmar_Click" Cursor="Hand">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="🔒  CONFIRMAR COBRO" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </Grid>
    </Grid>
</Window>
