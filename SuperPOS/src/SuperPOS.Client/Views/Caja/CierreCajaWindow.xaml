<Window x:Class="SuperPOS.Client.Views.Caja.CierreCajaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Cierre de Caja — Arqueo Z"
        Width="700" Height="620"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#141414">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#222222" CornerRadius="12" Padding="20,14" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🧾" FontSize="28" Margin="0,0,10,0"/>
                        <StackPanel>
                            <TextBlock Text="CIERRE DE CAJA — ZETA" FontSize="18" FontWeight="Bold" Foreground="#60B4FF"/>
                            <TextBlock x:Name="TxtPeriodo" FontSize="11" Foreground="#607080"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
                <Border Grid.Column="1" Background="#1C2030" CornerRadius="8" Padding="16,8">
                    <StackPanel HorizontalAlignment="Right">
                        <TextBlock Text="ZETA Nº" FontSize="10" Foreground="#607080" FontWeight="Bold"/>
                        <TextBlock x:Name="TxtNroZeta" FontSize="28" FontWeight="Bold" Foreground="#60B4FF" HorizontalAlignment="Right"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- KPIs -->
        <Grid Grid.Row="1" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Background="#1C2030" CornerRadius="10" Padding="14,10" Margin="0,0,6,0">
                <StackPanel>
                    <TextBlock Text="TOTAL VENTAS" FontSize="10" FontWeight="Bold" Foreground="#406080"/>
                    <TextBlock x:Name="TxtTotalVentas" FontSize="24" FontWeight="Bold" Foreground="#60B4FF" Text="$ --"/>
                    <TextBlock x:Name="TxtCantVentas" FontSize="11" Foreground="#405060"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="1" Background="#0A1A0A" CornerRadius="10" Padding="14,10" Margin="6,0">
                <StackPanel>
                    <TextBlock Text="DESCUENTOS" FontSize="10" FontWeight="Bold" Foreground="#307050"/>
                    <TextBlock x:Name="TxtDescuentos" FontSize="24" FontWeight="Bold" Foreground="#40D080" Text="$ --"/>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="IVA 21%: " FontSize="10" Foreground="#307050"/>
                        <TextBlock x:Name="TxtIva21" FontSize="10" Foreground="#40D080"/>
                    </StackPanel>
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Background="#1A0A00" CornerRadius="10" Padding="14,10" Margin="6,0,0,0">
                <StackPanel>
                    <TextBlock Text="IVA TOTAL" FontSize="10" FontWeight="Bold" Foreground="#806030"/>
                    <TextBlock x:Name="TxtIvaTotal" FontSize="24" FontWeight="Bold" Foreground="#FFB040" Text="$ --"/>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="IVA 10.5%: " FontSize="10" Foreground="#806030"/>
                        <TextBlock x:Name="TxtIva105" FontSize="10" Foreground="#FFB040"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Detalle por medio de pago -->
        <Border Grid.Row="2" Background="#1E1E1E" CornerRadius="12" Padding="16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="DETALLE POR MEDIO DE PAGO"
                           FontSize="12" FontWeight="Bold" Foreground="#808090" Margin="0,0,0,10"/>
                <ItemsControl x:Name="IcMedios" Grid.Row="1">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#252525" CornerRadius="8" Padding="14,10" Margin="0,3">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="90"/>
                                        <ColumnDefinition Width="130"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Nombre}" Foreground="#D0E0FF" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="{Binding CantOperaciones, StringFormat='{}{0} ops.'}"
                                               Foreground="#607080" FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                    <TextBlock Grid.Column="2" Text="{Binding Total, StringFormat='$ #,##0.00'}"
                                               Foreground="#60D0A0" FontSize="16" FontWeight="Bold"
                                               VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </Border>

        <!-- Efectivo declarado + diferencia -->
        <Border Grid.Row="3" Background="#222222" CornerRadius="10" Padding="16,12" Margin="0,14,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="EFECTIVO EN CAJA (sistema)" FontSize="10" FontWeight="Bold" Foreground="#607080" Margin="0,0,0,4"/>
                    <TextBlock x:Name="TxtEfectivoSistema" FontSize="20" FontWeight="Bold" Foreground="#60B4FF" Text="$ --"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="EFECTIVO DECLARADO (contado)" FontSize="10" FontWeight="Bold" Foreground="#607080" Margin="0,0,0,4"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ui:TextBox x:Name="TxtEfectivoDeclarado" PlaceholderText="$ 0.00"
                                    FontSize="18" FontWeight="Bold" TextChanged="TxtEfectivoDeclarado_TextChanged"/>
                        <Border Grid.Column="1" x:Name="BrdDiferencia" CornerRadius="6" Padding="10,4" Margin="8,0,0,0" Background="#252525">
                            <TextBlock x:Name="TxtDiferencia" FontSize="14" FontWeight="Bold" Text="±0"/>
                        </Border>
                    </Grid>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Botones -->
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button Content="Cancelar" Height="44" FontSize="14"
                    Background="#2A1A1A" Foreground="#FF7070" BorderThickness="1" BorderBrush="#5A2A2A"
                    Click="BtnCancelar_Click"/>
            <ui:Button Grid.Column="2" x:Name="BtnCerrar" Content="🔒  Ejecutar Cierre Z"
                       Appearance="Primary" Height="44" FontSize="15" FontWeight="Bold"
                       Click="BtnCerrar_Click"/>
        </Grid>
    </Grid>
</Window>
