<Page x:Class="SuperPOS.Client.Views.Presupuestos.CotizacionesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="Cotizaciones">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Cotizaciones de Proveedores" FontSize="24" FontWeight="Bold" VerticalAlignment="Center"/>
        </Grid>

        <!-- Filtros -->
        <Grid Grid.Row="1" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition Width="250"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                <TextBlock Text="Desde" FontSize="11" Margin="0,0,0,2" Opacity="0.7"/>
                <DatePicker x:Name="DpDesde" SelectedDateChanged="Filtro_Changed"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Margin="0,0,8,0">
                <TextBlock Text="Hasta" FontSize="11" Margin="0,0,0,2" Opacity="0.7"/>
                <DatePicker x:Name="DpHasta" SelectedDateChanged="Filtro_Changed"/>
            </StackPanel>
            <StackPanel Grid.Column="2" Margin="0,0,8,0">
                <TextBlock Text="Proveedor" FontSize="11" Margin="0,0,0,2" Opacity="0.7"/>
                <ComboBox x:Name="CmbProveedor" DisplayMemberPath="RazonSocial" SelectedValuePath="Id" SelectionChanged="Filtro_Changed"/>
            </StackPanel>
            
            <ui:Button Grid.Column="4" Content="Limpiar Filtros" VerticalAlignment="Bottom" Height="36" Click="BtnLimpiar_Click"/>
        </Grid>

        <!-- Tabla -->
        <DataGrid x:Name="DgCotizaciones" Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="True"
                  SelectionMode="Single" GridLinesVisibility="Horizontal" CanUserResizeRows="False"
                  BorderThickness="1" RowHeight="32" FontSize="13"
                  MouseDoubleClick="DgCotizaciones_MouseDoubleClick">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Número" Binding="{Binding Numero}" Width="80"/>
                <DataGridTextColumn Header="Fecha" Binding="{Binding Fecha, StringFormat={}{0:dd/MM/yyyy}}" Width="120"/>
                <DataGridTextColumn Header="Proveedor" Binding="{Binding Proveedor.RazonSocial}" Width="*"/>
                <DataGridTextColumn Header="Descripción" Binding="{Binding Descripcion}" Width="*"/>
                <DataGridTextColumn Header="Plazo Entrega" Binding="{Binding PlazoEntrega}" Width="150"/>
                <DataGridTemplateColumn Header="Acciones" Width="80">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Button Content="🗑" Width="32" Height="26" ToolTip="Eliminar" Tag="{Binding}" Click="BtnEliminar_Click"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Paginación -->
        <Grid Grid.Row="3" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="TxtTotal" VerticalAlignment="Center" Opacity="0.6"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="◀" x:Name="BtnPrev" Click="BtnPrev_Click" Width="32" Height="28" Margin="4,0"/>
                <TextBlock x:Name="TxtPagina" VerticalAlignment="Center" Margin="4,0"/>
                <Button Content="▶" x:Name="BtnNext" Click="BtnNext_Click" Width="32" Height="28" Margin="4,0"/>
            </StackPanel>
        </Grid>
    </Grid>
</Page>
