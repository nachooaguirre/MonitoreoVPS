<ui:FluentWindow x:Class="SuperPOS.Client.Views.Presupuestos.PresupuestadorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Presupuestador"
        Width="950" Height="700"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        ExtendsContentIntoTitleBar="True">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ui:TitleBar x:Name="TitleBarCtrl" Grid.Row="0" Title="Presupuestador"/>

        <Grid Grid.Row="1" Margin="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Panel Izquierdo: Cabecera/Datos Generales -->
            <StackPanel Grid.Column="0" Margin="0,0,16,0">
                <TextBlock Text="Datos del Presupuesto" FontWeight="Bold" FontSize="15" Margin="0,0,0,12"/>

                <TextBlock Text="Cliente *" Margin="0,0,0,4" FontSize="12"/>
                <ComboBox x:Name="CmbCliente" DisplayMemberPath="RazonSocial" SelectedValuePath="Id" Margin="0,0,0,12"/>

                <TextBlock Text="Contacto" Margin="0,0,0,4" FontSize="12"/>
                <ui:TextBox x:Name="TxtContacto" PlaceholderText="Nombre del contacto" Margin="0,0,0,12"/>

                <TextBlock Text="Detalle del Trabajo *" Margin="0,0,0,4" FontSize="12"/>
                <ui:TextBox x:Name="TxtDetalleTrabajo" PlaceholderText="Ej: Reparación de motor, Pintura..." Margin="0,0,0,12"/>

                <TextBlock Text="Validez (Días) *" Margin="0,0,0,4" FontSize="12"/>
                <ui:TextBox x:Name="TxtValidez" PlaceholderText="30" Text="30" Margin="0,0,0,12"/>

                <TextBlock Text="Forma de Pago" Margin="0,0,0,4" FontSize="12"/>
                <ui:TextBox x:Name="TxtFormaPago" PlaceholderText="Ej: Efectivo, 50% anticipo" Margin="0,0,0,12"/>

                <TextBlock Text="Observaciones" Margin="0,0,0,4" FontSize="12"/>
                <ui:TextBox x:Name="TxtObservaciones" PlaceholderText="Detalles adicionales" Height="80" TextWrapping="Wrap" AcceptsReturn="True" Margin="0,0,0,12"/>
            </StackPanel>

            <!-- Panel Derecho: Artículos/Detalles -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Buscador de Artículos e Ingreso Rápido -->
                <Grid Grid.Row="0" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="90"/>
                        <ColumnDefinition Width="90"/>
                        <ColumnDefinition Width="90"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <StackPanel Grid.Column="0" Margin="0,0,6,0">
                        <TextBlock Text="Buscar Artículo *" FontSize="11" Margin="0,0,0,2" Opacity="0.7"/>
                        <ui:TextBox x:Name="TxtBuscarArticulo" PlaceholderText="Escriba código o descripción..." KeyDown="TxtBuscarArticulo_KeyDown"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="0,0,6,0">
                        <TextBlock Text="Cant. *" FontSize="11" Margin="0,0,0,2" Opacity="0.7"/>
                        <ui:TextBox x:Name="TxtCantidad" Text="1" TextAlignment="Right"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Margin="0,0,6,0">
                        <TextBlock Text="Costo" FontSize="11" Margin="0,0,0,2" Opacity="0.7"/>
                        <ui:TextBox x:Name="TxtCosto" Text="0.00" TextAlignment="Right" TextChanged="MargenOCosto_Changed"/>
                    </StackPanel>

                    <StackPanel Grid.Column="3" Margin="0,0,6,0">
                        <TextBlock Text="Margen %" FontSize="11" Margin="0,0,0,2" Opacity="0.7"/>
                        <ui:TextBox x:Name="TxtMargen" Text="30" TextAlignment="Right" TextChanged="MargenOCosto_Changed"/>
                    </StackPanel>

                    <StackPanel Grid.Column="4" Margin="0,0,6,0">
                        <TextBlock Text="Precio Final" FontSize="11" Margin="0,0,0,2" Opacity="0.7" FontWeight="Bold"/>
                        <ui:TextBox x:Name="TxtPrecioFinal" Text="0.00" TextAlignment="Right" FontWeight="Bold" TextChanged="PrecioFinal_Changed"/>
                    </StackPanel>

                    <ui:Button Grid.Column="5" Content="Agregar" Appearance="Primary" Height="36" VerticalAlignment="Bottom" Click="BtnAgregarItem_Click"/>
                </Grid>

                <!-- Grilla de Ítems Presupuestados -->
                <DataGrid x:Name="DgDetalles" Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                          GridLinesVisibility="Horizontal" RowHeight="32" FontSize="13" BorderThickness="1">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Código" Binding="{Binding Articulo.CodigoBarras}" Width="100" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Descripción" Binding="{Binding Descripcion}" Width="*" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Cant." Binding="{Binding Cantidad, StringFormat=N2}" Width="70" IsReadOnly="True">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock"><Setter Property="HorizontalAlignment" Value="Right"/></Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Costo" Binding="{Binding Costo, StringFormat=N2}" Width="90" IsReadOnly="True">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock"><Setter Property="HorizontalAlignment" Value="Right"/></Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Margen %" Binding="{Binding Margen, StringFormat=N2}" Width="80" IsReadOnly="True">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock"><Setter Property="HorizontalAlignment" Value="Right"/></Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Precio" Binding="{Binding Precio, StringFormat=N2}" Width="90" IsReadOnly="True">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock"><Setter Property="HorizontalAlignment" Value="Right"/><Setter Property="FontWeight" Value="Bold"/></Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Subtotal" Width="90" IsReadOnly="True">
                            <DataGridTextColumn.Binding>
                                <Binding Path="SubtotalCalculado" StringFormat="C2"/>
                            </DataGridTextColumn.Binding>
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock"><Setter Property="HorizontalAlignment" Value="Right"/><Setter Property="FontWeight" Value="Bold"/></Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTemplateColumn Header="Acciones" Width="70">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="🗑" Width="30" Height="24" ToolTip="Quitar ítem" Tag="{Binding}" Click="BtnQuitarItem_Click"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Resumen de Totales -->
                <Grid Grid.Row="2" Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                        <StackPanel Margin="0,0,24,0" VerticalAlignment="Center">
                            <TextBlock Text="SUBTOTAL" FontSize="11" Opacity="0.6" HorizontalAlignment="Right"/>
                            <TextBlock x:Name="TxtSubtotalSum" Text="$0.00" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                        </StackPanel>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="TOTAL FINAL" FontSize="11" Opacity="0.6" HorizontalAlignment="Right"/>
                            <TextBlock x:Name="TxtTotalSum" Text="$0.00" FontSize="20" FontWeight="Bold" Foreground="#107C41" HorizontalAlignment="Right"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>

        <!-- Botones de Acción de Ventana -->
        <Grid Grid.Row="2" Margin="16,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="Cancelar" Width="100" Height="36" Margin="0,0,8,0" Click="BtnCancelar_Click"/>
                <ui:Button x:Name="BtnGuardar" Content="Guardar Presupuesto" Appearance="Primary" Width="180" Height="36" Click="BtnGuardar_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</ui:FluentWindow>
