<ui:FluentWindow x:Class="SuperPOS.Client.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="SuperPOS"
        Width="460" Height="560"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        ExtendsContentIntoTitleBar="True">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <ui:TitleBar Grid.Row="0" Title="SuperPOS"/>
        <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="60,0">
            <!-- Logo: se muestra si existe Assets/logo.png, sino muestra ícono -->
            <Image x:Name="ImgLogo" MaxHeight="120" MaxWidth="280" Margin="0,0,0,12"
                   HorizontalAlignment="Center" Stretch="Uniform"
                   RenderOptions.BitmapScalingMode="HighQuality"/>
            <TextBlock x:Name="TxtNombreEmpresa" Text="SuperPOS" FontSize="30" FontWeight="Bold"
                       HorizontalAlignment="Center" Margin="0,0,0,4"/>
            <TextBlock Text="Sistema de Punto de Venta" FontSize="13" HorizontalAlignment="Center"
                       Opacity="0.6" Margin="0,0,0,32"/>
            <ui:TextBox x:Name="TxtUsuario" PlaceholderText="Usuario" Margin="0,0,0,10"
                        FontSize="15" KeyDown="TxtUsuario_KeyDown"/>
            <ui:PasswordBox x:Name="TxtPassword" PlaceholderText="Contraseña" Margin="0,0,0,8"
                            FontSize="15" KeyDown="TxtPassword_KeyDown"/>
            <TextBlock x:Name="TxtError" Foreground="Red" HorizontalAlignment="Center"
                       Margin="0,0,0,10" Visibility="Collapsed" TextWrapping="Wrap"/>
            <ui:Button x:Name="BtnIngresar" Content="Ingresar" Appearance="Primary"
                       HorizontalAlignment="Stretch" Height="44" FontSize="15" Click="BtnIngresar_Click"/>
            <TextBlock x:Name="TxtVersion" Text="v1.0.0 - 2026" HorizontalAlignment="Center"
                       Opacity="0.4" FontSize="11" Margin="0,20,0,0"/>
        </StackPanel>
    </Grid>
</ui:FluentWindow>
