<ui:FluentWindow x:Class="SuperPOS.Client.Views.Usuarios.UsuarioEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Usuario"
        Width="520" Height="440"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ExtendsContentIntoTitleBar="True">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <ui:TitleBar x:Name="TitleBarCtrl" Grid.Row="0" Title="Usuario"/>
        <StackPanel Grid.Row="1" Margin="24,16">
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                    <TextBlock Text="Nombre de usuario *" Margin="0,0,0,4"/>
                    <ui:TextBox x:Name="TxtNombreUsuario" PlaceholderText="cajero01"/>
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="Perfil *" Margin="0,0,0,4"/>
                    <ComboBox x:Name="CmbPerfil" DisplayMemberPath="Nombre" SelectedValuePath="Id"/>
                </StackPanel>
            </Grid>
            <StackPanel Margin="0,0,0,12">
                <TextBlock Text="Nombre completo *" Margin="0,0,0,4"/>
                <ui:TextBox x:Name="TxtNombreCompleto" PlaceholderText="Juan García"/>
            </StackPanel>
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                    <TextBlock Text="Email" Margin="0,0,0,4"/>
                    <ui:TextBox x:Name="TxtEmail" PlaceholderText="correo@dominio.com"/>
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="Teléfono" Margin="0,0,0,4"/>
                    <ui:TextBox x:Name="TxtTelefono" PlaceholderText="11-0000-0000"/>
                </StackPanel>
            </Grid>
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                    <TextBlock x:Name="TxtLabelPass" Text="Contraseña *" Margin="0,0,0,4"/>
                    <ui:PasswordBox x:Name="TxtPassword" PlaceholderText="Mínimo 4 caracteres"/>
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="Confirmar contraseña" Margin="0,0,0,4"/>
                    <ui:PasswordBox x:Name="TxtPasswordConfirm" PlaceholderText="Repetir contraseña"/>
                </StackPanel>
            </Grid>
            <CheckBox x:Name="ChkActivo" Content="Usuario activo" IsChecked="True" Margin="0,16,0,0"/>
        </StackPanel>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="20,12">
            <Button Content="Cancelar" Width="100" Height="36" Margin="0,0,8,0" Click="BtnCancelar_Click"/>
            <ui:Button Content="Guardar" Appearance="Primary" Width="120" Height="36" Click="BtnGuardar_Click"/>
        </StackPanel>
    </Grid>
</ui:FluentWindow>
