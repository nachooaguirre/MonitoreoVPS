<Page x:Class="SuperPOS.Client.Views.Reportes.ContabilidadPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="Contabilidad" Background="#141414">
    
    <Page.Resources>
        <!-- Tarjeta de Reporte -->
        <Style x:Key="ReportCard" TargetType="Border">
            <Setter Property="CornerRadius"  Value="12"/>
            <Setter Property="Padding"       Value="20,18"/>
            <Setter Property="Margin"        Value="6"/>
            <Setter Property="Background"    Value="#1E1E1E"/>
            <Setter Property="BorderBrush"   Value="#2A2A2A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="#405060"/>
                    <Setter Property="Background" Value="#222225"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Título de Tarjeta -->
        <Style x:Key="ReportTitle" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="15"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#F0F0FF"/>
            <Setter Property="Margin"     Value="0,0,0,4"/>
        </Style>

        <!-- Descripción de Tarjeta -->
        <Style x:Key="ReportDesc" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="12"/>
            <Setter Property="Foreground" Value="#90A0B0"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin"     Value="0,0,0,12"/>
            <Setter Property="MinHeight"  Value="36"/>
        </Style>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ===== ENCABEZADO ===== -->
        <Border Grid.Row="0" Background="#1A1A1A" Padding="24,14" BorderThickness="0,0,0,1" BorderBrush="#2A2A2A">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="🏛️" FontSize="26" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <StackPanel>
                        <TextBlock Text="Módulo Contable (Gecom)" FontSize="22" FontWeight="Bold" Foreground="#F0F0FF"/>
                        <TextBlock Text="Exportación de Libro IVA Digital, Percepciones y Resúmenes" FontSize="12" Foreground="#607080"/>
                    </StackPanel>
                </StackPanel>
                <TextBlock Grid.Column="1" x:Name="TxtFechaHoy" FontSize="13" Foreground="#808090" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- ===== CONTENIDO ===== -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="16,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Panel de Filtro de Período y Descarga Masiva -->
                <Border Grid.Row="0" Background="#1E1E1E" CornerRadius="12" Padding="20,16" Margin="6,0,6,12" BorderThickness="1" BorderBrush="#2A2A2A">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        
                        <!-- Filtros de Mes / Año -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Período Fiscal:" Foreground="#A0B0C0" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,16,0"/>
                            
                            <TextBlock Text="Mes:" Foreground="#808090" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <ComboBox x:Name="CboMes" Width="130" Height="34" FontSize="13" Background="#252540" Foreground="#F0F0F0" DisplayMemberPath="Nombre" SelectedValuePath="Valor"/>
                            
                            <TextBlock Text="Año:" Foreground="#808090" VerticalAlignment="Center" Margin="16,0,8,0"/>
                            <ComboBox x:Name="CboAnio" Width="100" Height="34" FontSize="13" Background="#252540" Foreground="#F0F0F0"/>
                        </StackPanel>

                        <!-- Botón de Descarga en Lote -->
                        <ui:Button Grid.Column="1" x:Name="BtnDescargarTodo" Content="📥 Descargar Todos los Reportes" 
                                   Appearance="Success" Height="36" Padding="20,0" FontWeight="Bold" FontSize="13"
                                   Click="BtnDescargarTodo_Click"/>
                    </Grid>
                </Border>

                <!-- Banner de Estado/Progreso -->
                <Border Grid.Row="1" x:Name="BorderProgreso" Background="#1A2D40" CornerRadius="8" Padding="16,12" Margin="6,0,6,12" Visibility="Collapsed">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <ProgressBar Grid.Column="0" IsIndeterminate="True" Width="20" Height="20" VerticalAlignment="Center" Margin="0,0,12,0" Foreground="#60B4FF"/>
                        <TextBlock Grid.Column="1" x:Name="TxtEstadoProgreso" Text="Descargando reportes..." Foreground="#D0E0FF" FontSize="13" VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- Grid de Reportes Individuales -->
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- 1. Libro IVA Ventas Comprobantes -->
                    <Border Style="{StaticResource ReportCard}" Grid.Row="0" Grid.Column="0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="📄" FontSize="32" Margin="0,0,16,0" VerticalAlignment="Top"/>
                            <StackPanel Grid.Column="1">
                                <TextBlock Style="{StaticResource ReportTitle}" Text="Libro IVA Digital Ventas — Comprobantes"/>
                                <TextBlock Style="{StaticResource ReportDesc}" Text="Archivo TXT posicional con el detalle de comprobantes emitidos (Facturas A, B y agrupamiento de CF en Ventas Globales Diarias)."/>
                                <ui:Button Content="Descargar TXT" Appearance="Primary" Width="140" HorizontalAlignment="Left" Click="BtnVentasCbte_Click"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- 2. Libro IVA Ventas Alícuotas -->
                    <Border Style="{StaticResource ReportCard}" Grid.Row="0" Grid.Column="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="📑" FontSize="32" Margin="0,0,16,0" VerticalAlignment="Top"/>
                            <StackPanel Grid.Column="1">
                                <TextBlock Style="{StaticResource ReportTitle}" Text="Libro IVA Digital Ventas — Alícuotas"/>
                                <TextBlock Style="{StaticResource ReportDesc}" Text="Archivo TXT posicional con el desglose de IVA por cada comprobante (neto gravado, alícuota e impuesto liquidado)."/>
                                <ui:Button Content="Descargar TXT" Appearance="Primary" Width="140" HorizontalAlignment="Left" Click="BtnVentasAlic_Click"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- 3. Libro IVA Compras Comprobantes -->
                    <Border Style="{StaticResource ReportCard}" Grid.Row="1" Grid.Column="0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="📄" FontSize="32" Margin="0,0,16,0" VerticalAlignment="Top"/>
                            <StackPanel Grid.Column="1">
                                <TextBlock Style="{StaticResource ReportTitle}" Text="Libro IVA Digital Compras — Comprobantes"/>
                                <TextBlock Style="{StaticResource ReportDesc}" Text="Archivo TXT posicional con los comprobantes recibidos de proveedores (remitos y facturas de compras registradas)."/>
                                <ui:Button Content="Descargar TXT" Appearance="Primary" Width="140" HorizontalAlignment="Left" Click="BtnComprasCbte_Click"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- 4. Libro IVA Compras Alícuotas -->
                    <Border Style="{StaticResource ReportCard}" Grid.Row="1" Grid.Column="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="📑" FontSize="32" Margin="0,0,16,0" VerticalAlignment="Top"/>
                            <StackPanel Grid.Column="1">
                                <TextBlock Style="{StaticResource ReportTitle}" Text="Libro IVA Digital Compras — Alícuotas"/>
                                <TextBlock Style="{StaticResource ReportDesc}" Text="Archivo TXT posicional con las alícuotas e importes detallados de las compras del mes."/>
                                <ui:Button Content="Descargar TXT" Appearance="Primary" Width="140" HorizontalAlignment="Left" Click="BtnComprasAlic_Click"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- 5. Percepciones IVA Ventas -->
                    <Border Style="{StaticResource ReportCard}" Grid.Row="2" Grid.Column="0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="🏦" FontSize="32" Margin="0,0,16,0" VerticalAlignment="Top"/>
                            <StackPanel Grid.Column="1">
                                <TextBlock Style="{StaticResource ReportTitle}" Text="Percepciones IVA Ventas (Lote CITI)"/>
                                <TextBlock Style="{StaticResource ReportDesc}" Text="Archivo de lote para declarar las percepciones de IVA realizadas a clientes inscriptos en el mes."/>
                                <ui:Button Content="Descargar TXT" Appearance="Primary" Width="140" HorizontalAlignment="Left" Click="BtnPercepcionesVentas_Click"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- 6. Percepciones IIBB Compras -->
                    <Border Style="{StaticResource ReportCard}" Grid.Row="2" Grid.Column="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="🏦" FontSize="32" Margin="0,0,16,0" VerticalAlignment="Top"/>
                            <StackPanel Grid.Column="1">
                                <TextBlock Style="{StaticResource ReportTitle}" Text="Percepciones IIBB Compras (Lote ARBA)"/>
                                <TextBlock Style="{StaticResource ReportDesc}" Text="Archivo de lote con las percepciones de Ingresos Brutos sufridas en compras de proveedores."/>
                                <ui:Button Content="Descargar TXT" Appearance="Primary" Width="140" HorizontalAlignment="Left" Click="BtnPercepcionesCompras_Click"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- 7. Resumen Ventas (Excel/CSV) -->
                    <Border Style="{StaticResource ReportCard}" Grid.Row="3" Grid.Column="0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="📈" FontSize="32" Margin="0,0,16,0" VerticalAlignment="Top"/>
                            <StackPanel Grid.Column="1">
                                <TextBlock Style="{StaticResource ReportTitle}" Text="Resumen de Ventas (CSV Excel)"/>
                                <TextBlock Style="{StaticResource ReportDesc}" Text="Planilla resumida de ventas del mes en formato CSV delimitado por punto y coma, lista para abrir y trabajar en Excel."/>
                                <ui:Button Content="Descargar CSV" Appearance="Secondary" Width="140" HorizontalAlignment="Left" Click="BtnResumenVentas_Click"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- 8. Resumen Compras (Excel/CSV) -->
                    <Border Style="{StaticResource ReportCard}" Grid.Row="3" Grid.Column="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="📈" FontSize="32" Margin="0,0,16,0" VerticalAlignment="Top"/>
                            <StackPanel Grid.Column="1">
                                <TextBlock Style="{StaticResource ReportTitle}" Text="Resumen de Compras (CSV Excel)"/>
                                <TextBlock Style="{StaticResource ReportDesc}" Text="Planilla resumida de compras del mes en formato CSV delimitado por punto y coma, lista para abrir y trabajar en Excel."/>
                                <ui:Button Content="Descargar CSV" Appearance="Secondary" Width="140" HorizontalAlignment="Left" Click="BtnResumenCompras_Click"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </ScrollViewer>
    </Grid>
</Page>
