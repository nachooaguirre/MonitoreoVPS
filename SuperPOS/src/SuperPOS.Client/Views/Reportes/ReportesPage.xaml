<Page x:Class="SuperPOS.Client.Views.Reportes.ReportesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
      xmlns:sys="clr-namespace:System;assembly=mscorlib"
      Title="Reportes" Background="#141414">
    <Page.Resources>
        <!-- Tarjeta KPI base -->
        <Style x:Key="KpiCard" TargetType="Border">
            <Setter Property="CornerRadius"  Value="12"/>
            <Setter Property="Padding"       Value="20,16"/>
            <Setter Property="Margin"        Value="6"/>
        </Style>
        <!-- Etiqueta KPI pequeña -->
        <Style x:Key="KpiLabel" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#7090B0"/>
        </Style>
        <!-- Valor KPI grande -->
        <Style x:Key="KpiValue" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="30"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin"     Value="0,4,0,0"/>
        </Style>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ===== ENCABEZADO ===== -->
        <Border Grid.Row="0" Background="#1A1A1A" Padding="24,14" BorderThickness="0,0,0,1" BorderBrush="#2A2A2A">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="📊" FontSize="26" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <StackPanel>
                        <TextBlock Text="Panel de Control" FontSize="22" FontWeight="Bold" Foreground="#F0F0FF"/>
                        <TextBlock Text="Los Angeles Supermercados" FontSize="12" Foreground="#607080"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="TxtFechaHoy" FontSize="13" Foreground="#808090" VerticalAlignment="Center" Margin="0,0,16,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===== TABS ===== -->
        <TabControl Grid.Row="1" Background="#141414" BorderThickness="0" Padding="0">

            <!-- ===================== TAB 1: VENTAS DEL DÍA ===================== -->
            <TabItem Header="📅  Ventas del Día">
                <Grid Margin="16,12,16,12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Filtros -->
                    <Border Grid.Row="0" Background="#1E1E1E" CornerRadius="10" Padding="14,10" Margin="0,0,0,14">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Fecha:" Foreground="#808090" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <DatePicker x:Name="DpFechaDia" Height="32" FontSize="13" Foreground="#F0F0F0" Background="#252540"/>
                            <ui:Button Content="  Consultar" Margin="12,0,0,0" Height="32" Padding="16,0" Click="BtnVentasDia_Click"/>
                        </StackPanel>
                    </Border>

                    <!-- KPIs -->
                    <Grid Grid.Row="1" Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Style="{StaticResource KpiCard}" Grid.Column="0" Background="#1C2030">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="💰" FontSize="18" Margin="0,0,8,0"/>
                                    <TextBlock Style="{StaticResource KpiLabel}" Text="TOTAL DEL DÍA" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock x:Name="TxtTotalDia" Style="{StaticResource KpiValue}" Foreground="#60B4FF" Text="$ --"/>
                                <TextBlock x:Name="TxtTendenciaDia" FontSize="11" Foreground="#4080C0" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource KpiCard}" Grid.Column="1" Background="#0D3020">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🛒" FontSize="18" Margin="0,0,8,0"/>
                                    <TextBlock Style="{StaticResource KpiLabel}" Text="CANTIDAD DE VENTAS" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock x:Name="TxtCantVentasDia" Style="{StaticResource KpiValue}" Foreground="#40D080" Text="--"/>
                                <TextBlock FontSize="11" Foreground="#308060" Text="tickets emitidos"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource KpiCard}" Grid.Column="2" Background="#2A1800">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🎯" FontSize="18" Margin="0,0,8,0"/>
                                    <TextBlock Style="{StaticResource KpiLabel}" Text="TICKET PROMEDIO" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock x:Name="TxtTicketPromedio" Style="{StaticResource KpiValue}" Foreground="#FFB040" Text="$ --"/>
                                <TextBlock FontSize="11" Foreground="#A07030" Text="por venta"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource KpiCard}" Grid.Column="3" Background="#2A0D0D">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🏦" FontSize="18" Margin="0,0,8,0"/>
                                    <TextBlock Style="{StaticResource KpiLabel}" Text="IVA TOTAL" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock x:Name="TxtIvaDia" Style="{StaticResource KpiValue}" Foreground="#FF7060" Text="$ --"/>
                                <TextBlock FontSize="11" Foreground="#A05040" Text="acumulado"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Gráfico de torta + tabla medios de pago -->
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="320"/>
                        </Grid.ColumnDefinitions>

                        <!-- Pie Chart: Medios de pago -->
                        <Border Grid.Column="0" Background="#1E1E1E" CornerRadius="12" Margin="0,0,10,0" Padding="16">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="Distribución por Medio de Pago"
                                           Foreground="#C0D0FF" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                <lvc:PieChart x:Name="ChartMediosPago" Grid.Row="1"
                                              Background="#181818"
                                              LegendPosition="Right"
                                              TooltipPosition="Hidden"
                                              AnimationsSpeed="0:0:0.5"/>
                            </Grid>
                        </Border>

                        <!-- Tabla medios de pago -->
                        <Border Grid.Column="1" Background="#1E1E1E" CornerRadius="12" Padding="16">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="Detalle por Cobro"
                                           Foreground="#C0D0FF" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                <ItemsControl x:Name="IcMediosPago" Grid.Row="1">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#252525" CornerRadius="8" Padding="12,10" Margin="0,3">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding MedioPago}" Foreground="#D0E0FF" FontSize="13"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding Total, StringFormat='$ #,##0.00'}"
                                                               Foreground="#60D0A0" FontSize="14" FontWeight="Bold"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- ===================== TAB 2: VENTAS POR PERÍODO ===================== -->
            <TabItem Header="📈  Por Período">
                <Grid Margin="16,12,16,12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Filtros -->
                    <Border Grid.Row="0" Background="#1E1E1E" CornerRadius="10" Padding="14,10" Margin="0,0,0,14">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Desde:" Foreground="#808090" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <DatePicker x:Name="DpDesde" Height="32" FontSize="13" Foreground="#F0F0F0" Background="#252540"/>
                            <TextBlock Text="Hasta:" Foreground="#808090" VerticalAlignment="Center" Margin="16,0,8,0"/>
                            <DatePicker x:Name="DpHasta" Height="32" FontSize="13" Foreground="#F0F0F0" Background="#252540"/>
                            <TextBlock Text="Agrupar:" Foreground="#808090" VerticalAlignment="Center" Margin="16,0,8,0"/>
                            <ComboBox x:Name="CboAgrupar" Width="90" Height="32" Foreground="#F0F0F0" Background="#252540">
                                <ComboBoxItem Content="Día" IsSelected="True"/>
                                <ComboBoxItem Content="Mes"/>
                            </ComboBox>
                            <ui:Button Content="  Consultar" Margin="12,0,0,0" Height="32" Padding="16,0" Click="BtnPeriodo_Click"/>
                        </StackPanel>
                    </Border>

                    <!-- Totales período -->
                    <Grid Grid.Row="1" Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource KpiCard}" Background="#1C2030">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="💵" FontSize="22" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource KpiLabel}" Text="TOTAL DEL PERÍODO"/>
                                    <TextBlock x:Name="TxtTotalPeriodo" FontSize="26" FontWeight="Bold" Foreground="#60B4FF" Text="$ --"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource KpiCard}" Grid.Column="1" Background="#0D3020">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📦" FontSize="22" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource KpiLabel}" Text="TOTAL DE VENTAS"/>
                                    <TextBlock x:Name="TxtCantPeriodo" FontSize="26" FontWeight="Bold" Foreground="#40D080" Text="--"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Gráfico de barras + tabla -->
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="280"/>
                        </Grid.ColumnDefinitions>

                        <!-- Bar Chart -->
                        <Border Grid.Column="0" Background="#1E1E1E" CornerRadius="12" Margin="0,0,10,0" Padding="16">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="Evolución de Ventas"
                                           Foreground="#C0D0FF" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                <lvc:CartesianChart x:Name="ChartPeriodo" Grid.Row="1"
                                                    Background="#181818"
                                                    TooltipPosition="Hidden"
                                                    AnimationsSpeed="0:0:0.4"/>
                            </Grid>
                        </Border>

                        <!-- Tabla detalle -->
                        <Border Grid.Column="1" Background="#1E1E1E" CornerRadius="12" Padding="16">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="Detalle"
                                           Foreground="#C0D0FF" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                <DataGrid x:Name="DgPeriodo" Grid.Row="1" AutoGenerateColumns="False"
                                          IsReadOnly="True" CanUserAddRows="False"
                                          Background="#141414" Foreground="#D0E0FF" FontSize="12"
                                          RowBackground="#1E1E1E" AlternatingRowBackground="#252525"
                                          HorizontalGridLinesBrush="#333333" BorderThickness="0">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Período" Binding="{Binding Periodo}" Width="80"/>
                                        <DataGridTextColumn Header="Cant." Binding="{Binding CantVentas}" Width="50"/>
                                        <DataGridTextColumn Header="Total" Binding="{Binding Total, StringFormat='N0'}" Width="*"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- ===================== TAB 3: RANKING ===================== -->
            <TabItem Header="🏆  Top Productos">
                <Grid Margin="16,12,16,12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Filtros -->
                    <Border Grid.Row="0" Background="#1E1E1E" CornerRadius="10" Padding="14,10" Margin="0,0,0,14">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Desde:" Foreground="#808090" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <DatePicker x:Name="DpRankingDesde" Height="32" FontSize="13" Foreground="#F0F0F0" Background="#252540"/>
                            <TextBlock Text="Hasta:" Foreground="#808090" VerticalAlignment="Center" Margin="16,0,8,0"/>
                            <DatePicker x:Name="DpRankingHasta" Height="32" FontSize="13" Foreground="#F0F0F0" Background="#252540"/>
                            <TextBlock Text="Top:" Foreground="#808090" VerticalAlignment="Center" Margin="16,0,8,0"/>
                            <ui:NumberBox x:Name="NumTop" Value="10" Minimum="5" Maximum="50" Width="72" Height="32"/>
                            <ui:Button Content="  Consultar" Margin="12,0,0,0" Height="32" Padding="16,0" Click="BtnRanking_Click"/>
                        </StackPanel>
                    </Border>

                    <!-- Gráfico horizontal + tabla -->
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="320"/>
                        </Grid.ColumnDefinitions>

                        <!-- Bar chart horizontal -->
                        <Border Grid.Column="0" Background="#1E1E1E" CornerRadius="12" Margin="0,0,10,0" Padding="16">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="Productos Más Vendidos — Total $"
                                           Foreground="#C0D0FF" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                <lvc:CartesianChart x:Name="ChartRanking" Grid.Row="1"
                                                    Background="#181818"
                                                    TooltipPosition="Hidden"
                                                    AnimationsSpeed="0:0:0.5"/>
                            </Grid>
                        </Border>

                        <!-- Podio top 3 + lista -->
                        <Border Grid.Column="1" Background="#1E1E1E" CornerRadius="12" Padding="16">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="Podio"
                                           Foreground="#C0D0FF" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                    <ItemsControl x:Name="IcRanking">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border x:Name="CardRanking" CornerRadius="8" Padding="12,9" Margin="0,3">
                                                    <Border.Background>
                                                        <SolidColorBrush Color="#1A1A35"/>
                                                    </Border.Background>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="36"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock x:Name="TxtPos" Grid.Column="0"
                                                                   Text="{Binding Posicion}"
                                                                   FontSize="15" FontWeight="Bold"
                                                                   Foreground="#FFB040"
                                                                   VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Descripcion}"
                                                                       Foreground="#D0E0FF" FontSize="12"
                                                                       TextTrimming="CharacterEllipsis"/>
                                                            <TextBlock Text="{Binding CantVendida, StringFormat='Cant: {0:N0}'}"
                                                                       Foreground="#7090B0" FontSize="11"/>
                                                        </StackPanel>
                                                        <TextBlock Grid.Column="2"
                                                                   Text="{Binding TotalVendido, StringFormat='$ #,##0'}"
                                                                   Foreground="#40D080" FontSize="13" FontWeight="Bold"
                                                                   VerticalAlignment="Center"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- ===================== TAB 4: STOCK BAJO MÍNIMO ===================== -->
            <TabItem Header="⚠  Stock Crítico">
                <Grid Margin="16,12,16,12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Resumen -->
                    <Grid Grid.Row="0" Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource KpiCard}" Background="#3A0A0A">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="⚠" FontSize="20" Margin="0,0,8,0"/>
                                    <TextBlock Style="{StaticResource KpiLabel}" Text="ARTÍCULOS CRÍTICOS" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock x:Name="TxtTotalCriticos" Style="{StaticResource KpiValue}" Foreground="#FF5050" Text="--"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource KpiCard}" Grid.Column="1" Background="#2A1500">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="📦" FontSize="20" Margin="0,0,8,0"/>
                                    <TextBlock Style="{StaticResource KpiLabel}" Text="COSTO REPOSICIÓN" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock x:Name="TxtCostoReposicion" Style="{StaticResource KpiValue}" Foreground="#FFB040" Text="$ --"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource KpiCard}" Grid.Column="2" Background="#0A1A0A">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="✅" FontSize="20" Margin="0,0,8,0"/>
                                    <TextBlock Style="{StaticResource KpiLabel}" Text="STOCK NORMAL" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock x:Name="TxtStockNormal" Style="{StaticResource KpiValue}" Foreground="#40D080" Text="--"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="3" Margin="6" VerticalAlignment="Center">
                            <ui:Button Content="  Actualizar" Height="42" Padding="20,0" Click="BtnStockBajo_Click"/>
                        </Border>
                    </Grid>

                    <!-- Barra chart stock (bar horizontal: actual vs mínimo) -->
                    <Border Grid.Row="1" Background="#1E1E1E" CornerRadius="12" Padding="16" Margin="0,0,0,14" Height="180">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="Stock Actual vs Mínimo requerido (primeros 12 artículos)"
                                       Foreground="#C0D0FF" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,8"/>
                            <lvc:CartesianChart x:Name="ChartStock" Grid.Row="1"
                                                Background="#181818"
                                                TooltipPosition="Hidden"
                                                AnimationsSpeed="0:0:0.4"/>
                        </Grid>
                    </Border>

                    <!-- Tabla detalle -->
                    <Border Grid.Row="2" Background="#1E1E1E" CornerRadius="12" Padding="16">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="Artículos que necesitan reposición"
                                       Foreground="#C0D0FF" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8"/>
                            <DataGrid x:Name="DgStockBajo" Grid.Row="1" AutoGenerateColumns="False"
                                      IsReadOnly="True" CanUserAddRows="False"
                                      Background="#141414" Foreground="#F0F0FF" FontSize="13"
                                      RowBackground="#1E1E1E" AlternatingRowBackground="#252525"
                                      HorizontalGridLinesBrush="#333333" BorderThickness="0" RowHeight="36">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="CÓDIGO" Binding="{Binding CodigoBarras}" Width="120">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#7090B0"/>
                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                                <Setter Property="Padding" Value="8,0"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="DESCRIPCIÓN" Binding="{Binding Descripcion}" Width="*">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#E0E8FF"/>
                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                                <Setter Property="Padding" Value="8,0"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTemplateColumn Header="STOCK ACTUAL" Width="120">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,12,0">
                                                    <TextBlock Text="{Binding StockActual, StringFormat='N1'}"
                                                               Foreground="#FF5050" FontWeight="Bold" FontSize="14" HorizontalAlignment="Right"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="MÍNIMO" Binding="{Binding StockMinimo, StringFormat='N1'}" Width="90">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#A08040"/>
                                                <Setter Property="HorizontalAlignment" Value="Right"/>
                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                                <Setter Property="Padding" Value="0,0,12,0"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTemplateColumn Header="A REPONER" Width="100">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border Background="#3A1A00" CornerRadius="4" Padding="8,4" Margin="4"
                                                        HorizontalAlignment="Right">
                                                    <TextBlock Text="{Binding UnidadesAReponer, StringFormat='N0'}"
                                                               Foreground="#FFB040" FontWeight="Bold" FontSize="13"/>
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="COSTO UNIT." Binding="{Binding PrecioCosto, StringFormat='$ #,##0'}" Width="110">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#60D0A0"/>
                                                <Setter Property="HorizontalAlignment" Value="Right"/>
                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                                <Setter Property="Padding" Value="0,0,12,0"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Page>
