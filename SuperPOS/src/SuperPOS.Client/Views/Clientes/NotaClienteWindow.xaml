<ui:FluentWindow x:Class="SuperPOS.Client.Views.Clientes.NotaClienteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Nota de Crédito/Débito" Width="420" Height="420"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        ExtendsContentIntoTitleBar="True">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <ui:TitleBar Grid.Row="0" Title="Nota de Crédito/Débito a Cliente"/>
        <StackPanel Grid.Row="1" Margin="24">
            <TextBlock x:Name="TxtCliente" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12"/>
            <TextBlock Text="Tipo de nota" Margin="0,0,0,4"/>
            <ComboBox x:Name="CboTipo" Margin="0,0,0,12" SelectedIndex="1">
                <ComboBoxItem Content="Nota de Crédito A" Tag="4,A"/>
                <ComboBoxItem Content="Nota de Crédito B" Tag="5,B"/>
                <ComboBoxItem Content="Nota de Crédito C" Tag="6,C"/>
                <ComboBoxItem Content="Nota de Débito A" Tag="10,A"/>
                <ComboBoxItem Content="Nota de Débito B" Tag="11,B"/>
                <ComboBoxItem Content="Nota de Débito C" Tag="12,C"/>
            </ComboBox>
            <TextBlock Text="Monto total (con IVA)" Margin="0,0,0,4"/>
            <ui:NumberBox x:Name="NumMonto" Minimum="0.01" PlaceholderText="0,00" Margin="0,0,0,12"/>
            <TextBlock Text="Motivo" Margin="0,0,0,4"/>
            <ui:TextBox x:Name="TxtConcepto" PlaceholderText="Ej: diferencia por pago mal cobrado"/>
        </StackPanel>
        <Border Grid.Row="2" Padding="24,12" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <ui:Button Content="Cancelar" Margin="0,0,8,0" Click="BtnCancelar_Click"/>
                <ui:Button Content="✅ Emitir" Appearance="Primary" Click="BtnConfirmar_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</ui:FluentWindow>
