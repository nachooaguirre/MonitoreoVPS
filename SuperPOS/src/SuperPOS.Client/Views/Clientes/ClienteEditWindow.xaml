<ui:FluentWindow x:Class="SuperPOS.Client.Views.Clientes.ClienteEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Cliente"
        Width="680" Height="560"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ExtendsContentIntoTitleBar="True">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ui:TitleBar x:Name="TitleBarCtrl" Grid.Row="0" Title="Cliente"/>

        <ScrollViewer Grid.Row="1" Padding="20,12">
            <StackPanel>
                <!-- Identificación -->
                <TextBlock Text="Identificación" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,8"/>
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="160"/>
                        <ColumnDefinition Width="160"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                        <TextBlock Text="Razón Social *" Margin="0,0,0,4"/>
                        <ui:TextBox x:Name="TxtRazonSocial" PlaceholderText="Nombre o razón social"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="0,0,8,0">
                        <TextBlock Text="CUIT / DNI" Margin="0,0,0,4"/>
                        <ui:TextBox x:Name="TxtCuit" PlaceholderText="20000000000"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Condición IVA" Margin="0,0,0,4"/>
                        <ComboBox x:Name="CmbCondIva">
                            <ComboBoxItem Content="Responsable Inscripto" Tag="1"/>
                            <ComboBoxItem Content="Responsable No Inscripto" Tag="2"/>
                            <ComboBoxItem Content="No Responsable" Tag="3"/>
                            <ComboBoxItem Content="Exento" Tag="4"/>
                            <ComboBoxItem Content="Consumidor Final" Tag="5" IsSelected="True"/>
                            <ComboBoxItem Content="Monotributista" Tag="6"/>
                        </ComboBox>
                    </StackPanel>
                </Grid>

                <!-- Contacto -->
                <TextBlock Text="Contacto" FontWeight="SemiBold" FontSize="14" Margin="0,8,0,8"/>
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                        <TextBlock Text="Teléfono" Margin="0,0,0,4"/>
                        <ui:TextBox x:Name="TxtTelefono" PlaceholderText="011-0000-0000"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="0,0,8,0">
                        <TextBlock Text="Celular" Margin="0,0,0,4"/>
                        <ui:TextBox x:Name="TxtCelular" PlaceholderText="11-0000-0000"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Email" Margin="0,0,0,4"/>
                        <ui:TextBox x:Name="TxtEmail" PlaceholderText="correo@dominio.com"/>
                    </StackPanel>
                </Grid>

                <!-- Dirección -->
                <TextBlock Text="Dirección" FontWeight="SemiBold" FontSize="14" Margin="0,8,0,8"/>
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="100"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                        <TextBlock Text="Dirección" Margin="0,0,0,4"/>
                        <ui:TextBox x:Name="TxtDireccion" PlaceholderText="Calle 123"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="0,0,8,0">
                        <TextBlock Text="Localidad" Margin="0,0,0,4"/>
                        <ui:TextBox x:Name="TxtLocalidad"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Margin="0,0,8,0">
                        <TextBlock Text="Provincia" Margin="0,0,0,4"/>
                        <ui:TextBox x:Name="TxtProvincia" PlaceholderText="Buenos Aires"/>
                    </StackPanel>
                    <StackPanel Grid.Column="3">
                        <TextBlock Text="Cód. Postal" Margin="0,0,0,4"/>
                        <ui:TextBox x:Name="TxtCP" PlaceholderText="1000"/>
                    </StackPanel>
                </Grid>

                <!-- Crédito -->
                <TextBlock Text="Cuenta Corriente" FontWeight="SemiBold" FontSize="14" Margin="0,8,0,8"/>
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <CheckBox x:Name="ChkCtaCte" Grid.Column="0" Content="Tiene Cta. Cte." VerticalAlignment="Center" Margin="0,0,16,0"/>
                    <StackPanel Grid.Column="1" Margin="0,0,8,0">
                        <TextBlock Text="Límite de Crédito" Margin="0,0,0,4"/>
                        <ui:TextBox x:Name="TxtLimite" PlaceholderText="0.00"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Margin="0,0,8,0">
                        <TextBlock Text="Días Vencimiento" Margin="0,0,0,4"/>
                        <ui:TextBox x:Name="TxtDiasVto" PlaceholderText="30"/>
                    </StackPanel>
                    <StackPanel Grid.Column="3">
                        <TextBlock Text="% Descuento" Margin="0,0,0,4"/>
                        <ui:TextBox x:Name="TxtDescuento" PlaceholderText="0.00"/>
                    </StackPanel>
                </Grid>

                <CheckBox x:Name="ChkActivo" Content="Activo" IsChecked="True" Margin="0,4,0,0"/>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="20,12">
            <Button Content="Cancelar" Width="100" Height="36" Margin="0,0,8,0" Click="BtnCancelar_Click"/>
            <ui:Button Content="Guardar" Appearance="Primary" Width="120" Height="36" Click="BtnGuardar_Click"/>
        </StackPanel>
    </Grid>
</ui:FluentWindow>
