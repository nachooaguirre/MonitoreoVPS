<ui:FluentWindow x:Class="SuperPOS.Client.Views.UpdateProgressWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Actualizando SuperPOS"
        Width="420" Height="200"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="ToolWindow"
        ExtendsContentIntoTitleBar="True">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <ui:TitleBar Grid.Row="0" Title="Actualizando SuperPOS" ShowMaximize="False" ShowMinimize="False"/>
        <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="30,0">
            <TextBlock x:Name="TxtEstado" Text="Descargando actualización..." FontSize="14"
                       HorizontalAlignment="Center" Margin="0,0,0,16"/>
            <ProgressBar x:Name="BarProgreso" Minimum="0" Maximum="100" Height="8"/>
            <TextBlock x:Name="TxtPorcentaje" Text="0%" FontSize="12" Opacity="0.6"
                       HorizontalAlignment="Center" Margin="0,8,0,0"/>
        </StackPanel>
    </Grid>
</ui:FluentWindow>
