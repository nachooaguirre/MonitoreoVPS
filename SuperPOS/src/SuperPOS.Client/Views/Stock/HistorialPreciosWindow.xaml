<ui:FluentWindow x:Class="SuperPOS.Client.Views.Stock.HistorialPreciosWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Historial de Precios y Costos"
        Width="700" Height="620"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ExtendsContentIntoTitleBar="True">
    
    <Grid Background="#141414">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Barra de Título -->
        <ui:TitleBar x:Name="TitleBarCtrl" Grid.Row="0" Title="Historial de Precios y Costos"/>

        <!-- Contenido principal -->
        <Grid Grid.Row="1" Margin="20,10,20,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Articulo info -->
                <RowDefinition Height="*"/>    <!-- Cambios de Costo -->
                <RowDefinition Height="*"/>    <!-- Cambios de Venta -->
            </Grid.RowDefinitions>

            <!-- Info del Artículo -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
                <TextBlock Text="Artículo:" Foreground="#809090" FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBlock x:Name="TxtArticuloNombre" Foreground="#FFF" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
            </StackPanel>

            <!-- Cambios de Costo -->
            <Grid Grid.Row="1" Margin="0,0,0,10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="Últimos Cambios de Costo" Foreground="#7AAAE0" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,6"/>
                <DataGrid x:Name="DgCostos" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True"
                          SelectionMode="Single" GridLinesVisibility="Horizontal" CanUserResizeRows="False"
                          BorderThickness="1" BorderBrush="#2A2A2A" Background="#1E1E1E" RowHeight="28" FontSize="12">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Fecha" Binding="{Binding Fecha, StringFormat=dd/MM/yyyy}" Width="85"/>
                        <DataGridTextColumn Header="Hora" Binding="{Binding Fecha, StringFormat=HH:mm:ss}" Width="70"/>
                        <DataGridTextColumn Header="Sucursal" Binding="{Binding Sucursal.Nombre, TargetNullValue='Casa Central'}" Width="100"/>
                        <DataGridTextColumn Header="Usuario" Binding="{Binding Usuario.NombreCompleto, TargetNullValue='Sistema'}" Width="130"/>
                        <DataGridTextColumn Header="Costo Anterior" Width="100">
                            <DataGridTextColumn.Binding>
                                <Binding Path="PrecioAnterior" StringFormat="C4"/>
                            </DataGridTextColumn.Binding>
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock"><Setter Property="HorizontalAlignment" Value="Right"/></Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Costo Nuevo" Width="100">
                            <DataGridTextColumn.Binding>
                                <Binding Path="PrecioNuevo" StringFormat="C4"/>
                            </DataGridTextColumn.Binding>
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock"><Setter Property="HorizontalAlignment" Value="Right"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>
                <TextBlock x:Name="TxtNoCostos" Grid.Row="1" Text="No se registran cambios de costo para este artículo." 
                           Foreground="#607080" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
            </Grid>

            <!-- Cambios de Venta -->
            <Grid Grid.Row="2" Margin="0,0,0,10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="Últimos Cambios de Precio de Venta" Foreground="#7AAAE0" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,6"/>
                <DataGrid x:Name="DgPrecios" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True"
                          SelectionMode="Single" GridLinesVisibility="Horizontal" CanUserResizeRows="False"
                          BorderThickness="1" BorderBrush="#2A2A2A" Background="#1E1E1E" RowHeight="28" FontSize="12">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Fecha" Binding="{Binding Fecha, StringFormat=dd/MM/yyyy}" Width="85"/>
                        <DataGridTextColumn Header="Hora" Binding="{Binding Fecha, StringFormat=HH:mm:ss}" Width="70"/>
                        <DataGridTextColumn Header="Sucursal" Binding="{Binding Sucursal.Nombre, TargetNullValue='Casa Central'}" Width="100"/>
                        <DataGridTextColumn Header="Usuario" Binding="{Binding Usuario.NombreCompleto, TargetNullValue='Sistema'}" Width="130"/>
                        <DataGridTextColumn Header="Precio Anterior" Width="100">
                            <DataGridTextColumn.Binding>
                                <Binding Path="PrecioAnterior" StringFormat="C4"/>
                            </DataGridTextColumn.Binding>
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock"><Setter Property="HorizontalAlignment" Value="Right"/></Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Precio Nuevo" Width="100">
                            <DataGridTextColumn.Binding>
                                <Binding Path="PrecioNuevo" StringFormat="C4"/>
                            </DataGridTextColumn.Binding>
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock"><Setter Property="HorizontalAlignment" Value="Right"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>
                <TextBlock x:Name="TxtNoPrecios" Grid.Row="1" Text="No se registran cambios de precio de venta para este artículo." 
                           Foreground="#607080" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
            </Grid>
        </Grid>

        <!-- Pie de página (Alta y Botón de Salida) -->
        <Border Grid.Row="2" Background="#1A1A1A" BorderThickness="0,1,0,0" BorderBrush="#2A2A2A" Padding="20,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Alta de Artículo -->
                <StackPanel Grid.Column="0" Orientation="Vertical" VerticalAlignment="Center">
                    <TextBlock Text="Alta de Artículo" Foreground="#809090" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Fecha:" Foreground="#607080" FontSize="11" Margin="0,0,4,0"/>
                        <TextBlock x:Name="TxtAltaFecha" Text="—" Foreground="#FFF" FontSize="11" Margin="0,0,16,0"/>
                        
                        <TextBlock Text="Usuario:" Foreground="#607080" FontSize="11" Margin="0,0,4,0"/>
                        <TextBlock x:Name="TxtAltaUsuario" Text="—" Foreground="#FFF" FontSize="11" Margin="0,0,16,0"/>

                        <TextBlock Text="Sucursal:" Foreground="#607080" FontSize="11" Margin="0,0,4,0"/>
                        <TextBlock x:Name="TxtAltaSucursal" Text="—" Foreground="#FFF" FontSize="11"/>
                    </StackPanel>
                </StackPanel>

                <!-- Botón Salir -->
                <ui:Button Grid.Column="1" Content="Salir" Width="100" Height="34" Click="BtnSalir_Click" Appearance="Secondary" VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</ui:FluentWindow>
