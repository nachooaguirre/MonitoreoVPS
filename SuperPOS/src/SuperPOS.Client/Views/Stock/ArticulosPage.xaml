<Page x:Class="SuperPOS.Client.Views.Stock.ArticulosPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="Artículos">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock Text="Artículos" FontSize="24" FontWeight="Bold" VerticalAlignment="Center"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <ui:Button Content="⚡ Actualización Masiva" Margin="0,0,8,0" Click="BtnActualizacionMasiva_Click"/>
                <ui:Button Content="+ Nuevo Artículo" Appearance="Primary" Click="BtnNuevo_Click"/>
            </StackPanel>
        </Grid>

        <!-- Filtros -->
        <Grid Grid.Row="1" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <ui:TextBox x:Name="TxtBuscar" Grid.Column="0" PlaceholderText="Buscar por descripción, código o EAN..." Margin="0,0,8,0" KeyDown="TxtBuscar_KeyDown"/>
            <ComboBox x:Name="CmbDepto" Grid.Column="1" Margin="0,0,8,0" SelectionChanged="Filtro_DeptoOrFamilia_Changed" DisplayMemberPath="Nombre" SelectedValuePath="Id"/>
            <ComboBox x:Name="CmbFamilia" Grid.Column="2" Margin="0,0,8,0" SelectionChanged="Filtro_DeptoOrFamilia_Changed" DisplayMemberPath="Nombre" SelectedValuePath="Id"/>
            <CheckBox x:Name="ChkIncluirInactivos" Grid.Column="3" Content="Incluir inactivos" VerticalAlignment="Center" Margin="0,0,12,0" ToolTip="Mostrar también artículos dados de baja (Activo = no)." Checked="ChkIncluirInactivos_Changed" Unchecked="ChkIncluirInactivos_Changed"/>
            <ui:Button Grid.Column="4" Content="Buscar" Click="BtnBuscar_Click"/>
        </Grid>

        <!-- Tabla -->
        <DataGrid x:Name="DgArticulos" Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="True"
                  SelectionMode="Single" GridLinesVisibility="Horizontal" CanUserResizeRows="False"
                  BorderThickness="1" RowHeight="32" FontSize="13"
                  MouseDoubleClick="DgArticulos_MouseDoubleClick">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="55"/>
                <DataGridTextColumn Header="Código" Binding="{Binding CodigoBarras}" Width="120"/>
                <DataGridTextColumn Header="Descripción" Binding="{Binding Descripcion}" Width="*"/>
                <DataGridTextColumn Header="Depto" Binding="{Binding Departamento.Nombre}" Width="100"/>
                <DataGridTextColumn Header="Costo" Width="90">
                    <DataGridTextColumn.Binding>
                        <Binding Path="PrecioCosto" StringFormat="N2"/>
                    </DataGridTextColumn.Binding>
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock"><Setter Property="HorizontalAlignment" Value="Right"/></Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="IVA %" Binding="{Binding AlicuotaIva, StringFormat=N0}" Width="55">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock"><Setter Property="HorizontalAlignment" Value="Right"/></Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="P. Venta" Width="90">
                    <DataGridTextColumn.Binding>
                        <Binding Path="PrecioVenta" StringFormat="N2"/>
                    </DataGridTextColumn.Binding>
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock"><Setter Property="HorizontalAlignment" Value="Right"/><Setter Property="FontWeight" Value="Bold"/></Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Stock" Width="70">
                    <DataGridTextColumn.Binding>
                        <Binding Path="StockActual" StringFormat="N2"/>
                    </DataGridTextColumn.Binding>
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock"><Setter Property="HorizontalAlignment" Value="Right"/></Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Mín" Width="58">
                    <DataGridTextColumn.Binding>
                        <Binding Path="StockMinimo" StringFormat="N0"/>
                    </DataGridTextColumn.Binding>
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock"><Setter Property="HorizontalAlignment" Value="Right"/></Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Máx" Width="58">
                    <DataGridTextColumn.Binding>
                        <Binding Path="StockMaximo" StringFormat="N0"/>
                    </DataGridTextColumn.Binding>
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock"><Setter Property="HorizontalAlignment" Value="Right"/></Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Proveedor" Binding="{Binding Proveedor.RazonSocial}" Width="130"/>
                <DataGridTextColumn Header="Vencim." Width="90">
                    <DataGridTextColumn.Binding>
                        <Binding Path="VencimientoReferencia" StringFormat="dd/MM/yy" TargetNullValue="—"/>
                    </DataGridTextColumn.Binding>
                </DataGridTextColumn>
                <DataGridCheckBoxColumn Header="Act." Binding="{Binding Activo}" IsReadOnly="True" Width="48"/>
                <DataGridTemplateColumn Header="Acciones" Width="110">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Button Content="✏" Width="32" Height="26" Margin="2,0" ToolTip="Editar" Tag="{Binding}" Click="BtnEditar_Click"/>
                                <Button Content="🗑" Width="32" Height="26" Margin="2,0" ToolTip="Eliminar" Tag="{Binding}" Click="BtnEliminar_Click"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Paginación -->
        <Grid Grid.Row="3" Margin="0,8,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock x:Name="TxtTotal" VerticalAlignment="Center" Opacity="0.6"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="◀" x:Name="BtnPrev" Click="BtnPrev_Click" Width="32" Height="28" Margin="4,0"/>
                <TextBlock x:Name="TxtPagina" VerticalAlignment="Center" Margin="4,0"/>
                <Button Content="▶" x:Name="BtnNext" Click="BtnNext_Click" Width="32" Height="28" Margin="4,0"/>
            </StackPanel>
        </Grid>
    </Grid>
</Page>
