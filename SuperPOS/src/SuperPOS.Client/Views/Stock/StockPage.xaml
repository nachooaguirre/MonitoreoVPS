<Page x:Class="SuperPOS.Client.Views.Stock.StockPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <TextBlock Text="Stock" FontSize="24" FontWeight="Bold" Margin="0,0,0,12"/>
        <DataGrid Grid.Row="1" x:Name="DgStock" AutoGenerateColumns="False" IsReadOnly="True"
                  GridLinesVisibility="Horizontal" RowHeight="30" FontSize="13">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Código" Binding="{Binding CodigoBarras}" Width="120"/>
                <DataGridTextColumn Header="Descripción" Binding="{Binding Descripcion}" Width="*"/>
                <DataGridTextColumn Header="Depto" Binding="{Binding Departamento.Nombre}" Width="120"/>
                <DataGridTextColumn Header="Stock Actual" Width="100">
                    <DataGridTextColumn.Binding><Binding Path="StockActual" StringFormat="N3"/></DataGridTextColumn.Binding>
                    <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="HorizontalAlignment" Value="Right"/></Style></DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Stock Mín." Width="90">
                    <DataGridTextColumn.Binding><Binding Path="StockMinimo" StringFormat="N3"/></DataGridTextColumn.Binding>
                    <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="HorizontalAlignment" Value="Right"/></Style></DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Page>
