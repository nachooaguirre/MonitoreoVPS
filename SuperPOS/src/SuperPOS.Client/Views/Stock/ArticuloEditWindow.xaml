<ui:FluentWindow x:Class="SuperPOS.Client.Views.Stock.ArticuloEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Artículo"
        Width="820" MinHeight="700" Height="720"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ExtendsContentIntoTitleBar="True">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ui:TitleBar x:Name="TitleBarCtrl" Grid.Row="0" Title="Artículo"/>

        <ScrollViewer Grid.Row="1" Padding="20,12">
            <StackPanel>
                <!-- Datos principales -->
                <TextBlock Text="Datos principales" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,8"/>
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="160"/>
                        <ColumnDefinition Width="160"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                        <TextBlock Text="Descripción *" Margin="0,0,0,4"/>
                        <ui:TextBox x:Name="TxtDescripcion" PlaceholderText="Descripción del artículo"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="0,0,8,0">
                        <TextBlock Text="Cód. Barras (EAN)" Margin="0,0,0,4"/>
                        <ui:TextBox x:Name="TxtEAN" PlaceholderText="7790000000000"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Código interno" Margin="0,0,0,4"/>
                        <ui:TextBox x:Name="TxtCodigoInterno" PlaceholderText="001"/>
                    </StackPanel>
                </Grid>

                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                        <TextBlock Text="Departamento" Margin="0,0,0,4"/>
                        <ComboBox x:Name="CmbDepto" DisplayMemberPath="Nombre" SelectedValuePath="Id" SelectionChanged="CmbDepto_Changed"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="0,0,8,0">
                        <TextBlock Text="Familia" Margin="0,0,0,4"/>
                        <ComboBox x:Name="CmbFamilia" DisplayMemberPath="Nombre" SelectedValuePath="Id"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Marca" Margin="0,0,0,4"/>
                        <ComboBox x:Name="CmbMarca" DisplayMemberPath="Nombre" SelectedValuePath="Id"/>
                    </StackPanel>
                </Grid>

                <StackPanel Margin="0,0,0,12">
                    <TextBlock Text="Proveedor" Margin="0,0,0,4"/>
                    <ComboBox x:Name="CmbProveedor" DisplayMemberPath="RazonSocial" SelectedValuePath="Id"/>
                </StackPanel>

                <!-- Precios -->
                <TextBlock Text="Precios" FontWeight="SemiBold" FontSize="14" Margin="0,8,0,8"/>
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                        <TextBlock Text="P. Costo" Margin="0,0,0,4"/>
                        <ui:TextBox x:Name="TxtCosto" PlaceholderText="0.00" TextChanged="Precio_Changed"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="0,0,8,0">
                        <TextBlock Text="IVA %" Margin="0,0,0,4"/>
                        <ComboBox x:Name="CmbIva" SelectionChanged="Precio_Changed">
                            <ComboBoxItem Content="0%" Tag="0"/>
                            <ComboBoxItem Content="10.5%" Tag="10.5"/>
                            <ComboBoxItem Content="21%" Tag="21" IsSelected="True"/>
                            <ComboBoxItem Content="27%" Tag="27"/>
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Margin="0,0,8,0">
                        <TextBlock Text="Margen %" Margin="0,0,0,4"/>
                        <ui:TextBox x:Name="TxtMargen" PlaceholderText="30.00" TextChanged="Precio_Changed"/>
                    </StackPanel>
                    <StackPanel Grid.Column="3" Margin="0,0,8,0">
                        <TextBlock Text="P. Venta *" Margin="0,0,0,4" FontWeight="Bold"/>
                        <ui:TextBox x:Name="TxtPrecioVenta" PlaceholderText="0.00" FontWeight="Bold" TextChanged="Venta_Changed"/>
                    </StackPanel>
                    <StackPanel Grid.Column="4">
                        <TextBlock Text="P. Oferta" Margin="0,0,0,4"/>
                        <ui:TextBox x:Name="TxtPrecioOferta" PlaceholderText="0.00"/>
                    </StackPanel>
                </Grid>

                <!-- Bonificaciones y Recargos (Colapsable) -->
                <Expander Header="Bonificaciones e Impuestos Especiales" Margin="0,0,0,12" HorizontalAlignment="Stretch">
                    <StackPanel Margin="0,8,0,0">
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                <TextBlock Text="Bonif. 1 %" FontSize="11" Margin="0,0,0,4"/>
                                <ui:TextBox x:Name="TxtBonif1" PlaceholderText="0.00" TextChanged="Precio_Changed"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="0,0,8,0">
                                <TextBlock Text="Bonif. 2 %" FontSize="11" Margin="0,0,0,4"/>
                                <ui:TextBox x:Name="TxtBonif2" PlaceholderText="0.00" TextChanged="Precio_Changed"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Margin="0,0,8,0">
                                <TextBlock Text="Bonif. 3 %" FontSize="11" Margin="0,0,0,4"/>
                                <ui:TextBox x:Name="TxtBonif3" PlaceholderText="0.00" TextChanged="Precio_Changed"/>
                            </StackPanel>
                            <StackPanel Grid.Column="3" Margin="0,0,8,0">
                                <TextBlock Text="Bonif. 4 %" FontSize="11" Margin="0,0,0,4"/>
                                <ui:TextBox x:Name="TxtBonif4" PlaceholderText="0.00" TextChanged="Precio_Changed"/>
                            </StackPanel>
                            <StackPanel Grid.Column="4">
                                <TextBlock Text="Bonif. 5 %" FontSize="11" Margin="0,0,0,4"/>
                                <ui:TextBox x:Name="TxtBonif5" PlaceholderText="0.00" TextChanged="Precio_Changed"/>
                            </StackPanel>
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                <TextBlock Text="Recargo 1 %" FontSize="11" Margin="0,0,0,4"/>
                                <ui:TextBox x:Name="TxtRecargo1" PlaceholderText="0.00" TextChanged="Precio_Changed"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="0,0,8,0">
                                <TextBlock Text="Imp. Interno ($)" FontSize="11" Margin="0,0,0,4"/>
                                <ui:TextBox x:Name="TxtImpuestoInterno" PlaceholderText="0.00" TextChanged="Precio_Changed"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Margin="0,0,8,0">
                                <TextBlock Text="Bonif. Total" FontSize="11" Margin="0,0,0,4" Foreground="#607080"/>
                                <TextBlock x:Name="LblBonifTotal" Text="0.00 %" FontWeight="SemiBold" Margin="0,8,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="3">
                                <TextBlock Text="Recargo Total" FontSize="11" Margin="0,0,0,4" Foreground="#607080"/>
                                <TextBlock x:Name="LblRecargoTotal" Text="0.00 %" FontWeight="SemiBold" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Expander>

                <!-- Unidades/Presentación -->
                <TextBlock Text="Presentación y Stock" FontWeight="SemiBold" FontSize="14" Margin="0,8,0,8"/>
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                        <TextBlock Text="Und. por Bulto" Margin="0,0,0,4"/>
                        <ui:TextBox x:Name="TxtUxB" PlaceholderText="1"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="0,0,8,0">
                        <TextBlock Text="Cajas por Bulto" Margin="0,0,0,4"/>
                        <ui:TextBox x:Name="TxtCxB" PlaceholderText="1"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Margin="0,0,8,0">
                        <TextBlock Text="Stock Actual" Margin="0,0,0,4"/>
                        <ui:TextBox x:Name="TxtStock" PlaceholderText="0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="3" Margin="0,0,8,0">
                        <TextBlock Margin="0,0,0,4">
                            <Run Text="Stock mínimo"/>
                            <Run Text=" (alertas)" Foreground="#607080" FontSize="10"/>
                        </TextBlock>
                        <ui:TextBox x:Name="TxtStockMin" PlaceholderText="0"
                                    ToolTip="Piso a partir del cual se considera faltante: campana arriba a la derecha, reporte y asistente IA."/>
                    </StackPanel>
                    <StackPanel Grid.Column="4">
                        <TextBlock Text="Stock Máximo" Margin="0,0,0,4"/>
                        <ui:TextBox x:Name="TxtStockMax" PlaceholderText="0"/>
                    </StackPanel>
                </Grid>

                <!-- Contenido y Unidad de Medida (Cálculo Kilo/Litro) -->
                <TextBlock Text="Contenido y Unidad de Medida (Cálculo Kilo/Litro)" FontWeight="SemiBold" FontSize="14" Margin="0,8,0,8"/>
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="180"/>
                        <ColumnDefinition Width="200"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                        <TextBlock Text="Contenido Neto" Margin="0,0,0,4"/>
                        <ui:TextBox x:Name="TxtContenidoValor" PlaceholderText="Ej: 100 o 1.5" TextChanged="Contenido_Changed"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="0,0,8,0">
                        <TextBlock Text="Unidad de Medida" Margin="0,0,0,4"/>
                        <ComboBox x:Name="CmbContenidoUnidad" SelectionChanged="Contenido_Changed">
                            <ComboBoxItem Content="Unidades (un)" Tag="UN" IsSelected="True"/>
                            <ComboBoxItem Content="Gramos (g)" Tag="G"/>
                            <ComboBoxItem Content="Kilogramos (kg)" Tag="KG"/>
                            <ComboBoxItem Content="Mililitros (ml)" Tag="ML"/>
                            <ComboBoxItem Content="Litros (L)" Tag="L"/>
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="12,0,0,0">
                        <TextBlock Text="Precio Unitario Referencial (Est.)" FontSize="11" Foreground="#607080" Margin="0,0,0,4"/>
                        <TextBlock x:Name="LblCalculoPrecioReferencia" Text="-" FontSize="16" FontWeight="SemiBold" Foreground="#80D4A0"/>
                    </StackPanel>
                </Grid>

                <TextBlock Text="Vencimiento y trazabilidad" FontWeight="SemiBold" FontSize="14" Margin="0,8,0,8"/>
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="200"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,12,0">
                        <TextBlock Text="Vencimiento (referencia)" Margin="0,0,0,4"/>
                        <DatePicker x:Name="DpVencimiento"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Vertical">
                        <TextBlock Text="Lotes, serie e IVA" Margin="0,0,0,6" Opacity="0.8" FontSize="12"/>
                        <CheckBox x:Name="ChkRequiereLote" Content="Requiere número de lote" Margin="0,0,0,4"/>
                        <CheckBox x:Name="ChkRequiereVenc" Content="Requiere fecha vencimiento en ingreso" Margin="0,0,0,4"/>
                        <CheckBox x:Name="ChkRequiereSerie" Content="Requiere número de serie" Margin="0,0,0,0"/>
                    </StackPanel>
                </Grid>

                <!-- Relación de Producto (Packs / Conversión de Stock) -->
                <Expander Header="Relación de Producto (Packs / Conversión de Stock)" Margin="0,0,0,12" HorizontalAlignment="Stretch">
                    <StackPanel Margin="0,8,0,0">
                        <TextBlock Text="Asocia este artículo a otro producto principal (ej. Lata de Cerveza) para que las ventas, remitos y conteos se descuenten/sumen de ese producto principal. La cantidad en stock de este artículo se calculará automáticamente." TextWrapping="Wrap" Foreground="#888888" FontSize="11" Margin="0,0,0,12"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="180"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                <TextBlock Text="Producto Principal (Padre)" Margin="0,0,0,4"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <ui:TextBox x:Name="TxtProductoPadre" PlaceholderText="Ninguno (Artículo independiente)" IsReadOnly="True" VerticalAlignment="Center"/>
                                    <ui:Button x:Name="BtnBuscarPadre" Grid.Column="1" Content="🔍 Buscar" Click="BtnBuscarPadre_Click" Margin="4,0,0,0" Height="36" VerticalAlignment="Center"/>
                                </Grid>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Multiplicador (Equivalencia)" Margin="0,0,0,4"/>
                                <ui:TextBox x:Name="TxtMultiplicador" PlaceholderText="Ej: 6, 12, 24" Text="1" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                        <ui:Button x:Name="BtnLimpiarPadre" Content="Quitar Relación" Click="BtnLimpiarPadre_Click" Margin="0,8,0,0" HorizontalAlignment="Left" Appearance="Secondary"/>
                    </StackPanel>
                </Expander>

                <!-- Opciones -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <CheckBox x:Name="ChkPesable" Grid.Column="0" Content="Es pesable" Margin="0,0,16,0" VerticalAlignment="Center"/>
                    <CheckBox x:Name="ChkActivo" Grid.Column="1" Content="Activo" IsChecked="True" Margin="0,0,16,0" VerticalAlignment="Center"/>
                    <CheckBox x:Name="ChkAplicaIva" Grid.Column="2" Content="Aplica IVA" IsChecked="True" Checked="Precio_Changed" Unchecked="Precio_Changed" VerticalAlignment="Center"/>
                </Grid>
            </StackPanel>
        </ScrollViewer>

        <!-- Botones -->
        <Grid Grid.Row="2" Margin="20,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Botones de Historial y Promociones (solo visibles para artículos existentes) -->
            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <ui:Button x:Name="BtnHistorial" Content="📊 Historial de Precios (F8)" 
                           Width="200" Height="36" Click="BtnHistorial_Click" Visibility="Collapsed" Margin="0,0,8,0"/>
                <ui:Button x:Name="BtnPromociones" Content="🏷 Promociones (F7)" 
                           Width="180" Height="36" Click="BtnPromociones_Click" Visibility="Collapsed"/>
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Button Content="Cancelar" Width="100" Height="36" Margin="0,0,8,0" Click="BtnCancelar_Click"/>
                <ui:Button Content="Guardar" Appearance="Primary" Width="120" Height="36" Click="BtnGuardar_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</ui:FluentWindow>
