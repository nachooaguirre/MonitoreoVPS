<ui:FluentWindow x:Class="SuperPOS.Client.Views.Stock.BonificacionesFechasWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Bonificaciones entre Fechas"
        Width="700" Height="480"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ExtendsContentIntoTitleBar="True">
    
    <Grid Background="#141414">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Barra de Título -->
        <ui:TitleBar x:Name="TitleBarCtrl" Grid.Row="0" Title="Bonificaciones entre Fechas"/>

        <!-- Contenido principal -->
        <Grid Grid.Row="1" Margin="20,10,20,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Articulo info -->
                <RowDefinition Height="*"/>    <!-- Grilla de promociones -->
            </Grid.RowDefinitions>

            <!-- Info del Artículo -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
                <TextBlock Text="Artículo:" Foreground="#809090" FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBlock x:Name="TxtArticuloNombre" Foreground="#FFF" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
            </StackPanel>

            <!-- Grilla de Promociones -->
            <Grid Grid.Row="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                
                <DataGrid x:Name="DgPromociones" Grid.Row="0" AutoGenerateColumns="False" IsReadOnly="True"
                          SelectionMode="Single" GridLinesVisibility="Horizontal" CanUserResizeRows="False"
                          BorderThickness="1" BorderBrush="#2A2A2A" Background="#1E1E1E" RowHeight="32" FontSize="12">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="50"/>
                        <DataGridTextColumn Header="Detalle" Binding="{Binding Detalle}" Width="*"/>
                        <DataGridTextColumn Header="Desde" Binding="{Binding FechaDesde, StringFormat=dd/MM/yyyy}" Width="100"/>
                        <DataGridTextColumn Header="Hasta" Binding="{Binding FechaHasta, StringFormat=dd/MM/yyyy}" Width="100"/>
                        <DataGridTextColumn Header="Descuento" Width="90">
                            <DataGridTextColumn.Binding>
                                <Binding Path="Porcentaje" StringFormat="N2"/>
                            </DataGridTextColumn.Binding>
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock"><Setter Property="HorizontalAlignment" Value="Right"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridCheckBoxColumn Header="Habilitada" Binding="{Binding Aplicado}" Width="90"/>
                    </DataGrid.Columns>
                </DataGrid>

                <TextBlock x:Name="TxtNoPromos" Grid.Row="0" Text="No se registran promociones por fecha para este artículo." 
                           Foreground="#607080" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
            </Grid>
        </Grid>

        <!-- Pie de página (Botones de Acción) -->
        <Border Grid.Row="2" Background="#1A1A1A" BorderThickness="0,1,0,0" BorderBrush="#2A2A2A" Padding="20,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Botones de Gestión -->
                <ui:Button Grid.Column="1" Content="➕ Agregar Promoción" Width="160" Height="34" Click="BtnAgregar_Click" Appearance="Primary" VerticalAlignment="Center"/>
                <ui:Button Grid.Column="3" Content="🗑 Quitar Selección" Width="140" Height="34" Click="BtnQuitar_Click" Appearance="Secondary" Foreground="#FF8080" VerticalAlignment="Center"/>

                <!-- Botón Salir -->
                <ui:Button Grid.Column="5" Content="Salir" Width="100" Height="34" Click="BtnSalir_Click" Appearance="Secondary" VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</ui:FluentWindow>
