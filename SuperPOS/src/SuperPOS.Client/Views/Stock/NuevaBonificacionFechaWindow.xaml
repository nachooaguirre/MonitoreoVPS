<ui:FluentWindow x:Class="SuperPOS.Client.Views.Stock.NuevaBonificacionFechaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Nueva Bonificación por Fecha"
        Width="420" Height="360"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ExtendsContentIntoTitleBar="True">
    
    <Grid Background="#141414">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Barra de Título -->
        <ui:TitleBar x:Name="TitleBarCtrl" Grid.Row="0" Title="Nueva Bonificación por Fecha"/>

        <!-- Contenido principal -->
        <StackPanel Grid.Row="1" Margin="24,16" Orientation="Vertical">
            
            <!-- Detalle -->
            <TextBlock Text="Detalle / Nombre *" Foreground="#809090" Margin="0,0,0,4" FontSize="12"/>
            <ui:TextBox x:Name="TxtDetalle" PlaceholderText="Ej: Promo Fin de Semana, Descuento Especial" Margin="0,0,0,12" Height="30"/>

            <!-- Rango de Fechas -->
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Fecha Desde *" Foreground="#809090" Margin="0,0,0,4" FontSize="12"/>
                    <DatePicker x:Name="DpDesde" Height="30"/>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="Fecha Hasta *" Foreground="#809090" Margin="0,0,0,4" FontSize="12"/>
                    <DatePicker x:Name="DpHasta" Height="30"/>
                </StackPanel>
            </Grid>

            <!-- Porcentaje y Estado -->
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Descuento % *" Foreground="#809090" Margin="0,0,0,4" FontSize="12"/>
                    <ui:TextBox x:Name="TxtPorcentaje" PlaceholderText="0.00" Height="30"/>
                </StackPanel>

                <StackPanel Grid.Column="1" VerticalAlignment="Bottom" Margin="24,0,0,6">
                    <CheckBox x:Name="ChkHabilitada" Content="Promoción Habilitada" IsChecked="True"/>
                </StackPanel>
            </Grid>

        </StackPanel>

        <!-- Pie de página (Botones de Guardado/Cancelación) -->
        <Border Grid.Row="2" Background="#1A1A1A" BorderThickness="0,1,0,0" BorderBrush="#2A2A2A" Padding="24,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="1" Content="Cancelar" Width="100" Height="34" Click="BtnCancelar_Click"/>
                <ui:Button Grid.Column="3" Content="Guardar" Appearance="Primary" Width="110" Height="34" Click="BtnGuardar_Click"/>
            </Grid>
        </Border>
    </Grid>
</ui:FluentWindow>
