<Page x:Class="SuperPOS.Client.Views.Stock.TrazabilidadPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="Trazabilidad de Productos" Background="#141414">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ===== ENCABEZADO Y BUSCADOR ===== -->
        <Border Grid.Row="0" Background="#1A1A1A" Padding="20,14" BorderThickness="0,0,0,1" BorderBrush="#2A2A2A">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="🔍" FontSize="24" Margin="0,0,12,0" VerticalAlignment="Center"/>
                    <StackPanel>
                        <TextBlock Text="Trazabilidad por Producto" FontSize="20" FontWeight="Bold" Foreground="#F0F0F0"/>
                        <TextBlock Text="Cronología completa e historial de movimientos del artículo" FontSize="11" Foreground="#607080"/>
                    </StackPanel>
                </StackPanel>

                <!-- Campo de búsqueda -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:TextBox x:Name="TxtBuscar" Width="280" Height="36" 
                             PlaceholderText="Buscar por código de barra o descripción..."
                             Foreground="#F0F0F0" Background="#252525"
                             BorderBrush="#3A3A3A" BorderThickness="1"
                             VerticalContentAlignment="Center" Padding="8,4"
                             KeyDown="TxtBuscar_KeyDown"/>
                    <ui:Button x:Name="BtnBuscar" Content="Buscar" Height="36" Margin="8,0,0,0" Padding="16,0"
                               Click="BtnBuscar_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===== CONTENIDO PRINCIPAL ===== -->
        <Grid Grid.Row="1" Margin="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- PANEL IZQUIERDO: Resultados / Información del producto -->
            <Grid Grid.Column="0" Margin="0,0,16,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- 1. Lista de selección de artículos (si hay múltiples resultados) -->
                <Border x:Name="PanelArticulos" Background="#1E1E1E" CornerRadius="8" Padding="14" BorderBrush="#2A2A2A" BorderThickness="1" Visibility="Collapsed">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="Seleccioná un artículo:" FontSize="13" FontWeight="SemiBold" Foreground="#A0A0A0" Margin="0,0,0,10"/>
                        <ListBox x:Name="LstArticulos" Grid.Row="1" Background="Transparent" BorderThickness="0"
                                 SelectionChanged="LstArticulos_SelectionChanged">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="4,2">
                                        <TextBlock Text="{Binding Descripcion}" FontSize="13" Foreground="#F0F0F0" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding CodigoBarras, StringFormat='EAN: {0}'}" FontSize="11" Foreground="#607080"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>

                <!-- 2. Información del Artículo Seleccionado -->
                <Border x:Name="PanelDetalleArticulo" Background="#1E1E1E" CornerRadius="8" Padding="16" BorderBrush="#2A2A2A" BorderThickness="1" Visibility="Collapsed" VerticalAlignment="Top">
                    <StackPanel>
                        <!-- Badge de estado -->
                        <Border Background="#1A2E3D" CornerRadius="4" HorizontalAlignment="Left" Padding="6,2" Margin="0,0,0,12">
                            <TextBlock Text="Artículo Activo" FontSize="10" FontWeight="Bold" Foreground="#60B0FF"/>
                        </Border>

                        <!-- Título y código -->
                        <TextBlock x:Name="TxtArtDescripcion" Text="Nombre del artículo" FontSize="18" FontWeight="Bold" Foreground="#F0F0F0" TextWrapping="Wrap" Margin="0,0,0,4"/>
                        <TextBlock x:Name="TxtArtCodigo" Text="EAN: --" FontSize="12" Foreground="#8090A0" Margin="0,0,0,16"/>

                        <Separator Background="#2D2D2D" Margin="0,0,0,16"/>

                        <!-- Métricas de Stock -->
                        <TextBlock Text="EXISTENCIAS" FontSize="11" FontWeight="Bold" Foreground="#506070" Margin="0,0,0,10"/>
                        
                        <Grid Margin="0,0,0,8">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📦" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Stock Total (Físico)" Foreground="#A0A8B0" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock x:Name="TxtStockActual" Text="0,00" FontSize="15" FontWeight="Bold" Foreground="#60D0A0" HorizontalAlignment="Right"/>
                        </Grid>
                        
                        <Grid Margin="0,0,0,16">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🏢" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Stock en Depósito" Foreground="#A0A8B0" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock x:Name="TxtStockDeposito" Text="0,00" FontSize="15" FontWeight="Bold" Foreground="#60C0FF" HorizontalAlignment="Right"/>
                        </Grid>

                        <Separator Background="#2D2D2D" Margin="0,0,0,16"/>
                        
                        <!-- Más datos -->
                        <Grid Margin="0,0,0,6">
                            <TextBlock Text="Precio Venta:" Foreground="#708090"/>
                            <TextBlock x:Name="TxtPrecioVenta" Text="$ 0,00" Foreground="#F0F0F0" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                        </Grid>
                        <Grid Margin="0,0,0,6">
                            <TextBlock Text="Costo Unitario:" Foreground="#708090"/>
                            <TextBlock x:Name="TxtPrecioCosto" Text="$ 0,00" Foreground="#F0F0F0" HorizontalAlignment="Right"/>
                        </Grid>
                        <Grid Margin="0,0,0,6">
                            <TextBlock Text="Stock Mínimo:" Foreground="#708090"/>
                            <TextBlock x:Name="TxtStockMinimo" Text="0,00" Foreground="#A08040" HorizontalAlignment="Right"/>
                        </Grid>
                    </StackPanel>
                </Border>
                
                <!-- 3. Estado de búsqueda inicial / vacío -->
                <Border x:Name="PanelMensajeInicio" Background="#181818" CornerRadius="8" Padding="20" BorderBrush="#2A2A2A" BorderThickness="1">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="🔍" FontSize="36" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                        <TextBlock Text="Buscá un producto por código de barras o palabras claves para ver su historial." 
                                   Foreground="#506070" FontSize="12.5" TextAlignment="Center" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- PANEL DERECHO: Línea de tiempo -->
            <Border Grid.Column="1" Background="#1A1A1A" CornerRadius="8" Padding="20" BorderBrush="#2A2A2A" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="Cronología de Eventos" FontSize="15" FontWeight="SemiBold" Foreground="#F0F0F0" Margin="0,0,0,14"/>

                    <!-- Mensaje si no hay artículo seleccionado o no hay eventos -->
                    <StackPanel x:Name="TxtNoEventos" Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="📅" FontSize="40" HorizontalAlignment="Center" Foreground="#333" Margin="0,0,0,10"/>
                        <TextBlock Text="Ningún historial cargado en pantalla" Foreground="#506070" FontSize="13" HorizontalAlignment="Center"/>
                    </StackPanel>

                    <!-- Scroll de la Línea de Tiempo -->
                    <ScrollViewer x:Name="ScrollTimeline" Grid.Row="1" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                        <Grid>
                            <!-- Línea central decorativa del timeline -->
                            <Rectangle Fill="#2A2A2A" Width="2" HorizontalAlignment="Left" Margin="22,10,0,10"/>

                            <ItemsControl x:Name="ItemsTimeline" Margin="0,0,8,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,18">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="46"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- 1. Nodo del Timeline (Icono) -->
                                            <Border Grid.Column="0" Width="30" Height="30" CornerRadius="15" 
                                                    VerticalAlignment="Top" HorizontalAlignment="Center"
                                                    BorderBrush="#1A1A1A" BorderThickness="2"
                                                    ToolTip="{Binding TipoTexto}">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Style.Triggers>
                                                            <!-- RecepcionDeposito (Tipo 0) -> Verde -->
                                                            <DataTrigger Binding="{Binding Tipo}" Value="0"><Setter Property="Background" Value="#103F20"/></DataTrigger>
                                                            <!-- ReposicionSala (Tipo 1) -> Azul -->
                                                            <DataTrigger Binding="{Binding Tipo}" Value="1"><Setter Property="Background" Value="#102A4A"/></DataTrigger>
                                                            <!-- VentaCaja (Tipo 3) -> Rojo/Naranja -->
                                                            <DataTrigger Binding="{Binding Tipo}" Value="3"><Setter Property="Background" Value="#4A1818"/></DataTrigger>
                                                            <!-- AnulacionVenta (Tipo 4) -> Amarillo/Marrón -->
                                                            <DataTrigger Binding="{Binding Tipo}" Value="4"><Setter Property="Background" Value="#3D2D10"/></DataTrigger>
                                                            <!-- Gasto/Merma (Otros) -> Gris -->
                                                            <DataTrigger Binding="{Binding Tipo}" Value="2"><Setter Property="Background" Value="#303030"/></DataTrigger>
                                                            <DataTrigger Binding="{Binding Tipo}" Value="5"><Setter Property="Background" Value="#303030"/></DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" 
                                                           Foreground="White">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Tipo}" Value="0"><Setter Property="Text" Value="📥"/></DataTrigger>
                                                                <DataTrigger Binding="{Binding Tipo}" Value="1"><Setter Property="Text" Value="📤"/></DataTrigger>
                                                                <DataTrigger Binding="{Binding Tipo}" Value="3"><Setter Property="Text" Value="🛒"/></DataTrigger>
                                                                <DataTrigger Binding="{Binding Tipo}" Value="4"><Setter Property="Text" Value="🔄"/></DataTrigger>
                                                                <DataTrigger Binding="{Binding Tipo}" Value="2"><Setter Property="Text" Value="⚠️"/></DataTrigger>
                                                                <DataTrigger Binding="{Binding Tipo}" Value="5"><Setter Property="Text" Value="⚠️"/></DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>

                                            <!-- 2. Contenido del Evento -->
                                            <Border Grid.Column="1" Background="#222222" CornerRadius="6" Padding="12,10" BorderBrush="#2D2D2D" BorderThickness="1">
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                    </Grid.RowDefinitions>

                                                    <!-- Fila Superior: Tipo de evento, Fecha y Cantidad -->
                                                    <Grid Grid.Row="0">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="{Binding TipoTexto}" FontWeight="Bold" Foreground="#FFFFFF" FontSize="13"/>
                                                            <TextBlock Text="{Binding FechaFormatted, StringFormat=' · {0}'}" Foreground="#607080" FontSize="11" VerticalAlignment="Center"/>
                                                        </StackPanel>

                                                        <Border Grid.Column="1" CornerRadius="4" Padding="6,2">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding EsPositivo}" Value="True"><Setter Property="Background" Value="#0F331A"/></DataTrigger>
                                                                        <DataTrigger Binding="{Binding EsPositivo}" Value="False"><Setter Property="Background" Value="#331A1A"/></DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <TextBlock FontSize="12" FontWeight="Bold">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding EsPositivo}" Value="True">
                                                                                <Setter Property="Text" Value="{Binding Cantidad, StringFormat='+{0:N2}'}"/>
                                                                                <Setter Property="Foreground" Value="#40D060"/>
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding EsPositivo}" Value="False">
                                                                                <Setter Property="Text" Value="{Binding Cantidad, StringFormat='{}{0:N2}'}"/>
                                                                                <Setter Property="Foreground" Value="#FF6060"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </Border>
                                                    </Grid>

                                                    <!-- Fila Inferior: Detalles -->
                                                    <StackPanel Grid.Row="1" Margin="0,4,0,0">
                                                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                            <TextBlock Text="Ubicación: " Foreground="#607080" FontSize="11.5"/>
                                                            <TextBlock Text="{Binding UbicacionVal}" Foreground="#B0C0D0" FontSize="11.5" FontWeight="SemiBold"/>
                                                            <TextBlock Text="  ·  Operador: " Foreground="#607080" FontSize="11.5" Margin="8,0,0,0"/>
                                                            <TextBlock Text="{Binding OperadorVal}" Foreground="#B0C0D0" FontSize="11.5"/>
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding Observaciones}" Foreground="#808890" FontSize="11" Margin="0,4,0,0" 
                                                                   TextWrapping="Wrap" FontStyle="Italic" Visibility="{Binding ObservacionesVis}"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
