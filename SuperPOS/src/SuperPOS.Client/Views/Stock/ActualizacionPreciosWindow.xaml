<ui:FluentWindow x:Class="SuperPOS.Client.Views.Stock.ActualizacionPreciosWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Actualización Masiva de Precios"
        Width="540" Height="500"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ExtendsContentIntoTitleBar="True">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ui:TitleBar x:Name="TitleBarCtrl" Grid.Row="0" Title="Actualización Masiva de Precios"/>

        <StackPanel Grid.Row="1" Margin="24,16">
            
            <!-- FILTROS -->
            <TextBlock Text="FILTRAR ARTÍCULOS" Foreground="#7AAAE0" FontWeight="Bold" FontSize="11" Margin="0,0,0,10"/>
            
            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Departamento" Foreground="#809090" Margin="0,0,0,4"/>
                    <ComboBox x:Name="CmbDepto" DisplayMemberPath="Nombre" SelectedValuePath="Id" Height="30" SelectionChanged="Filtro_Changed"/>
                </StackPanel>
                
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Familia" Foreground="#809090" Margin="0,0,0,4"/>
                    <ComboBox x:Name="CmbFamilia" DisplayMemberPath="Nombre" SelectedValuePath="Id" Height="30" SelectionChanged="Filtro_Changed"/>
                </StackPanel>
            </Grid>

            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Marca" Foreground="#809090" Margin="0,0,0,4"/>
                    <ComboBox x:Name="CmbMarca" DisplayMemberPath="Nombre" SelectedValuePath="Id" Height="30" SelectionChanged="Filtro_Changed"/>
                </StackPanel>
                
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Proveedor" Foreground="#809090" Margin="0,0,0,4"/>
                    <ComboBox x:Name="CmbProveedor" DisplayMemberPath="RazonSocial" SelectedValuePath="Id" Height="30" SelectionChanged="Filtro_Changed"/>
                </StackPanel>
            </Grid>

            <Separator Background="#333" Margin="0,0,0,14"/>

            <!-- VALORES DE AJUSTE -->
            <TextBlock Text="AJUSTE DE VALORES" Foreground="#7AAAE0" FontWeight="Bold" FontSize="11" Margin="0,0,0,10"/>

            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.5*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Campo a Modificar *" Foreground="#809090" Margin="0,0,0,4"/>
                    <ComboBox x:Name="CmbCampo" Height="30">
                        <ComboBoxItem Content="Costo Bruto" Tag="Costo" IsSelected="True"/>
                        <ComboBoxItem Content="Margen Ganancia" Tag="Margen"/>
                        <ComboBoxItem Content="Precio Venta Final" Tag="Venta"/>
                    </ComboBox>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="Método *" Foreground="#809090" Margin="0,0,0,4"/>
                    <ComboBox x:Name="CmbMetodo" Height="30">
                        <ComboBoxItem Content="Porcentaje %" Tag="Porcentaje" IsSelected="True"/>
                        <ComboBoxItem Content="Monto Fijo $" Tag="Fijo"/>
                    </ComboBox>
                </StackPanel>

                <StackPanel Grid.Column="4">
                    <TextBlock Text="Valor *" Foreground="#809090" Margin="0,0,0,4"/>
                    <ui:TextBox x:Name="TxtValor" PlaceholderText="0.00" Height="30"/>
                </StackPanel>
            </Grid>

            <!-- PREVIEW REPRODUCTIVA -->
            <Border Background="#252A30" Padding="12,10" CornerRadius="6" BorderBrush="#3D4D60" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="💡" FontSize="16" Margin="0,0,10,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TxtPreview" Grid.Column="1" Text="Se modificarán 0 artículos activos." Foreground="#80C0FF" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap"/>
                </Grid>
            </Border>

        </StackPanel>

        <!-- BOTONES -->
        <Border Grid.Row="2" Background="#1A1A1A" Padding="24,12" BorderThickness="0,1,0,0" BorderBrush="#2A2A2A">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <Button Grid.Column="1" Content="Cancelar" Width="100" Height="34" Click="BtnCancelar_Click"/>
                <Button Grid.Column="3" Content="Aplicar Cambios" Width="140" Height="34" FontWeight="Bold"
                        Background="#2A4A3A" Foreground="#80FFB0" BorderBrush="#3A6A50" BorderThickness="1"
                        Click="BtnAplicar_Click"/>
            </Grid>
        </Border>
    </Grid>
</ui:FluentWindow>
