<Page x:Class="SuperPOS.Client.Views.Configuracion.ConfiguracionPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="Configuración">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Encabezado -->
        <Border Grid.Row="0" Padding="20,14">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="⚙️" FontSize="22" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBlock Text="Configuración del Sistema" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <TextBlock x:Name="TxtEstado" Margin="16,0,0,0" VerticalAlignment="Center" Opacity="0.6" FontSize="13"/>
            </StackPanel>
        </Border>

        <!-- Contenido con tabs -->
        <ScrollViewer Grid.Row="1" Padding="20,0">
            <TabControl x:Name="Tabs" Margin="0,0,0,12">
                <!-- Tab: Empresa -->
                <TabItem Header="🏪  Empresa">
                    <StackPanel Margin="0,16,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,12">
                                <TextBlock Text="Razón Social / Nombre" Margin="0,0,0,4"/>
                                <ui:TextBox x:Name="TxtNombreEmpresa" PlaceholderText="Ej: Supermercado El Rey S.A."/>
                            </StackPanel>
                            <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,12">
                                <TextBlock Text="Nombre de Fantasía" Margin="0,0,0,4"/>
                                <ui:TextBox x:Name="TxtNombreFantasia" PlaceholderText="Ej: El Rey"/>
                            </StackPanel>

                            <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,0,12">
                                <TextBlock Text="CUIT" Margin="0,0,0,4"/>
                                <ui:TextBox x:Name="TxtCuit" PlaceholderText="00-00000000-0"/>
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,0,12">
                                <TextBlock Text="Ingresos Brutos" Margin="0,0,0,4"/>
                                <ui:TextBox x:Name="TxtIIBB" PlaceholderText="Número de IIBB"/>
                            </StackPanel>

                            <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,0,0,12">
                                <TextBlock Text="Dirección" Margin="0,0,0,4"/>
                                <ui:TextBox x:Name="TxtDireccion" PlaceholderText="Calle, número, piso..."/>
                            </StackPanel>

                            <StackPanel Grid.Row="3" Grid.Column="0" Margin="0,0,0,12">
                                <TextBlock Text="Localidad" Margin="0,0,0,4"/>
                                <ui:TextBox x:Name="TxtLocalidad" PlaceholderText="Ciudad"/>
                            </StackPanel>
                            <StackPanel Grid.Row="3" Grid.Column="2" Margin="0,0,0,12">
                                <TextBlock Text="Provincia" Margin="0,0,0,4"/>
                                <ui:TextBox x:Name="TxtProvincia" PlaceholderText="Buenos Aires"/>
                            </StackPanel>

                            <StackPanel Grid.Row="4" Grid.Column="0" Margin="0,0,0,12">
                                <TextBlock Text="Teléfono" Margin="0,0,0,4"/>
                                <ui:TextBox x:Name="TxtTelefono" PlaceholderText="0341-000000"/>
                            </StackPanel>
                            <StackPanel Grid.Row="4" Grid.Column="2" Margin="0,0,0,12">
                                <TextBlock Text="Email" Margin="0,0,0,4"/>
                                <ui:TextBox x:Name="TxtEmail" PlaceholderText="contacto@empresa.com"/>
                            </StackPanel>

                            <StackPanel Grid.Row="5" Grid.Column="0" Margin="0,0,0,12">
                                <TextBlock Text="Sitio Web" Margin="0,0,0,4"/>
                                <ui:TextBox x:Name="TxtSitioWeb" PlaceholderText="www.empresa.com"/>
                            </StackPanel>
                            <StackPanel Grid.Row="5" Grid.Column="2" Margin="0,0,0,12">
                                <TextBlock Text="Mensaje pie de ticket" Margin="0,0,0,4"/>
                                <ui:TextBox x:Name="TxtMensajePie" PlaceholderText="¡Gracias por su compra!"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </TabItem>

                <!-- Tab: AFIP / Facturación -->
                <TabItem Header="📄  AFIP">
                    <StackPanel Margin="0,16,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,12">
                                <TextBlock Text="Punto de Venta" Margin="0,0,0,4"/>
                                <ui:NumberBox x:Name="NumPuntoVenta" Minimum="1" Maximum="9999"/>
                            </StackPanel>
                            <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,12">
                                <TextBlock Text="Modo AFIP" Margin="0,0,0,4"/>
                                <ComboBox x:Name="CboAfipModo" SelectedIndex="0">
                                    <ComboBoxItem Content="Homologación (pruebas)"/>
                                    <ComboBoxItem Content="Producción (real)"/>
                                </ComboBox>
                            </StackPanel>

                            <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,0,0,12">
                                <TextBlock Text="Ruta del certificado AFIP (.pfx o .p12)" Margin="0,0,0,4"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <ui:TextBox x:Name="TxtCertificado" IsReadOnly="True" PlaceholderText="Sin certificado configurado" Grid.Column="0"/>
                                    <ui:Button Content="..." Grid.Column="1" Margin="4,0,0,0" Click="BtnSeleccionarCertificado_Click"/>
                                </Grid>
                            </StackPanel>

                            <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,0,12">
                                <TextBlock Text="Contraseña del certificado" Margin="0,0,0,4"/>
                                <ui:PasswordBox x:Name="TxtCertPassword" PlaceholderText="Contraseña del .pfx"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </TabItem>

                <!-- Tab: Impresoras -->
                <TabItem Header="🖨️  Impresoras">
                    <StackPanel Margin="0,16,0,0">
                        <TextBlock Text="Impresora Fiscal" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,10"/>
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Modelo" Margin="0,0,0,4"/>
                                <ComboBox x:Name="CboImpresoraFiscalModelo">
                                    <ComboBoxItem Content="(Sin impresora fiscal)"/>
                                    <ComboBoxItem Content="Hasar 330F"/>
                                    <ComboBoxItem Content="Hasar 441F"/>
                                    <ComboBoxItem Content="Epson TM-T900FA"/>
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Puerto" Margin="0,0,0,4"/>
                                <ComboBox x:Name="CboImpresoraFiscalPuerto">
                                    <ComboBoxItem Content="COM1"/>
                                    <ComboBoxItem Content="COM2"/>
                                    <ComboBoxItem Content="COM3"/>
                                    <ComboBoxItem Content="COM4"/>
                                    <ComboBoxItem Content="USB"/>
                                </ComboBox>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="Impresora de Tickets / Recibos" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,10"/>
                        <StackPanel Margin="0,0,0,12">
                            <TextBlock Text="Impresora Windows" Margin="0,0,0,4"/>
                            <ComboBox x:Name="CboImpresoraTicket"/>
                        </StackPanel>
                    </StackPanel>
                </TabItem>

                <!-- Tab: Sistema -->
                <TabItem Header="🔧  Sistema">
                    <StackPanel Margin="0,16,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,0,12">
                                <TextBlock Text="Controlar stock al vender" Margin="0,0,0,4"/>
                                <CheckBox x:Name="ChkControlaStock" Content="Activado"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Margin="0,0,0,12">
                                <TextBlock Text="Precios de venta con IVA incluido" Margin="0,0,0,4"/>
                                <CheckBox x:Name="ChkPrecioConIva" Content="Activado"/>
                            </StackPanel>
                        </Grid>
                        <StackPanel Margin="0,0,0,12">
                            <TextBlock Text="Carpeta de backup automático" Margin="0,0,0,4"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ui:TextBox x:Name="TxtBackupRuta" IsReadOnly="True" PlaceholderText="Sin configurar" Grid.Column="0"/>
                                <ui:Button Content="..." Grid.Column="1" Margin="4,0,0,0" Click="BtnSeleccionarBackup_Click"/>
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </TabItem>

                <!-- Tab: Pagos Integrados -->
                <TabItem Header="💳  Pagos Integrados">
                    <StackPanel Margin="0,16,0,0">
                        <TextBlock Text="Terminal Postnet (Ingenico Lane 3000)" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,10"/>
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Postnet integrado" Margin="0,0,0,4"/>
                                <CheckBox x:Name="ChkPosnetHabilitado" Content="Habilitar cobros integrados por Postnet"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Puerto COM de Conexión" Margin="0,0,0,4"/>
                                <ComboBox x:Name="CboPosnetPuerto">
                                    <ComboBoxItem Content="SIMULADOR"/>
                                    <ComboBoxItem Content="COM1"/>
                                    <ComboBoxItem Content="COM2"/>
                                    <ComboBoxItem Content="COM3"/>
                                    <ComboBoxItem Content="COM4"/>
                                    <ComboBoxItem Content="COM5"/>
                                </ComboBox>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="Mercado Pago QR (In-Store)" FontWeight="SemiBold" FontSize="14" Margin="0,8,0,10"/>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,12">
                                <TextBlock Text="Mercado Pago QR integrado" Margin="0,0,0,4"/>
                                <CheckBox x:Name="ChkMpqrHabilitado" Content="Habilitar cobros por QR dinámico"/>
                            </StackPanel>

                            <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,12">
                                <TextBlock Text="Access Token de Credenciales (Bearer)" Margin="0,0,0,4"/>
                                <ui:TextBox x:Name="TxtMpAccessToken" PlaceholderText="APP_USR-... (Vacío para Simulación)"/>
                            </StackPanel>

                            <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,0,12">
                                <TextBlock Text="ID de Colector (Collector ID)" Margin="0,0,0,4"/>
                                <ui:TextBox x:Name="TxtMpCollectorId" PlaceholderText="Ej: 12345678"/>
                            </StackPanel>

                            <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,0,12">
                                <TextBlock Text="ID de Sucursal (Store ID)" Margin="0,0,0,4"/>
                                <ui:TextBox x:Name="TxtMpStoreId" PlaceholderText="Ej: SUC001"/>
                            </StackPanel>

                            <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,0,12">
                                <TextBlock Text="ID de POS Externo (External POS ID)" Margin="0,0,0,4"/>
                                <ui:TextBox x:Name="TxtMpExternalPosId" PlaceholderText="Ej: CAJA01"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </TabItem>
            </TabControl>
        </ScrollViewer>

        <!-- Footer -->
        <Border Grid.Row="2" Padding="20,10" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock x:Name="TxtTestBalanza" Grid.Column="0" VerticalAlignment="Center" Opacity="0.7"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                    <ui:Button Content="⚖️  Probar balanza" Height="38" Padding="20,0" Margin="0,0,8,0" Click="BtnProbarBalanza_Click"/>
                    <ui:Button Content="📦  Leer PLUs cargados" Height="38" Padding="20,0" Margin="0,0,8,0" Click="BtnLeerPlusBalanza_Click"/>
                    <ui:Button x:Name="BtnGuardar" Content="💾  Guardar cambios" Appearance="Primary"
                               Height="38" Padding="20,0" Click="BtnGuardar_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Page>
