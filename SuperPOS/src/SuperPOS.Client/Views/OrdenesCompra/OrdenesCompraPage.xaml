<Page x:Class="SuperPOS.Client.Views.OrdenesCompra.OrdenesCompraPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="Órdenes de Compra" Background="#141414">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#1A1A1A" Padding="20,14" BorderThickness="0,0,0,1" BorderBrush="#2A2A2A">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="📋" FontSize="24" Margin="0,0,12,0"/>
                    <StackPanel>
                        <TextBlock Text="Órdenes de Compra" FontSize="20" FontWeight="Bold" Foreground="#F0F0FF"/>
                        <TextBlock Text="Gestión de pedidos a proveedores" FontSize="11" Foreground="#607080"/>
                    </StackPanel>
                </StackPanel>
                <ui:Button Grid.Column="1" Content="🔍 Sugerida por Stock" Height="36" Padding="14,0" Margin="0,0,8,0" Click="BtnSugerida_Click"/>
                <ui:Button Grid.Column="2" Content="+ Nueva OC" Height="36" Padding="16,0" Click="BtnNuevaOC_Click"/>
            </Grid>
        </Border>

        <!-- Filtros -->
        <Border Grid.Row="1" Background="#1E1E1E" Padding="14,10" Margin="16,12,16,0" CornerRadius="10">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Estado:" Foreground="#808090" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ComboBox x:Name="CboEstado" Height="32" Width="150" SelectionChanged="CboEstado_SelectionChanged">
                    <ComboBoxItem Content="Todos" IsSelected="True" Tag="{x:Null}"/>
                    <ComboBoxItem Content="Pendiente" Tag="0"/>
                    <ComboBoxItem Content="Borrador (IA)" Tag="5"/>
                    <ComboBoxItem Content="Enviada" Tag="1"/>
                    <ComboBoxItem Content="Recep. Parcial" Tag="2"/>
                    <ComboBoxItem Content="Recibida" Tag="3"/>
                    <ComboBoxItem Content="Anulada" Tag="4"/>
                </ComboBox>
                <ui:Button Content="🔄" Height="32" Width="36" Margin="8,0,0,0" Click="BtnRefresh_Click"/>
            </StackPanel>
        </Border>

        <!-- Grid -->
        <DataGrid x:Name="DgOrdenes" Grid.Row="2" Margin="16,12,16,0"
                  AutoGenerateColumns="False" IsReadOnly="True"
                  Background="#141414" Foreground="#D0E0FF" FontSize="13"
                  RowBackground="#1E1E1E" AlternatingRowBackground="#252525"
                  HorizontalGridLinesBrush="#333333" BorderThickness="0" RowHeight="40"
                  SelectionMode="Single" MouseDoubleClick="DgOrdenes_DoubleClick">
            <DataGrid.Columns>
                <DataGridTextColumn Header="N° OC" Binding="{Binding NroOrden, StringFormat='OC-{0:D6}'}" Width="100"/>
                <DataGridTextColumn Header="FECHA" Binding="{Binding Fecha, StringFormat='dd/MM/yyyy'}" Width="100"/>
                <DataGridTextColumn Header="PROVEEDOR" Binding="{Binding ProveedorNombre}" Width="*"/>
                <DataGridTemplateColumn Header="ESTADO" Width="130">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border CornerRadius="4" Padding="8,3" Margin="4" HorizontalAlignment="Left">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="#1E2A1E"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Estado}" Value="0"><Setter Property="Background" Value="#1A2530"/></DataTrigger>
                                            <DataTrigger Binding="{Binding Estado}" Value="1"><Setter Property="Background" Value="#1A1A1A"/></DataTrigger>
                                            <DataTrigger Binding="{Binding Estado}" Value="2"><Setter Property="Background" Value="#1E1E0A"/></DataTrigger>
                                            <DataTrigger Binding="{Binding Estado}" Value="3"><Setter Property="Background" Value="#0A1A0A"/></DataTrigger>
                                            <DataTrigger Binding="{Binding Estado}" Value="4"><Setter Property="Background" Value="#2A0A0A"/></DataTrigger>
                                            <DataTrigger Binding="{Binding Estado}" Value="5"><Setter Property="Background" Value="#1E1830"/></DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="{Binding EstadoNombre}" FontSize="11" FontWeight="Bold">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="#40D080"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Estado}" Value="0"><Setter Property="Foreground" Value="#60B4FF"/></DataTrigger>
                                                <DataTrigger Binding="{Binding Estado}" Value="1"><Setter Property="Foreground" Value="#C080FF"/></DataTrigger>
                                                <DataTrigger Binding="{Binding Estado}" Value="2"><Setter Property="Foreground" Value="#FFB040"/></DataTrigger>
                                                <DataTrigger Binding="{Binding Estado}" Value="4"><Setter Property="Foreground" Value="#FF5050"/></DataTrigger>
                                                <DataTrigger Binding="{Binding Estado}" Value="5"><Setter Property="Foreground" Value="#B080E8"/></DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="TOTAL" Binding="{Binding Total, StringFormat='$ #,##0.00'}" Width="130">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="#FFD060"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                            <Setter Property="HorizontalAlignment" Value="Right"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                            <Setter Property="Padding" Value="0,0,12,0"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Footer -->
        <Border Grid.Row="3" Background="#1A1A1A" Padding="16,10" Margin="16,8,16,0" CornerRadius="8">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Doble clic para ver detalle / recibir mercadería" FontSize="11" Foreground="#506070"/>
                <TextBlock x:Name="TxtTotalOC" FontSize="13" Foreground="#60B4FF" FontWeight="Bold" Margin="20,0,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</Page>
