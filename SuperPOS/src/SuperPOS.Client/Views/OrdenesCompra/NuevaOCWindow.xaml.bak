<Window x:Class="SuperPOS.Client.Views.OrdenesCompra.NuevaOCWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Nueva Orden de Compra" Width="1040" Height="680" MinWidth="920" MinHeight="560"
        WindowStartupLocation="CenterScreen" Background="#0F1218">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="Nueva orden de compra" FontSize="20" FontWeight="SemiBold" Foreground="#E8F0FF"/>
            <TextBlock Text="Editá cantidades, costos e IVA directamente en la grilla. El subtotal se actualiza solo."
                       FontSize="12" Foreground="#6A8AAA" Margin="0,4,0,0" TextWrapping="Wrap"/>
        </StackPanel>

        <!-- Cabecera -->
        <Border Grid.Row="1" Background="#1A2230" CornerRadius="12" Padding="16,14" Margin="0,0,0,14" BorderBrush="#2A3F5A" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="200"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="PROVEEDOR" FontSize="10" FontWeight="Bold" Foreground="#5A7AA0" Margin="0,0,0,6" />
                    <ComboBox x:Name="CboProveedor" Height="38" FontSize="13" Padding="8,4"
                              DisplayMemberPath="RazonSocial" SelectedValuePath="Id" SelectionChanged="CboProveedor_Changed"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="ENTREGA ESPERADA" FontSize="10" FontWeight="Bold" Foreground="#5A7AA0" Margin="0,0,0,6" />
                    <DatePicker x:Name="DpEntrega" Height="38" FontSize="13" SelectedDate="{x:Static sys:DateTime.Today}" xmlns:sys="clr-namespace:System;assembly=mscorlib"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Artículos: catálogo por proveedor + detalle OC -->
        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Barra agregar artículo -->
            <Border Grid.Row="0" Background="#1E2430" CornerRadius="10" Padding="12,10" Margin="0,0,0,10" BorderBrush="#2A3A4C" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="96"/>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="AGREGAR DESDE BÚSQUEDA (Enter)" FontSize="10" FontWeight="Bold" Foreground="#5A7AA0" Margin="0,0,0,4"/>
                        <ui:TextBox x:Name="TxtBuscarArt" PlaceholderText="Nombre, EAN o código interno del proveedor…" Height="36" KeyDown="TxtBuscarArt_KeyDown"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="10,0,8,0" VerticalAlignment="Bottom">
                        <TextBlock Text="CANT." FontSize="9" Foreground="#5A6A80" Margin="0,0,0,2"/>
                        <ui:TextBox x:Name="TxtCant" PlaceholderText="1" Height="36" Text="1"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Margin="0,0,8,0" VerticalAlignment="Bottom">
                        <TextBlock Text="COSTO (opcional)" FontSize="9" Foreground="#5A6A80" Margin="0,0,0,2"/>
                        <ui:TextBox x:Name="TxtCosto" PlaceholderText="Usa ficha" Height="36"/>
                    </StackPanel>
                    <ui:Button Grid.Column="3" Content="Agregar" Height="36" Padding="16,0" VerticalAlignment="Bottom" Click="BtnAgregar_Click"/>
                </Grid>
            </Border>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="280"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Background="#161C28" CornerRadius="10" Padding="12" BorderBrush="#2A3A4C" BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <StackPanel>
                            <TextBlock Text="Catálogo del proveedor" FontSize="12" FontWeight="SemiBold" Foreground="#7AB0E0"/>
                            <TextBlock Text="Doble clic o «Agregar seleccionado»" FontSize="10" Foreground="#5A6A80" Margin="0,2,0,0"/>
                        </StackPanel>
                        <ui:TextBox x:Name="TxtFiltroCatalogo" Grid.Row="1" Margin="0,8,0,8" Height="32" PlaceholderText="Filtrar en catálogo…" TextChanged="TxtFiltroCatalogo_TextChanged"/>
                        <ui:Button x:Name="BtnAgregarSeleccion" Grid.Row="2" Content="Agregar seleccionado" Margin="0,0,0,8" Height="34" Appearance="Secondary" Click="BtnAgregarSeleccion_Click"/>
                        <Grid Grid.Row="3" MinHeight="220">
                            <TextBlock x:Name="TxtCatalogoHint" TextWrapping="Wrap" Foreground="#6A7A90" FontSize="12" LineHeight="18"
                                       Text="Elegí un proveedor. Los artículos se toman del proveedor asignado en Stock → artículo." VerticalAlignment="Center" TextAlignment="Center" Padding="8"/>
                            <ListBox x:Name="LstCatalogo" Visibility="Collapsed" Background="#0E1218" BorderThickness="1" BorderBrush="#2A3A4C" Padding="4"
                                     MouseDoubleClick="LstCatalogo_MouseDoubleClick">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Vertical" Margin="0,2">
                                            <TextBlock Text="{Binding Descripcion}" TextWrapping="Wrap" Foreground="#D0D8E8" FontSize="12" FontWeight="SemiBold"/>
                                            <TextBlock Foreground="#6080A0" FontSize="10" Margin="0,2,0,0">
                                                <Run Text="EAN "/><Run Text="{Binding CodigoBarras, Mode=OneWay}"/><Run Text="  ·  "/><Run Text="{Binding CodigoInterno, Mode=OneWay}"/>
                                            </TextBlock>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Grid>
                </Border>

            <Border Grid.Column="2" Background="#141820" CornerRadius="12" BorderBrush="#2A4A6A" BorderThickness="1" ClipToBounds="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Background="#1A2638" Padding="14,10">
                        <TextBlock Text="Líneas de la orden (editar: doble clic, F2 o un clic lento en la celda)" FontSize="12" FontWeight="SemiBold" Foreground="#8EC8FF"/>
                    </Border>
            <DataGrid x:Name="DgDetalle" Grid.Row="1"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False" CanUserDeleteRows="False"
                      SelectionUnit="CellOrRowHeader"
                      GridLinesVisibility="Horizontal" HeadersVisibility="Column"
                      Background="#0E1218" Foreground="#E0E8F0" FontSize="13" BorderThickness="0"
                      RowBackground="#151B26" AlternatingRowBackground="#1A2230" AlternationCount="2"
                      HorizontalGridLinesBrush="#283448" RowHeight="42"
                      PreparingCellForEdit="DgDetalle_PreparingCellForEdit"
                      BeginningEdit="DgDetalle_BeginningEdit"
                      CellEditEnding="DgDetalle_CellEditEnding">
                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#1E2A3C"/>
                        <Setter Property="Foreground" Value="#8AA8C8"/>
                        <Setter Property="FontSize" Value="10"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                        <Setter Property="Padding" Value="10,8"/>
                        <Setter Property="BorderBrush" Value="#2A3A4C"/>
                        <Setter Property="BorderThickness" Value="0,0,1,1"/>
                    </Style>
                </DataGrid.ColumnHeaderStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="EAN / código" Binding="{Binding CodigoBarras}" Width="120" IsReadOnly="True">
                        <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="Foreground" Value="#8090A8"/><Setter Property="Padding" Value="8,0"/></Style></DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Descripción" Binding="{Binding Descripcion}" Width="*" MinWidth="120" IsReadOnly="True">
                        <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="Padding" Value="4,6"/><Setter Property="VerticalAlignment" Value="Center"/></Style></DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Cantidad" Width="96" IsReadOnly="False">
                        <DataGridTextColumn.Binding>
                            <Binding Path="CantidadPedida" Mode="TwoWay" UpdateSourceTrigger="PropertyChanged" StringFormat="N2"/>
                        </DataGridTextColumn.Binding>
                        <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="HorizontalAlignment" Value="Right"/><Setter Property="Padding" Value="8,0"/></Style></DataGridTextColumn.ElementStyle>
                        <DataGridTextColumn.EditingElementStyle><Style TargetType="TextBox"><Setter Property="HorizontalContentAlignment" Value="Right"/></Style></DataGridTextColumn.EditingElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Costo unit." Width="120" IsReadOnly="False">
                        <DataGridTextColumn.Binding>
                            <Binding Path="PrecioCosto" Mode="TwoWay" UpdateSourceTrigger="PropertyChanged" StringFormat="N2"/>
                        </DataGridTextColumn.Binding>
                        <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="Foreground" Value="#50D090"/><Setter Property="HorizontalAlignment" Value="Right"/><Setter Property="Padding" Value="8,0"/></Style></DataGridTextColumn.ElementStyle>
                        <DataGridTextColumn.EditingElementStyle><Style TargetType="TextBox"><Setter Property="HorizontalContentAlignment" Value="Right"/></Style></DataGridTextColumn.EditingElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="IVA %" Width="76" IsReadOnly="False">
                        <DataGridTextColumn.Binding>
                            <Binding Path="AlicuotaIva" Mode="TwoWay" UpdateSourceTrigger="PropertyChanged" StringFormat="N1"/>
                        </DataGridTextColumn.Binding>
                        <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="HorizontalAlignment" Value="Right"/><Setter Property="Padding" Value="8,0"/></Style></DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Subtotal" Width="120" IsReadOnly="True" Binding="{Binding Subtotal, StringFormat='{}{0:c}'}">
                        <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="Foreground" Value="#FFC860"/><Setter Property="FontWeight" Value="Bold"/><Setter Property="HorizontalAlignment" Value="Right"/><Setter Property="Padding" Value="8,0"/></Style></DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTemplateColumn Width="50" IsReadOnly="True">
                        <DataGridTemplateColumn.Header><TextBlock Text="Quitar" FontSize="9" HorizontalAlignment="Center"/></DataGridTemplateColumn.Header>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="✕" Foreground="#FF8888" Background="Transparent" BorderThickness="0" Cursor="Hand" ToolTip="Quitar línea" FontSize="14" Padding="4" Tag="{Binding}" Click="BtnQuitar_Click"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
                </Grid>
            </Border>
            </Grid>
        </Grid>

        <!-- Total -->
        <Border Grid.Row="3"
                CornerRadius="10" Padding="16,12" Margin="0,6,0,12" BorderBrush="#2A4A6A" BorderThickness="1">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#1A2434" Offset="0"/>
                    <GradientStop Color="#122030" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="TOTAL ORDEN" FontSize="11" Foreground="#6A8AA8" FontWeight="Bold" />
                    <TextBlock x:Name="TxtResumenLineas" Text="0 artículos" FontSize="12" Foreground="#8090A8" Margin="0,4,0,0"/>
                </StackPanel>
                <TextBlock x:Name="TxtTotal" Grid.Column="1" FontSize="28" FontWeight="Bold" Foreground="#FFC850" Text="$ 0,00" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="200"/></Grid.ColumnDefinitions>
            <Button Content="Cancelar" Height="44" FontSize="13" Background="#2A1A1A" Foreground="#E08080" BorderBrush="#5A2A2A" BorderThickness="1" Click="BtnCancelar_Click"/>
            <ui:Button Grid.Column="2" Content="Guardar orden" Appearance="Primary" Height="44" FontSize="14" FontWeight="Bold" Click="BtnGuardar_Click"/>
        </Grid>
    </Grid>
</Window>
