<Window x:Class="SuperPOS.Client.Views.OrdenesCompra.SugerenciaOCWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="OC Sugerida por Stock Bajo" Width="800" Height="620"
        WindowStartupLocation="CenterScreen" Background="#141414">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="🔍 Orden de Compra Sugerida por Stock Crítico"
                   FontSize="16" FontWeight="Bold" Foreground="#60B4FF" Margin="0,0,0,14"/>

        <!-- Selección de proveedor -->
        <Border Grid.Row="1" Background="#1E1E1E" CornerRadius="10" Padding="14,10" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Proveedor:" Foreground="#808090" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <ComboBox x:Name="CboProveedor" Width="300" Height="34" DisplayMemberPath="RazonSocial" SelectedValuePath="Id"/>
                <ui:Button Content="Ver artículos bajo mínimo" Margin="12,0,0,0" Height="34" Padding="14,0" Click="BtnVer_Click"/>
            </StackPanel>
        </Border>

        <!-- Totales -->
        <Border x:Name="PanelTotales" Grid.Row="1" Visibility="Collapsed" Background="#1C2030" CornerRadius="10" Padding="14,10" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Artículos:" Foreground="#607080" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <TextBlock x:Name="TxtCantItems" FontSize="16" FontWeight="Bold" Foreground="#60B4FF" VerticalAlignment="Center" Margin="0,0,16,0"/>
                <TextBlock Text="Total estimado:" Foreground="#607080" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <TextBlock x:Name="TxtTotalEst" FontSize="18" FontWeight="Bold" Foreground="#FFD060" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- Grid artículos sugeridos -->
        <DataGrid x:Name="DgItems" Grid.Row="2"
                  AutoGenerateColumns="False"
                  Background="#141414" Foreground="#D0E0FF" FontSize="13"
                  RowBackground="#1E1E1E" AlternatingRowBackground="#252525"
                  HorizontalGridLinesBrush="#333333" BorderThickness="0" RowHeight="38">
            <DataGrid.Columns>
                <DataGridCheckBoxColumn Width="40"/>
                <DataGridTextColumn Header="EAN" Binding="{Binding CodigoBarras}" Width="120"/>
                <DataGridTextColumn Header="Descripción" Binding="{Binding Descripcion}" Width="*"/>
                <DataGridTextColumn Header="Stock Act." Binding="{Binding StockActual, StringFormat='N1'}" Width="90">
                    <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="Foreground" Value="#FF5050"/><Setter Property="HorizontalAlignment" Value="Right"/><Setter Property="Padding" Value="0,0,8,0"/></Style></DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Mínimo" Binding="{Binding StockMinimo, StringFormat='N1'}" Width="80">
                    <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="Foreground" Value="#A08040"/><Setter Property="HorizontalAlignment" Value="Right"/><Setter Property="Padding" Value="0,0,8,0"/></Style></DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="A Pedir" Binding="{Binding CantidadSugerida, StringFormat='N0'}" Width="80">
                    <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="Foreground" Value="#FFB040"/><Setter Property="FontWeight" Value="Bold"/><Setter Property="HorizontalAlignment" Value="Right"/><Setter Property="Padding" Value="0,0,8,0"/></Style></DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Costo Unit." Binding="{Binding PrecioCosto, StringFormat='$ #,##0.00'}" Width="110">
                    <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="Foreground" Value="#60D0A0"/><Setter Property="HorizontalAlignment" Value="Right"/><Setter Property="Padding" Value="0,0,8,0"/></Style></DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Subtotal" Binding="{Binding SubtotalEstimado, StringFormat='$ #,##0.00'}" Width="120">
                    <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="Foreground" Value="#FFD060"/><Setter Property="FontWeight" Value="Bold"/><Setter Property="HorizontalAlignment" Value="Right"/><Setter Property="Padding" Value="0,0,8,0"/></Style></DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Botones -->
        <Grid Grid.Row="3" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="200"/>
            </Grid.ColumnDefinitions>
            <Button Content="Cancelar" Height="40" Background="#2A1A1A" Foreground="#FF7070" BorderBrush="#5A2A2A" BorderThickness="1" Click="BtnCancelar_Click"/>
            <ui:Button Grid.Column="2" x:Name="BtnCrear" Content="📋 Crear Orden de Compra" Appearance="Primary" Height="40" FontSize="14" FontWeight="Bold" IsEnabled="False" Click="BtnCrear_Click"/>
        </Grid>
    </Grid>
</Window>
