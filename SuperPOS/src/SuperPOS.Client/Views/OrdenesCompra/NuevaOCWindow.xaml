<Window x:Class="SuperPOS.Client.Views.OrdenesCompra.NuevaOCWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Nueva Orden de Compra" Width="1080" Height="700" MinWidth="980" MinHeight="600"
        WindowStartupLocation="CenterScreen" Background="#141414">
    <Grid Margin="18">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="380"/>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- COLUMNA IZQUIERDA: Catálogo de productos lateral -->
        <Border Grid.Column="0" Background="#1E1E1E" CornerRadius="12" Padding="14" BorderBrush="#2A2A2A" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,0,0,12">
                    <TextBlock Text="Catálogo del Proveedor" FontSize="14" FontWeight="SemiBold" Foreground="#6090A0"/>
                    <TextBlock Text="Doble clic o «Agregar seleccionado» para añadir." FontSize="10" Foreground="#607080" Margin="0,2,0,0"/>
                </StackPanel>

                <StackPanel Grid.Row="1" Margin="0,0,0,10">
                    <TextBlock Text="FILTRO PROVEEDOR (Opcional)" FontSize="10" FontWeight="Bold" Foreground="#607080" Margin="0,0,0,6"/>
                    <ComboBox x:Name="CboProveedor" Height="38" FontSize="13" Padding="8,4"
                              DisplayMemberPath="RazonSocial" SelectedValuePath="Id" SelectionChanged="CboProveedor_Changed"
                              Foreground="#F0F0F0" Background="#252525"/>
                </StackPanel>

                <ui:TextBox x:Name="TxtFiltroCatalogo" Grid.Row="2" Margin="0,0,0,10" Height="36" PlaceholderText="Filtrar en catálogo…" TextChanged="TxtFiltroCatalogo_TextChanged"/>

                <Grid Grid.Row="3" Margin="0,0,0,10">
                    <TextBlock x:Name="TxtCatalogoHint" TextWrapping="Wrap" Foreground="#607080" FontSize="12" LineHeight="18"
                               Text="Buscá arriba o elegí un proveedor para ver los productos acá." VerticalAlignment="Center" TextAlignment="Center" Padding="8"/>
                    <ListBox x:Name="LstCatalogo" Visibility="Collapsed" Background="#141414" BorderThickness="1" BorderBrush="#2A2A2A" Padding="4"
                             MouseDoubleClick="LstCatalogo_MouseDoubleClick">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Vertical" Margin="0,2">
                                    <TextBlock Text="{Binding Descripcion}" TextWrapping="Wrap" Foreground="#D0D8E0" FontSize="12" FontWeight="SemiBold"/>
                                    <TextBlock Foreground="#6090A0" FontSize="11" Margin="0,2,0,0" FontWeight="SemiBold">
                                        <Run Text="Marca:"/><Run Text=" "/><Run Text="{Binding Marca.Nombre}"/>
                                    </TextBlock>
                                    <TextBlock Foreground="#E0A040" FontSize="11" Margin="0,2,0,0" FontWeight="SemiBold">
                                        <Run Text="Prov:"/><Run Text=" "/><Run Text="{Binding Proveedor.RazonSocial}"/>
                                    </TextBlock>
                                    <TextBlock Foreground="#607080" FontSize="10" Margin="0,2,0,0">
                                        <Run Text="EAN "/><Run Text="{Binding CodigoBarras, Mode=OneWay}"/><Run Text="  ·  "/><Run Text="{Binding CodigoInterno, Mode=OneWay}"/>
                                    </TextBlock>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>

                <Button x:Name="BtnAgregarSeleccion" Grid.Row="4" Content="Agregar seleccionado al carrito" Height="38" 
                        Background="#1B3A2A" Foreground="#50D090" BorderBrush="#2A5A3A" BorderThickness="1" HorizontalAlignment="Stretch" Click="BtnAgregarSeleccion_Click"/>
            </Grid>
        </Border>

        <!-- COLUMNA DERECHA: Compositor de la orden actual -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Título e Instrucción -->
            <StackPanel Grid.Row="0" Margin="0,0,0,12">
                <TextBlock x:Name="TxtTitulo" Text="Nueva orden de compra" FontSize="20" FontWeight="SemiBold" Foreground="#D0D8E0"/>
                <TextBlock Text="Editá cantidades, costos e IVA directamente en la grilla. El subtotal se actualiza solo."
                           FontSize="12" Foreground="#607080" Margin="0,4,0,0" TextWrapping="Wrap"/>
            </StackPanel>

            <!-- Cabecera de Diferencias (Visible únicamente en correctivas) -->
            <Border x:Name="BrdDiferencias" Grid.Row="1" Background="#1E1E1E" CornerRadius="10" Padding="14,12" Margin="0,0,0,12" BorderBrush="#2A2A2A" BorderThickness="1" Visibility="Collapsed">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="230"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="MOTIVO / DIFERENCIA" FontSize="10" FontWeight="Bold" Foreground="#607080" Margin="0,0,0,4"/>
                        <ComboBox x:Name="CboMotivo" Height="36" FontSize="13" IsEditable="True" Foreground="#F0F0F0" Background="#252525">
                            <ComboBoxItem Content="Diferencia de envío (Faltante)"/>
                            <ComboBoxItem Content="Diferencia de envío (Excedente)"/>
                            <ComboBoxItem Content="Mercadería Dañada / Rota"/>
                            <ComboBoxItem Content="Error de Facturación / Precio"/>
                            <ComboBoxItem Content="Devolución de mercadería"/>
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="OBSERVACIONES" FontSize="10" FontWeight="Bold" Foreground="#607080" Margin="0,0,0,4"/>
                        <ui:TextBox x:Name="TxtObservaciones" Height="36" PlaceholderText="Observaciones adicionales sobre la diferencia de mercadería..."/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Barra agregar rápido -->
            <Border Grid.Row="2" Background="#1E1E1E" CornerRadius="10" Padding="12,10" Margin="0,0,0,10" BorderBrush="#2A2A2A" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="AGREGAR DESDE BÚSQUEDA RÁPIDA (Enter)" FontSize="10" FontWeight="Bold" Foreground="#607080" Margin="0,0,0,4"/>
                        <ui:TextBox x:Name="TxtBuscarArt" PlaceholderText="Nombre, EAN o código interno..." Height="36" KeyDown="TxtBuscarArt_KeyDown"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="10,0,8,0" VerticalAlignment="Bottom">
                        <TextBlock Text="CANT." FontSize="9" Foreground="#607080" Margin="0,0,0,2"/>
                        <Grid Height="36">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Button x:Name="BtnMinusCant" Content="-" Width="28" Height="36" Click="BtnMinusCant_Click"
                                    Background="#252525" Foreground="#F0F0F0" BorderBrush="#3A3A3A" BorderThickness="1,1,0,1"/>
                            <ui:TextBox x:Name="TxtCant" Grid.Column="1" Text="1" Height="36" TextAlignment="Center" VerticalContentAlignment="Center"
                                        BorderThickness="0,1,0,1" BorderBrush="#3A3A3A" GotFocus="TxtNumeric_GotFocus" PreviewTextInput="TxtNumeric_PreviewTextInput"/>
                            <Button x:Name="BtnPlusCant" Grid.Column="2" Content="+" Width="28" Height="36" Click="BtnPlusCant_Click"
                                    Background="#252525" Foreground="#F0F0F0" BorderBrush="#3A3A3A" BorderThickness="0,1,1,1"/>
                        </Grid>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Margin="0,0,8,0" VerticalAlignment="Bottom">
                        <TextBlock Text="COSTO (opcional)" FontSize="9" Foreground="#607080" Margin="0,0,0,2"/>
                        <ui:TextBox x:Name="TxtCosto" PlaceholderText="Usa ficha" Height="36" GotFocus="TxtNumeric_GotFocus" PreviewTextInput="TxtNumeric_PreviewTextInput"/>
                    </StackPanel>
                    <Button Grid.Column="3" Content="Buscar / Filtrar" Height="36" Padding="16,0" VerticalAlignment="Bottom" Background="#1B3A2A" Foreground="#50D090" BorderBrush="#2A5A3A" BorderThickness="1" Click="BtnAgregar_Click"/>
                </Grid>
            </Border>

            <!-- Grilla DgDetalle -->
            <Border Grid.Row="3" Background="#141414" CornerRadius="12" BorderBrush="#2A2A2A" BorderThickness="1" ClipToBounds="True" Margin="0,0,0,10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Background="#1E1E1E" Padding="14,10">
                        <TextBlock Text="Líneas de la orden (editar: doble clic, F2 o un clic lento en la celda)" FontSize="12" FontWeight="SemiBold" Foreground="#6090A0"/>
                    </Border>
                    <DataGrid x:Name="DgDetalle" Grid.Row="1"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False" CanUserDeleteRows="False"
                              SelectionUnit="CellOrRowHeader"
                              GridLinesVisibility="Horizontal" HeadersVisibility="Column"
                              Background="#141414" Foreground="#D0D8E0" FontSize="13" BorderThickness="0"
                              RowBackground="#1A1A1A" AlternatingRowBackground="#1E1E1E" AlternationCount="2"
                              HorizontalGridLinesBrush="#2A2A2A" RowHeight="40"
                              PreparingCellForEdit="DgDetalle_PreparingCellForEdit"
                              BeginningEdit="DgDetalle_BeginningEdit"
                              CellEditEnding="DgDetalle_CellEditEnding">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="EAN / código" Binding="{Binding CodigoBarras}" Width="110" IsReadOnly="True">
                                <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="Foreground" Value="#607080"/><Setter Property="Padding" Value="8,0"/></Style></DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Descripción" Binding="{Binding Descripcion}" Width="*" MinWidth="120" IsReadOnly="True">
                                <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="Padding" Value="4,6"/><Setter Property="VerticalAlignment" Value="Center"/></Style></DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Marca" Binding="{Binding MarcaNombre}" Width="90" IsReadOnly="True">
                                <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="Foreground" Value="#8090A0"/><Setter Property="Padding" Value="8,0"/></Style></DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Proveedor" Binding="{Binding ProveedorNombre}" Width="110" IsReadOnly="True">
                                <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="Foreground" Value="#8090A0"/><Setter Property="Padding" Value="8,0"/></Style></DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Cantidad" Width="85" IsReadOnly="False">
                                <DataGridTextColumn.Binding>
                                    <Binding Path="CantidadPedida" Mode="TwoWay" UpdateSourceTrigger="PropertyChanged" StringFormat="N2"/>
                                </DataGridTextColumn.Binding>
                                <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="HorizontalAlignment" Value="Right"/><Setter Property="Padding" Value="8,0"/></Style></DataGridTextColumn.ElementStyle>
                                <DataGridTextColumn.EditingElementStyle><Style TargetType="TextBox"><Setter Property="HorizontalContentAlignment" Value="Right"/></Style></DataGridTextColumn.EditingElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Costo unit." Width="100" IsReadOnly="False">
                                <DataGridTextColumn.Binding>
                                    <Binding Path="PrecioCosto" Mode="TwoWay" UpdateSourceTrigger="PropertyChanged" StringFormat="N2"/>
                                </DataGridTextColumn.Binding>
                                <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="Foreground" Value="#40C060"/><Setter Property="HorizontalAlignment" Value="Right"/><Setter Property="Padding" Value="8,0"/></Style></DataGridTextColumn.ElementStyle>
                                <DataGridTextColumn.EditingElementStyle><Style TargetType="TextBox"><Setter Property="HorizontalContentAlignment" Value="Right"/></Style></DataGridTextColumn.EditingElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="IVA %" Width="65" IsReadOnly="False">
                                <DataGridTextColumn.Binding>
                                    <Binding Path="AlicuotaIva" Mode="TwoWay" UpdateSourceTrigger="PropertyChanged" StringFormat="N1"/>
                                </DataGridTextColumn.Binding>
                                <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="HorizontalAlignment" Value="Right"/><Setter Property="Padding" Value="8,0"/></Style></DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Subtotal" Width="105" IsReadOnly="True" Binding="{Binding Subtotal, StringFormat='{}{0:c}'}">
                                <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="Foreground" Value="#E0A040"/><Setter Property="FontWeight" Value="Bold"/><Setter Property="HorizontalAlignment" Value="Right"/><Setter Property="Padding" Value="8,0"/></Style></DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTemplateColumn Width="50" IsReadOnly="True">
                                <DataGridTemplateColumn.Header><TextBlock Text="Quitar" FontSize="9" HorizontalAlignment="Center"/></DataGridTemplateColumn.Header>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="✕" Foreground="#FF8888" Background="Transparent" BorderThickness="0" Cursor="Hand" ToolTip="Quitar línea" FontSize="14" Padding="4" Tag="{Binding}" Click="BtnQuitar_Click"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- Proveedores y Total -->
            <Grid Grid.Row="4" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="320" />
                </Grid.ColumnDefinitions>
                <!-- Proveedores a Ordenar -->
                <Border Background="#1E1E1E" CornerRadius="10" BorderBrush="#2A2A2A" BorderThickness="1" Padding="10" Height="110">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="Proveedores incluidos (se creará una orden por cada uno)" FontSize="11" FontWeight="SemiBold" Foreground="#6090A0" Margin="0,0,0,4"/>
                        <DataGrid x:Name="DgProveedores" Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                                  Background="Transparent" RowBackground="#1A1A1A" AlternatingRowBackground="#1E1E1E" RowHeight="34"
                                  BorderThickness="0" HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#2A2A2A">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Proveedor" Binding="{Binding RazonSocial}" Width="*" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Reparto (días)" Binding="{Binding DiasEntrega}" Width="90" IsReadOnly="False">
                                    <DataGridTextColumn.EditingElementStyle><Style TargetType="TextBox"><Setter Property="HorizontalContentAlignment" Value="Right"/></Style></DataGridTextColumn.EditingElementStyle>
                                </DataGridTextColumn>
                                <DataGridTemplateColumn Header="Entrega" Width="105">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <DatePicker SelectedDate="{Binding FechaEsperada, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Background="Transparent" BorderThickness="0"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>

                <!-- Total -->
                <Border Grid.Column="2" Background="#1E1E1E" CornerRadius="10" Padding="16,12" BorderBrush="#2A2A2A" BorderThickness="1" Height="110">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="TOTAL GLOBAL" FontSize="11" Foreground="#607080" FontWeight="Bold"/>
                            <TextBlock x:Name="TxtResumenLineas" Text="0 artículos" FontSize="12" Foreground="#607080" Margin="0,4,0,0"/>
                        </StackPanel>
                        <TextBlock x:Name="TxtTotal" Grid.Column="1" FontSize="28" FontWeight="Bold" Foreground="#40D080" Text="$ 0,00" VerticalAlignment="Center"/>
                    </Grid>
                </Border>
            </Grid>

            <!-- Botones Guardar / Cancelar -->
            <Grid Grid.Row="5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="200"/>
                </Grid.ColumnDefinitions>
                <Button Content="Cancelar" Height="44" FontSize="13" Background="#3A1A1A" Foreground="#FF8888" BorderBrush="#6A2A2A" BorderThickness="1" Click="BtnCancelar_Click"/>
                <Button Grid.Column="2" Content="Guardar orden" Height="44" FontSize="14" FontWeight="Bold" Background="#1B3A2A" Foreground="#50D090" BorderBrush="#2A5A3A" BorderThickness="1" Click="BtnGuardar_Click"/>
            </Grid>
        </Grid>
    </Grid>
</Window>
