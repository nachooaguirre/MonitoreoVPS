<Window x:Class="SuperPOS.Client.Views.OrdenesCompra.DetalleOCWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Detalle Orden de Compra" Width="860" Height="620"
        WindowStartupLocation="CenterScreen" Background="#141414">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header con estado -->
        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock x:Name="TxtTitulo" Text="Orden de Compra" FontSize="20" FontWeight="Bold" Foreground="#D0D8E0"/>
                <TextBlock x:Name="TxtProveedor" FontSize="13" Foreground="#6090A0" Margin="0,2,0,0"/>
            </StackPanel>
            <Border Grid.Column="1" x:Name="BrdEstado" CornerRadius="6" Padding="14,6" VerticalAlignment="Center">
                <TextBlock x:Name="TxtEstado" FontSize="13" FontWeight="Bold"/>
            </Border>
        </Grid>

        <!-- Info cabecera -->
        <Border Grid.Row="1" Background="#1E1E1E" CornerRadius="8" Padding="16,12" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="FECHA EMISIÓN" FontSize="10" FontWeight="Bold" Foreground="#607080"/>
                    <TextBlock x:Name="TxtFecha" FontSize="14" FontWeight="SemiBold" Foreground="#D0D8E0" Margin="0,3,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="FECHA ENTREGA" FontSize="10" FontWeight="Bold" Foreground="#607080"/>
                    <TextBlock x:Name="TxtFechaEntrega" FontSize="14" FontWeight="SemiBold" Foreground="#D0D8E0" Margin="0,3,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="FECHA RECEPCIÓN" FontSize="10" FontWeight="Bold" Foreground="#607080"/>
                    <TextBlock x:Name="TxtFechaRecepcion" FontSize="14" FontWeight="SemiBold" Foreground="#40C060" Margin="0,3,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="3">
                    <TextBlock Text="TOTAL OC" FontSize="10" FontWeight="Bold" Foreground="#607080"/>
                    <TextBlock x:Name="TxtTotal" FontSize="18" FontWeight="Bold" Foreground="#60D090" Margin="0,2,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Tabla de artículos -->
        <DataGrid x:Name="DgDetalle" Grid.Row="2"
                  AutoGenerateColumns="False" IsReadOnly="True"
                  Background="#141414" Foreground="#D0D8E0" FontSize="13"
                  RowBackground="#1A1A1A" AlternatingRowBackground="#1E1E1E"
                  HorizontalGridLinesBrush="#2A2A2A" BorderThickness="0" RowHeight="40"
                  SelectionMode="Single">
            <DataGrid.Columns>
                <DataGridTextColumn Header="EAN" Binding="{Binding CodigoBarras}" Width="120">
                    <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="Foreground" Value="#607080"/><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Padding" Value="8,0"/></Style></DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="DESCRIPCIÓN" Binding="{Binding Descripcion}" Width="*">
                    <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Padding" Value="8,0"/></Style></DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="PEDIDO" Binding="{Binding CantidadPedida, StringFormat='N0'}" Width="80">
                    <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="HorizontalAlignment" Value="Right"/><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Padding" Value="0,0,10,0"/></Style></DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="RECIBIDO" Binding="{Binding CantidadRecibida, StringFormat='N0'}" Width="90">
                    <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="Foreground" Value="#40C060"/><Setter Property="FontWeight" Value="Bold"/><Setter Property="HorizontalAlignment" Value="Right"/><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Padding" Value="0,0,10,0"/></Style></DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="P. COSTO" Binding="{Binding PrecioCosto, StringFormat='$ #,##0.00'}" Width="110">
                    <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="Foreground" Value="#60A080"/><Setter Property="HorizontalAlignment" Value="Right"/><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Padding" Value="0,0,10,0"/></Style></DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="IVA %" Binding="{Binding AlicuotaIva, StringFormat='N0'}" Width="65">
                    <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="Foreground" Value="#708080"/><Setter Property="HorizontalAlignment" Value="Center"/><Setter Property="VerticalAlignment" Value="Center"/></Style></DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="SUBTOTAL" Binding="{Binding Subtotal, StringFormat='$ #,##0.00'}" Width="110">
                    <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="Foreground" Value="#80C0A0"/><Setter Property="FontWeight" Value="Bold"/><Setter Property="HorizontalAlignment" Value="Right"/><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Padding" Value="0,0,10,0"/></Style></DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Totales -->
        <Border Grid.Row="3" Background="#1A2030" CornerRadius="6" Padding="16,10" Margin="0,10,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="TxtCantItems" FontSize="12" Foreground="#607080"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <TextBlock Text="Subtotal sin IVA:" FontSize="12" Foreground="#607080" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock x:Name="TxtSinIva" FontSize="13" Foreground="#A0C0B0" VerticalAlignment="Center" Margin="0,0,16,0"/>
                    <TextBlock Text="IVA:" FontSize="12" Foreground="#607080" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock x:Name="TxtIva" FontSize="13" Foreground="#A0C0B0" VerticalAlignment="Center" Margin="0,0,20,0"/>
                    <TextBlock Text="TOTAL:" FontSize="14" FontWeight="Bold" Foreground="#809090" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock x:Name="TxtTotalPie" FontSize="20" FontWeight="Bold" Foreground="#40D080" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Botones -->
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button x:Name="BtnAnular" Content="✖  Anular OC" Height="38" Padding="16,0"
                    Foreground="#FF6060" BorderBrush="#5A2020" BorderThickness="1"
                    Click="BtnAnular_Click"/>
            <Button Grid.Column="2" x:Name="BtnEditar" Content="✏️ Editar OC" Height="38" Padding="16,0"
                    Background="#2A2A3A" Foreground="#D0E0FF" BorderBrush="#40405A" BorderThickness="1"
                    Click="BtnEditar_Click"/>
            <Button Grid.Column="4" x:Name="BtnRecibir" Content="📦  Recibir Mercadería" Height="38" Padding="16,0"
                    Background="#1A3A28" Foreground="#40D080" BorderBrush="#2A5038" BorderThickness="1"
                    Click="BtnRecibir_Click"/>
            <Button Grid.Column="6" Content="🖨  Imprimir" Height="38" Padding="14,0"
                    Background="#2A2A38" Foreground="#D0E0FF" BorderBrush="#404058" BorderThickness="1"
                    Click="BtnImprimir_Click"/>
            <Button Grid.Column="8" Content="📥  PDF" Height="38" Padding="14,0"
                    Background="#3A2A2A" Foreground="#FFD0D0" BorderBrush="#584040" BorderThickness="1"
                    Click="BtnPdf_Click"/>
            <Button Grid.Column="10" Content="✉  Email proveedor" Height="38" Padding="14,0"
                    Background="#2A2838" Foreground="#B0C8FF" BorderBrush="#404058" BorderThickness="1"
                    ToolTip="Abre el cliente de correo predeterminado (mailto). El proveedor debe tener email cargado."
                    Click="BtnEmail_Click"/>
            <Button Grid.Column="12" Content="📄  Exportar TXT" Height="38" Padding="14,0"
                    Background="#282828" Foreground="#C0C0C0" BorderBrush="#444" BorderThickness="1"
                    Click="BtnExportarTxt_Click"/>
            <Button Grid.Column="14" Content="Cerrar" Height="38" Width="110" Click="BtnCerrar_Click"/>
        </Grid>
    </Grid>
</Window>
