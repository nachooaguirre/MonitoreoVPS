<Page x:Class="SuperPOS.Client.Views.Compras.ListasPrecioProveedorPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="Tarifas de proveedor" Background="#141414">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#1A1A1A" Padding="20,14" BorderThickness="0,0,0,1" BorderBrush="#2A2A2A">
            <StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="📑" FontSize="24" Margin="0,0,12,0" VerticalAlignment="Center"/>
                    <StackPanel>
                        <TextBlock Text="Listas de precio de proveedores" FontSize="20" FontWeight="Bold" Foreground="#F0F0FF"/>
                        <TextBlock FontSize="11" Foreground="#607080" TextWrapping="Wrap" LineHeight="16">
                            <Run Text="Importá la tarifa (Excel, PDF, imagen, texto de WhatsApp): la IA arma filas de precio e IVA para comparar y pedir. "/>
                            <Run Text="No se crean artículos ni stock automáticamente: el stock es solo lo físico que ingresás por compras, remitos o movimientos; los productos nuevos van en Artículos y el vínculo acá es con &quot;Vincular artículos&quot;." FontWeight="SemiBold"/>
                        </TextBlock>
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Background="#1E1E1E" Padding="12,10" Margin="16,12,16,0" CornerRadius="10">
            <StackPanel>
                <TextBlock Text="Nueva importación" FontWeight="SemiBold" Foreground="#A0B0C0" Margin="0,0,0,6"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                        <TextBlock Text="Proveedor" Foreground="#708090" FontSize="10"/>
                        <ComboBox x:Name="CboProveedorImport" Height="32" DisplayMemberPath="RazonSocial" SelectedValuePath="Id"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="0,0,8,0">
                        <TextBlock Text="Nombre de la lista" Foreground="#708090" FontSize="10"/>
                        <TextBox x:Name="TxtNombreLista" Height="32" VerticalContentAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Margin="0,0,0,0">
                        <TextBlock Text="Archivo" Foreground="#708090" FontSize="10"/>
                        <DockPanel>
                            <ui:Button DockPanel.Dock="Right" Content="Examinar…" Height="32" Click="BtnExaminar_Click" Margin="6,0,0,0"/>
                            <TextBox x:Name="TxtRutaArchivo" Height="32" VerticalContentAlignment="Center" IsReadOnly="True"/>
                        </DockPanel>
                    </StackPanel>
                </Grid>
                <TextBlock Text="O pegar texto (WhatsApp, copia de Excel, etc.)" Foreground="#708090" FontSize="10" Margin="0,6,0,2"/>
                <TextBox x:Name="TxtPegadoLista" MinHeight="56" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                         Background="#252525" Foreground="#D0E0F0" BorderBrush="#3A3A3A" Padding="8" FontSize="11"/>
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <ui:Button x:Name="BtnImportar" Content="⬆ Subir o importar pegado" Height="36" Padding="16,0" Click="BtnImportar_Click" Margin="0,0,8,0"/>
                    <TextBlock x:Name="TxtEstadoImport" Foreground="#8090A0" VerticalAlignment="Center" TextWrapping="Wrap"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <TextBlock Text="Filtrar listas:" Foreground="#808090" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ComboBox x:Name="CboFiltroProveedor" Height="32" MinWidth="220" DisplayMemberPath="RazonSocial" SelectedValuePath="Id"
                              SelectionChanged="CboFiltroProveedor_SelectionChanged" Margin="0,0,8,0"/>
                    <ui:Button Content="🔄 Actualizar" Height="32" Click="BtnRefrescar_Click"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <Grid Grid.Row="2" Margin="16,12,16,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0.38*"/>
                <ColumnDefinition Width="0.62*"/>
            </Grid.ColumnDefinitions>

            <DataGrid x:Name="DgListas" Grid.Column="0" AutoGenerateColumns="False" IsReadOnly="True"
                      SelectionMode="Single" SelectionUnit="FullRow" Margin="0,0,8,0"
                      Background="#1A1A1A" Foreground="#D0E0FF" RowBackground="#1E1E1E" AlternatingRowBackground="#252525"
                      BorderThickness="0" RowHeight="36" CanUserAddRows="False" SelectionChanged="DgListas_SelectionChanged">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="48"/>
                    <DataGridTextColumn Header="NOMBRE" Binding="{Binding Nombre}" Width="*"/>
                    <DataGridTextColumn Header="LÍN." Binding="{Binding LineasCount}" Width="44"/>
                    <DataGridTextColumn Header="CARGA" Binding="{Binding FechaCargaUtc, StringFormat=dd/MM HH:mm}" Width="100"/>
                </DataGrid.Columns>
            </DataGrid>

            <Border Grid.Column="1" Background="#1A1A1A" BorderBrush="#2A2A2A" BorderThickness="1" CornerRadius="8" Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="160"/>
                    </Grid.RowDefinitions>

                    <TextBlock x:Name="TxtDetalleTitulo" Text="Seleccioná una lista a la izquierda." Foreground="#C0C8D0" FontSize="14" TextWrapping="Wrap"/>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,8,0,8" x:Name="PanelAcciones" Visibility="Collapsed">
                        <ui:Button Content="🔗 Matchear códigos" Height="32" Click="BtnMatchear_Click" Margin="0,0,6,0"/>
                        <TextBlock Text="Días:" Foreground="#8090A0" VerticalAlignment="Center" Margin="6,0,4,0"/>
                        <TextBox x:Name="TxtDiasProy" Text="10" Width="40" Height="28" VerticalContentAlignment="Center"/>
                        <TextBlock Text="Nota p/ IA:" Foreground="#8090A0" VerticalAlignment="Center" Margin="8,0,4,0"/>
                        <TextBox x:Name="TxtInstruccionIa" Width="180" Height="28" VerticalContentAlignment="Center" ToolTip="Ej. priorizar ofertas por volumen"/>
                        <ui:Button Content="🤖 Recomendar (IA)" Height="32" Click="BtnRecomendarIa_Click" Margin="6,0,6,0"/>
                        <ui:Button Content="🛒 Nueva OC con vinculados" Height="32" Click="BtnNuevaOc_Click" Margin="0,0,6,0"/>
                        <ui:Button Content="Borrar lista" Height="32" Appearance="Secondary" Click="BtnBorrarLista_Click"/>
                    </StackPanel>

                    <DataGrid x:Name="DgLineas" Grid.Row="2" AutoGenerateColumns="False"
                              IsReadOnly="False" CanUserAddRows="False" CellEditEnding="DgLineas_CellEditEnding"
                              Background="#181818" Foreground="#E0E8F0" RowBackground="#1E1E1E" AlternatingRowBackground="#222830"
                              BorderThickness="0" RowHeight="34" MinHeight="120"
                              Visibility="Collapsed" BeginningEdit="DgLineas_BeginningEdit" HeadersVisibility="Column">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Cód. prov." Binding="{Binding CodigoProveedor, UpdateSourceTrigger=PropertyChanged}" Width="80"/>
                            <DataGridTextColumn Header="Descripción" Binding="{Binding Descripcion, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                            <DataGridTextColumn Header="P. unit." Binding="{Binding PrecioUnitario, StringFormat=F4}" Width="80"/>
                            <DataGridTextColumn Header="IVA %" Binding="{Binding IvaPorcentaje, TargetNullValue=''}" Width="50"/>
                            <DataGridTextColumn Header="Bonif. (JSON)" Binding="{Binding BonificacionesJson, UpdateSourceTrigger=PropertyChanged}" Width="200"/>
                            <DataGridTextColumn Header="Id art." Binding="{Binding IdArticulo, TargetNullValue=''}" Width="56"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <TextBlock Grid.Row="3" x:Name="TxtHintLineas" Text="Sugerencia: reordená o corregí precios; el JSON de bonif. es p. ej. [{&quot;cantidadMin&quot;:12,&quot;porcentaje&quot;:5}]." 
                               Foreground="#506070" FontSize="10" TextWrapping="Wrap" Margin="0,4,0,0" Visibility="Collapsed"/>

                    <Border Grid.Row="4" Background="#101418" BorderBrush="#2A2A2A" BorderThickness="0,1,0,0" Padding="6" x:Name="BordeIa" Visibility="Collapsed">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="Recomendación IA" FontWeight="Bold" Foreground="#7AB0E0" Margin="0,0,0,4"/>
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                <TextBlock x:Name="TxtRecomIa" TextWrapping="Wrap" Foreground="#B8C4D0" FontSize="12"/>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
