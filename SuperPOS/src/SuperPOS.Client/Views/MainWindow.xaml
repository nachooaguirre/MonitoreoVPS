<ui:FluentWindow x:Class="SuperPOS.Client.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Los Angeles Supermercados — SuperPOS"
        MinWidth="1280" MinHeight="720"
        WindowStartupLocation="CenterScreen"
        ExtendsContentIntoTitleBar="True">
    <Window.Resources>
        <!-- Botón de navegación con template propio para forzar color visible -->
        <Style x:Key="NavBtn" TargetType="Button">
            <Setter Property="FocusVisualStyle"     Value="{x:Null}"/>
            <Setter Property="Background"           Value="#1A1A1A"/>
            <Setter Property="Foreground"           Value="#D0D8E0"/>
            <Setter Property="BorderThickness"      Value="0"/>
            <Setter Property="HorizontalAlignment"  Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Height"               Value="38"/>
            <Setter Property="FontSize"             Value="13.5"/>
            <Setter Property="Cursor"               Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="7" Padding="12,0" Margin="4,2"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"
                                              TextElement.FontSize="{TemplateBinding FontSize}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2A2A2A"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2A2A2A"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#333333"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#404040"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Botón activo (seleccionado) -->
        <Style x:Key="NavBtnActive" TargetType="Button" BasedOn="{StaticResource NavBtn}">
            <Setter Property="Background" Value="#2A3A4A"/>
            <Setter Property="Foreground" Value="#60C0FF"/>
        </Style>

        <!-- Label de sección -->
        <Style x:Key="NavSection" TargetType="TextBlock">
            <Setter Property="Foreground"  Value="#506070"/>
            <Setter Property="FontSize"    Value="10"/>
            <Setter Property="FontWeight"  Value="Bold"/>
            <Setter Property="Margin"      Value="16,12,0,4"/>
        </Style>

        <!-- Campana: sin marco de botón del tema, solo icono -->
        <Style x:Key="BarIconBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Ibd" Background="Transparent" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Ibd" Property="Background" Value="#33333340"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" MinHeight="32">
            <ui:TitleBar x:Name="TitleBarRoot" Title="Los Angeles Supermercados — SuperPOS"/>
            <!-- Alineado al margen con espacio reservado para Min / Max / Cerrar (ExtendsContentIntoTitleBar) -->
            <StackPanel x:Name="PanelCampana" HorizontalAlignment="Right" VerticalAlignment="Center" Orientation="Horizontal"
                        Margin="0,0,132,0" Panel.ZIndex="2" IsHitTestVisible="True"
                        ToolTip="Alertas: artículos con stock actual ≤ stock mínimo (definido en ficha)">
                <Button x:Name="BtnAlertasStock" Style="{StaticResource BarIconBtn}" Padding="6,2" MinWidth="40" Height="30" Click="BtnAlertasStock_Click"
                        Cursor="Hand" ToolTip="Alertas de stock bajo mínimo">
                    <Grid Width="28" Height="24">
                        <TextBlock Text="&#x1F514;" FontSize="17" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        <Border x:Name="BadgeAlertas" CornerRadius="8" MinWidth="16" Height="16" Padding="2,0"
                                Background="#C03030" BorderBrush="#802020" BorderThickness="0"
                                HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-4,-4,0" Visibility="Collapsed">
                            <TextBlock x:Name="TxtConteoAlertas" Text="0" Foreground="White" FontSize="9" FontWeight="Bold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                </Button>
            </StackPanel>
        </Grid>
        <Popup x:Name="PopupAlertas" Placement="Bottom" PlacementTarget="{Binding ElementName=BtnAlertasStock}"
               StaysOpen="False" AllowsTransparency="True" HorizontalOffset="0" VerticalOffset="4">
            <Border x:Name="BordeAlertas" Background="#252525" BorderBrush="#404040" BorderThickness="1" CornerRadius="8" Padding="0"
                    MinWidth="300" MaxWidth="400" MaxHeight="400">
                <StackPanel>
                    <Border Background="#1E1E1E" Padding="10,8" CornerRadius="8,8,0,0" BorderBrush="#333" BorderThickness="0,0,0,1">
                        <TextBlock x:Name="TxtTituloAlertas" Text="Alertas de stock" FontWeight="Bold" Foreground="#F0F0F0"/>
                    </Border>
                    <TextBlock x:Name="TxtAyudaIa" TextWrapping="Wrap" Foreground="#8090A0" FontSize="10" Padding="10,6,10,4"
                               Text="Cargá el piso mínimo por artículo en Stock o Artículos. El asistente usa esos datos al analizar sugerencias de compra."/>
                    <StackPanel Orientation="Horizontal" Margin="8,0,8,6">
                        <Button x:Name="BtnIrAsistente" Content="Asistente IA" Padding="8,3" Click="BtnIrAsistente_Click" Margin="0,0,6,0"/>
                        <Button x:Name="BtnIrReportes" Content="Reporte stock mín." Padding="8,3" Click="BtnIrReportes_Click" Margin="0,0,6,0"/>
                        <Button x:Name="BtnIrStock" Content="Stock" Padding="8,3" Click="BtnIrStock_Click"/>
                    </StackPanel>
                    <ScrollViewer MaxHeight="280" VerticalScrollBarVisibility="Auto" Padding="0,0,0,6">
                        <ItemsControl x:Name="ItemsAlertas">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="8,6" BorderBrush="#2A2A2A" BorderThickness="0,0,0,1">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Descripcion}" FontSize="12" Foreground="#E8E8E8" TextWrapping="Wrap" FontWeight="SemiBold"/>
                                            <TextBlock FontSize="10" Foreground="#90A0B0" Margin="0,2,0,0">
                                                <TextBlock.Text>
                                                    <MultiBinding StringFormat="Stock {0:N2}  ·  mín. {1:N2}">
                                                        <Binding Path="StockActual"/>
                                                        <Binding Path="StockMinimo"/>
                                                    </MultiBinding>
                                                </TextBlock.Text>
                                            </TextBlock>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <TextBlock x:Name="TxtVacioAlertas" Text="No hay artículos bajo el mínimo." Foreground="#607080" FontSize="11"
                               HorizontalAlignment="Center" Margin="0,0,0,10" Padding="8" Visibility="Collapsed"/>
                </StackPanel>
            </Border>
        </Popup>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ===== BARRA LATERAL ===== -->
            <Border Grid.Column="0" Background="#1C1C1C" BorderThickness="0,0,1,0" BorderBrush="#303030">
                <DockPanel LastChildFill="False">

                    <!-- Logo -->
                    <Border DockPanel.Dock="Top" Padding="8,12,8,8" BorderThickness="0,0,0,1" BorderBrush="#303030">
                        <StackPanel>
                            <Image x:Name="ImgLogoNav" MaxHeight="52" Stretch="Uniform"
                                   RenderOptions.BitmapScalingMode="HighQuality"
                                   HorizontalAlignment="Center"/>
                            <TextBlock x:Name="TxtEmpresaNav"
                                       Text="Los Angeles" HorizontalAlignment="Center"
                                       Foreground="#7AAAE0" FontSize="11" FontWeight="Bold"
                                       Margin="0,6,0,0" TextWrapping="Wrap" TextAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- OPERACIONES -->
                    <StackPanel DockPanel.Dock="Top" Margin="0,6,0,0">
                        <TextBlock Style="{StaticResource NavSection}" Text="OPERACIONES"/>
                        <Button x:Name="BtnCaja"        Content="🛒  Caja / Ventas"    Style="{StaticResource NavBtn}" Tag="caja"        Click="NavButton_Click"/>
                        <Button x:Name="BtnArticulos"   Content="🏷️  Artículos"         Style="{StaticResource NavBtn}" Tag="articulos"   Click="NavButton_Click"/>
                        <Button x:Name="BtnClientes"    Content="👤  Clientes"          Style="{StaticResource NavBtn}" Tag="clientes"    Click="NavButton_Click"/>
                        <Button x:Name="BtnProveedores" Content="🏢  Proveedores"       Style="{StaticResource NavBtn}" Tag="proveedores" Click="NavButton_Click"/>
                        <Button x:Name="BtnPresupuestos" Content="📋  Presupuestos"      Style="{StaticResource NavBtn}" Tag="presupuestos" Click="NavButton_Click"/>
                        <Button x:Name="BtnCotizaciones" Content="📑  Cotizaciones Proveedores" Style="{StaticResource NavBtn}" Tag="cotizaciones" Click="NavButton_Click"/>

                        <TextBlock Style="{StaticResource NavSection}" Text="INVENTARIO"/>
                        <Button x:Name="BtnOrdenesCompra" Content="📋  Órdenes Compra"    Style="{StaticResource NavBtn}" Tag="ordenescompra"  Click="NavButton_Click"/>
                        <Button x:Name="BtnTarifasProveedor" Content="📑  Listas de precio"  Style="{StaticResource NavBtn}" Tag="tarifasproveedor" Click="NavButton_Click"/>
                        <Button x:Name="BtnEtiquetas"     Content="🏷️  Imprimir Etiquetas" Style="{StaticResource NavBtn}" Tag="etiquetas"     Click="NavButton_Click"/>
                        <Button x:Name="BtnRemitos"       Content="📄  Remitos"            Style="{StaticResource NavBtn}" Tag="remitos"        Click="NavButton_Click"/>
                        <Button x:Name="BtnInventario"    Content="🔍  Inventario Físico"  Style="{StaticResource NavBtn}" Tag="inventario"     Click="NavButton_Click"/>
                        <Button x:Name="BtnStock"         Content="📊  Stock"              Style="{StaticResource NavBtn}" Tag="stock"         Click="NavButton_Click"/>
                        <Button x:Name="BtnTrazabilidad"  Content="🔍  Trazabilidad"       Style="{StaticResource NavBtn}" Tag="trazabilidad"  Click="NavButton_Click"/>
                        <Button x:Name="BtnCtaCte"        Content="💳  Cta. Corriente"     Style="{StaticResource NavBtn}" Tag="ctacte"        Click="NavButton_Click"/>

                        <TextBlock Style="{StaticResource NavSection}" Text="FINANZAS"/>
                        <Button x:Name="BtnTesoreria"   Content="🏦  Tesorería"          Style="{StaticResource NavBtn}" Tag="tesoreria"     Click="NavButton_Click"/>
                        <TextBlock Style="{StaticResource NavSection}" Text="ANÁLISIS"/>
                        <Button x:Name="BtnReportes"    Content="📈  Reportes"           Style="{StaticResource NavBtn}" Tag="reportes"      Click="NavButton_Click"/>
                        <Button x:Name="BtnAi"          Content="🤖  Asistente IA"       Style="{StaticResource NavBtn}" Tag="ai"            Click="NavButton_Click"
                                Foreground="#7AAAE0"/>
                    </StackPanel>

                    <!-- Administración (abajo) -->
                    <StackPanel DockPanel.Dock="Bottom" Margin="0,0,0,10">
                        <Border BorderThickness="0,1,0,0" BorderBrush="#303030" Margin="8,6"/>
                        <Button x:Name="BtnUsuarios"    Content="👥  Usuarios"          Style="{StaticResource NavBtn}" Tag="usuarios"    Click="NavButton_Click"/>
                        <Button x:Name="BtnConfig"      Content="⚙️  Configuración"     Style="{StaticResource NavBtn}" Tag="configuracion" Click="NavButton_Click"/>
                        <Button x:Name="BtnLogout"      Style="{StaticResource NavBtn}" Tag="logout"     Click="NavButton_Click"
                                Foreground="#FF7070" FocusVisualStyle="{x:Null}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bd" Background="#1A0A0A" CornerRadius="7" Padding="12,0" Margin="4,2" Height="38"
                                            SnapsToDevicePixels="True">
                                        <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"
                                                          TextElement.Foreground="{TemplateBinding Foreground}"
                                                          TextElement.FontSize="13.5"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#2A1515"/>
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#3A1515"/>
                                            <Setter Property="Foreground" Value="#FF9090"/>
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#451818"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                            <TextBlock x:Name="TxtUsuarioNav" Text="🚪  Cerrar sesión"
                                       Foreground="#FF7070" FontSize="13.5"/>
                        </Button>
                    </StackPanel>
                </DockPanel>
            </Border>

            <Frame x:Name="ContentFrame" Grid.Column="1" NavigationUIVisibility="Hidden"
                   Background="#181818"/>
        </Grid>
    </Grid>
</ui:FluentWindow>
