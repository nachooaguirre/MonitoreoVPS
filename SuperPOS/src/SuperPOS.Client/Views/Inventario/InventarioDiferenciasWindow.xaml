<Window x:Class="SuperPOS.Client.Views.Inventario.InventarioDiferenciasWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Diferencias de inventario" Width="900" Height="520"
        WindowStartupLocation="CenterScreen" Background="#141414">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="TxtTitulo" Text="Diferencias" FontSize="18" FontWeight="Bold" Foreground="#E8F0FF" Margin="0,0,0,10"/>
        <Border Grid.Row="1" Background="#1E2528" CornerRadius="8" Padding="14,10" Margin="0,0,0,12" BorderBrush="#2A3A4A" BorderThickness="1">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Líneas con diferencia: " Foreground="#7090A0" FontSize="13"/>
                <TextBlock x:Name="TxtCant" FontSize="13" FontWeight="Bold" Foreground="#60B4FF" Margin="4,0,24,0"/>
                <TextBlock Text="Valor estimado: " Foreground="#7090A0" FontSize="13"/>
                <TextBlock x:Name="TxtValor" FontSize="13" FontWeight="Bold" Foreground="#FFD060"/>
            </StackPanel>
        </Border>
        <DataGrid x:Name="Dg" Grid.Row="2"
                  AutoGenerateColumns="False" IsReadOnly="True"
                  Background="#141414" Foreground="#D0E0FF" FontSize="13"
                  RowBackground="#1E1E1E" AlternatingRowBackground="#252525"
                  HorizontalGridLinesBrush="#333333" BorderThickness="0" RowHeight="36">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID ART." Width="72" Binding="{Binding IdArticulo}">
                    <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="Foreground" Value="#6080A0"/></Style></DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="DESCRIPCIÓN" Binding="{Binding Descripcion}" Width="*"/>
                <DataGridTextColumn Header="SIST." Binding="{Binding StockSistema, StringFormat='N1'}" Width="80">
                    <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="HorizontalAlignment" Value="Right"/></Style></DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="CONTADO" Binding="{Binding StockContado, StringFormat='N1'}" Width="90">
                    <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="Foreground" Value="#60D0A0"/><Setter Property="FontWeight" Value="Bold"/><Setter Property="HorizontalAlignment" Value="Right"/></Style></DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="DIF." Binding="{Binding Diferencia, StringFormat='+#,##0.###;-#,##0.###;0'}" Width="80">
                    <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="HorizontalAlignment" Value="Right"/></Style></DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="DIF. $" Binding="{Binding DiferenciaValorizada, StringFormat='$ #,##0.00'}" Width="120">
                    <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="Foreground" Value="#FFD080"/><Setter Property="HorizontalAlignment" Value="Right"/></Style></DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
            </DataGrid.Columns>
        </DataGrid>
        <ui:Button Grid.Row="3" Content="Cerrar" HorizontalAlignment="Right" Height="34" Padding="24,0" Margin="0,12,0,0" Click="BtnCerrar_Click"/>
    </Grid>
</Window>
