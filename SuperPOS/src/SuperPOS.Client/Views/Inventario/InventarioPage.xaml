<Page x:Class="SuperPOS.Client.Views.Inventario.InventarioPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="Inventario Físico" Background="#141414">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#1A1A1A" Padding="20,14" BorderThickness="0,0,0,1" BorderBrush="#2A2A2A">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="📦" FontSize="24" Margin="0,0,12,0"/>
                    <StackPanel>
                        <TextBlock Text="Inventario Físico" FontSize="20" FontWeight="Bold" Foreground="#F0F0FF"/>
                        <TextBlock Text="Toma de datos y ajuste de stock" FontSize="11" Foreground="#607080"/>
                    </StackPanel>
                </StackPanel>
                <ui:Button Grid.Column="1" x:Name="BtnNuevo" Content="+ Nuevo Inventario" Height="36" Padding="16,0" Click="BtnNuevo_Click"/>
            </Grid>
        </Border>

        <!-- Tabs: Inventarios históricos / Toma de datos activa -->
        <TabControl x:Name="TabInventario" Grid.Row="1" Background="#141414" BorderThickness="0">
            <!-- Lista de inventarios -->
            <TabItem Header="📋  Historial">
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <DataGrid x:Name="DgInventarios"
                              AutoGenerateColumns="False" IsReadOnly="True"
                              Background="#141414" Foreground="#D0E0FF" FontSize="13"
                              RowBackground="#1E1E1E" AlternatingRowBackground="#252525"
                              HorizontalGridLinesBrush="#333333" BorderThickness="0" RowHeight="40"
                              MouseDoubleClick="DgInventarios_DoubleClick">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="SUCURSAL" Binding="{Binding SucursalNombre}" Width="120"/>
                            <DataGridTextColumn Header="DESCRIPCIÓN" Binding="{Binding Descripcion}" Width="*"/>
                            <DataGridTextColumn Header="INICIO" Binding="{Binding FechaInicio, StringFormat='dd/MM/yyyy HH:mm'}" Width="140"/>
                            <DataGridTextColumn Header="CIERRE" Binding="{Binding FechaCierre, StringFormat='dd/MM/yyyy HH:mm'}" Width="140"/>
                            <DataGridTemplateColumn Header="ESTADO" Width="110">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="4" Padding="8,3" Margin="4" HorizontalAlignment="Left">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Estado}" Value="0"><Setter Property="Background" Value="#1A2530"/></DataTrigger>
                                                        <DataTrigger Binding="{Binding Estado}" Value="1"><Setter Property="Background" Value="#162016"/></DataTrigger>
                                                        <DataTrigger Binding="{Binding Estado}" Value="2"><Setter Property="Background" Value="#0A1A0A"/></DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding EstadoNombre}" FontSize="11" FontWeight="Bold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Estado}" Value="0"><Setter Property="Foreground" Value="#FFB040"/></DataTrigger>
                                                            <DataTrigger Binding="{Binding Estado}" Value="1"><Setter Property="Foreground" Value="#60B4FF"/></DataTrigger>
                                                            <DataTrigger Binding="{Binding Estado}" Value="2"><Setter Property="Foreground" Value="#40D080"/></DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="ARTÍCULOS" Binding="{Binding ArticulosContados}" Width="90"/>
                            <DataGridTextColumn Header="DIF. VALORIZ." Binding="{Binding DiferenciaValorizada, StringFormat='$ #,##0.00'}" Width="130">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#FFD060"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                        <Setter Property="HorizontalAlignment" Value="Right"/>
                                        <Setter Property="Padding" Value="0,0,12,0"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <TextBlock Grid.Row="1" Text="Doble clic para ver detalle o continuar toma de datos"
                               FontSize="11" Foreground="#506070" Margin="0,8,0,0"/>
                </Grid>
            </TabItem>

            <!-- Toma de datos activa -->
            <TabItem Header="📱  Toma de Datos">
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Info inventario activo -->
                    <Border Grid.Row="0" x:Name="PanelSinInventario" Background="#1A1200" CornerRadius="10" Padding="16,12" Margin="0,0,0,12">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⚠" FontSize="20" Margin="0,0,10,0"/>
                            <TextBlock Text="No hay inventario en proceso. Haga clic en '+ Nuevo Inventario' para comenzar."
                                       Foreground="#FFB040" VerticalAlignment="Center" FontSize="13"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="0" x:Name="PanelInventarioActivo" Visibility="Collapsed" Background="#1C2030" CornerRadius="10" Padding="14,10" Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock x:Name="TxtInvDescripcion" FontSize="14" FontWeight="Bold" Foreground="#F0F0FF"/>
                                <TextBlock x:Name="TxtInvSucursal" FontSize="12" Foreground="#7090A0" Margin="0,2,0,0"/>
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                    <TextBlock Text="Contados: " FontSize="12" Foreground="#607080"/>
                                    <TextBlock x:Name="TxtContados" FontSize="12" FontWeight="Bold" Foreground="#60B4FF"/>
                                    <TextBlock Text=" / " FontSize="12" Foreground="#607080"/>
                                    <TextBlock x:Name="TxtTotalArts" FontSize="12" Foreground="#607080"/>
                                </StackPanel>
                            </StackPanel>
                            <ui:Button Grid.Column="1" Content="Ver Diferencias" Height="34" Padding="12,0" Margin="0,0,8,0" Click="BtnDiferencias_Click"/>
                            <ui:Button Grid.Column="2" Content="🔒 Cerrar inventario" Appearance="Primary" Height="34" Padding="12,0" Click="BtnCerrarInventario_Click"/>
                        </Grid>
                    </Border>

                    <!-- Escáner -->
                    <Border Grid.Row="1" Background="#252525" CornerRadius="8" Padding="12,10" Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ui:TextBox x:Name="TxtEan" PlaceholderText="Escanear código EAN / buscar artículo..." Height="38" FontSize="15"
                                        KeyDown="TxtEan_KeyDown" Margin="0,0,8,0"/>
                            <ui:TextBox x:Name="TxtConteo" Grid.Column="1" PlaceholderText="Cant." Height="38" Text="1" FontSize="15" Margin="0,0,8,0"/>
                            <CheckBox x:Name="ChkAcumulativo" Grid.Column="2" Content="Suma a lo ya contado" VerticalAlignment="Center" Foreground="#A0A8B8" FontSize="12" Margin="0,0,12,0" ToolTip="Suma esta cantidad al conteo ya registrado para el mismo artículo."/>
                            <ui:Button Grid.Column="3" Content="Registrar" Height="38" Padding="16,0" Click="BtnRegistrar_Click"/>
                        </Grid>
                    </Border>

                    <!-- Grid de lo contado -->
                    <DataGrid x:Name="DgConteo" Grid.Row="2"
                              AutoGenerateColumns="False" IsReadOnly="True"
                              Background="#141414" Foreground="#D0E0FF" FontSize="13"
                              RowBackground="#1E1E1E" AlternatingRowBackground="#252525"
                              HorizontalGridLinesBrush="#333333" BorderThickness="0" RowHeight="38">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="CÓDIGO" Binding="{Binding CodigoBarras}" Width="130">
                                <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="Foreground" Value="#7090B0"/><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Padding" Value="8,0"/></Style></DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="DESCRIPCIÓN" Binding="{Binding Descripcion}" Width="*">
                                <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Padding" Value="8,0"/></Style></DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="SIST." Binding="{Binding StockSistema, StringFormat='N1'}" Width="80">
                                <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="Foreground" Value="#7090B0"/><Setter Property="HorizontalAlignment" Value="Right"/><Setter Property="Padding" Value="0,0,8,0"/></Style></DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="CONTADO" Binding="{Binding StockContado, StringFormat='N1'}" Width="90">
                                <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="Foreground" Value="#60D0A0"/><Setter Property="FontWeight" Value="Bold"/><Setter Property="HorizontalAlignment" Value="Right"/><Setter Property="Padding" Value="0,0,8,0"/></Style></DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="DIFF." Binding="{Binding Diferencia, StringFormat='+#,##0.###;-#,##0.###;0'}" Width="80">
                                <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="HorizontalAlignment" Value="Right"/><Setter Property="Padding" Value="0,0,8,0"/></Style></DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <TextBlock Grid.Row="3" Text="Escanee o ingrese el código de barras y la cantidad contada físicamente."
                               FontSize="11" Foreground="#506070" Margin="0,8,0,0"/>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Page>
