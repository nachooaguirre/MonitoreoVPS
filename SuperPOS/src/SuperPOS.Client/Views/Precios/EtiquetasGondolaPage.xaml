<Page x:Class="SuperPOS.Client.Views.Precios.EtiquetasGondolaPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="Etiquetas de Góndola" Background="#141414">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ===== ENCABEZADO Y BUSCADOR ===== -->
        <Border Grid.Row="0" Background="#1A1A1A" Padding="20,14" BorderThickness="0,0,0,1" BorderBrush="#2A2A2A">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="🏷️" FontSize="24" Margin="0,0,12,0" VerticalAlignment="Center"/>
                    <StackPanel>
                        <TextBlock Text="Cola de Etiquetas de Góndola" FontSize="20" FontWeight="Bold" Foreground="#F0F0F0"/>
                        <TextBlock Text="Administrar y encolar etiquetas de precios para góndola" FontSize="11" Foreground="#607080"/>
                    </StackPanel>
                </StackPanel>

                <!-- Búsqueda rápida para agregar manual -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:TextBox x:Name="TxtBuscarArticulo" Width="280" Height="36" 
                             PlaceholderText="Escanear o buscar artículo..."
                             Foreground="#F0F0F0" Background="#252525"
                             BorderBrush="#3A3A3A" BorderThickness="1"
                             VerticalContentAlignment="Center" Padding="8,4"
                             KeyDown="TxtBuscarArticulo_KeyDown"/>
                    <ui:TextBox x:Name="TxtCantEtiquetas" Width="60" Height="36" Margin="6,0,0,0"
                             Text="1" VerticalContentAlignment="Center" HorizontalContentAlignment="Center"/>
                    <ui:Button x:Name="BtnEncolarManual" Content="Encolar" Height="36" Margin="6,0,0,0" Padding="14,0"
                               Click="BtnEncolarManual_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===== CONTENIDO PRINCIPAL ===== -->
        <Grid Grid.Row="1" Margin="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="320"/>
            </Grid.ColumnDefinitions>

            <!-- TABLA DE COLA DE IMPRESIÓN (Izquierda) -->
            <Border Grid.Column="0" Background="#1E1E1E" CornerRadius="8" Padding="16" BorderBrush="#2A2A2A" BorderThickness="1" Margin="0,0,16,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="Etiquetas en Cola de Impresión" FontSize="15" FontWeight="SemiBold" Foreground="#F0F0F0" Margin="0,0,0,12"/>

                    <!-- Mensaje si la cola está vacía -->
                    <StackPanel x:Name="PanelColaVacia" Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed">
                        <TextBlock Text="🏷️" FontSize="40" HorizontalAlignment="Center" Foreground="#333333" Margin="0,0,0,10"/>
                        <TextBlock Text="No hay etiquetas pendientes en la cola." Foreground="#506070" FontSize="13" HorizontalAlignment="Center"/>
                        <TextBlock Text="Escaneá desde el terminal móvil o buscalas arriba para agregar." Foreground="#405060" FontSize="11" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                    </StackPanel>

                    <!-- Grilla de Etiquetas -->
                    <DataGrid x:Name="DgCola" Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False"
                              CanUserDeleteRows="False" GridLinesVisibility="Horizontal" RowHeight="42"
                              Background="Transparent" BorderThickness="0" Foreground="#F0F0F0"
                              RowBackground="#252525" AlternatingRowBackground="#222222"
                              HorizontalGridLinesBrush="#333333"
                              SelectionMode="Single" SelectionChanged="DgCola_SelectionChanged">
                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#222222"/>
                                <Setter Property="Foreground" Value="#8AADDF"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="Padding" Value="10,0"/>
                                <Setter Property="Height" Value="34"/>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>
                        <DataGrid.CellStyle>
                            <Style TargetType="DataGridCell">
                                <Setter Property="Padding" Value="8,0"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                            </Style>
                        </DataGrid.CellStyle>
                        <DataGrid.Columns>
                            <!-- Código de Barras -->
                            <DataGridTextColumn Header="CÓD. BARRAS" Binding="{Binding Articulo.CodigoBarras}" Width="130" IsReadOnly="True"/>
                            <!-- Descripción -->
                            <DataGridTextColumn Header="DESCRIPCIÓN" Binding="{Binding Articulo.Descripcion}" Width="*" IsReadOnly="True"/>
                            <!-- Precio Actual -->
                            <DataGridTextColumn Header="PRECIO VENTA" Binding="{Binding Articulo.PrecioVenta, StringFormat={}{0:C2}}" Width="120" IsReadOnly="True">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#80D4A0"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <!-- Cantidad a Imprimir -->
                            <DataGridTemplateColumn Header="CANT." Width="80">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBox Text="{Binding Cantidad, UpdateSourceTrigger=PropertyChanged}" 
                                                 TextAlignment="Center" Width="50" Height="28" 
                                                 Background="#151515" Foreground="White" BorderBrush="#333" 
                                                 TextChanged="TxtCantidad_TextChanged"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <!-- Eliminar de la cola -->
                            <DataGridTemplateColumn Header="" Width="50">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="✕" Width="28" Height="28" Background="Transparent" 
                                                BorderThickness="0" Foreground="#FF6060" FontWeight="Bold"
                                                Click="BtnEliminarCola_Click"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- ACCIONES DE IMPRESIÓN (Derecha) -->
            <Border Grid.Column="1" Background="#1E1E1E" CornerRadius="8" Padding="16" BorderBrush="#2A2A2A" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="Opciones de Impresión" FontSize="15" FontWeight="SemiBold" Foreground="#F0F0F0" Margin="0,0,0,16"/>

                    <!-- Formato de etiquetas -->
                    <TextBlock Text="Formato de Etiqueta:" Foreground="#8090A0" FontSize="12" Margin="0,0,0,6"/>
                    <ComboBox x:Name="CmbFormato" Height="36" SelectedIndex="1" Margin="0,0,0,16" SelectionChanged="CmbFormato_SelectionChanged">
                        <ComboBoxItem Content="Góndola (60mm x 30mm)"/>
                        <ComboBoxItem Content="Chica (50mm x 30mm) — estándar"/>
                        <ComboBoxItem Content="Grande (80mm x 40mm)"/>
                    </ComboBox>

                    <TextBlock Text="Vista Previa:" Foreground="#8090A0" FontSize="12" Margin="0,0,0,6"/>
                    <Border Background="#0A0A0A" CornerRadius="4" Padding="10" HorizontalAlignment="Center">
                        <ContentControl x:Name="PreviewHost"/>
                    </Border>
                    <TextBlock x:Name="TxtPreviewHint" Text="Elegí una etiqueta de la cola para previsualizarla."
                               Foreground="#607080" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0" HorizontalAlignment="Center"/>

                    <Separator Background="#2D2D2D" Margin="0,16,0,16"/>

                    <!-- Acciones -->
                    <ui:Button x:Name="BtnImprimir" Content="🖨️  Imprimir Cola" Height="48" FontSize="16" FontWeight="SemiBold"
                               HorizontalAlignment="Stretch" Click="BtnImprimir_Click"/>
                    
                    <ui:Button x:Name="BtnLimpiarCola" Content="🗑️  Vaciar Cola" Height="36" FontSize="13" Margin="0,10,0,0"
                               HorizontalAlignment="Stretch" Appearance="Secondary" Click="BtnLimpiarCola_Click"/>

                    <Separator Background="#2D2D2D" Margin="0,16,0,16"/>

                    <!-- Nota informativa -->
                    <Border Background="#252A35" CornerRadius="6" Padding="12" BorderBrush="#353E55" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="💡 Información" FontWeight="Bold" Foreground="#60C0FF" Margin="0,0,0,6"/>
                            <TextBlock Text="Esta pantalla extrae en tiempo real las etiquetas que se marcan desde los lectores Zebra en salón. Al imprimir, se eliminarán automáticamente de la cola." 
                                       Foreground="#A0A8B0" FontSize="11" TextWrapping="Wrap" LineHeight="1.4"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Page>
